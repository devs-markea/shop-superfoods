---
import BrandIcon, { type BrandName } from './BrandIcon.astro';
import { formatPrice } from '../lib/price.ts';

interface Props {
  /**
   * Texto del boton. Si contiene {total} y se pasa `total`, el marcado lleva
   * la plantilla en data-total-template para que el script la recalcule.
   */
  label: string;
  total?: number;
  /** Si se pasa, el control es un enlace en lugar de un submit. */
  href?: string;
  /** Icono opcional a la izquierda del label, separado 8px. */
  icon?: BrandName;
  /**
   * Color del boton. Dorado por defecto; `whatsapp` solo para enviar el pedido.
   */
  variant?: 'primary' | 'whatsapp';
  /** Aviso corto bajo el boton, centrado. */
  note?: string;
  /**
   * Apagado de verdad: ni navega ni envia, y se pinta gris. Para lo que ahora no
   * existe —continuar con la tienda cerrada—, no para lo que falta por rellenar:
   * de eso se encarga el aria-disabled del script, que si emite click y puede
   * contar que falta.
   */
  disabled?: boolean;
}

const {
  label,
  total,
  href,
  icon,
  variant = 'primary',
  note,
  disabled = false,
} = Astro.props;

// La copia vive en el marcado, no en el script.
const hasTotal = total !== undefined && label.includes('{total}');
const text = hasTotal ? label.replace('{total}', formatPrice(total)) : label;

const buttonClass = [
  'action-bar__button',
  'btn',
  'btn-primary',
  variant === 'whatsapp' && 'action-bar__button--whatsapp',
]
  .filter(Boolean)
  .join(' ');
---

<div class="action-bar">
  {
    disabled ? (
      // <button disabled> y no un <a> apagado: un enlace sin href sigue siendo
      // enfocable y anunciable como destino, y este control no lleva a ninguna
      // parte. `type="button"` para que no envie el formulario que lo envuelve.
      <button class={buttonClass} type="button" disabled>
        {icon && <BrandIcon name={icon} />}
        <span>{text}</span>
      </button>
    ) : href ? (
      <a class={buttonClass} href={href}>
        {icon && <BrandIcon name={icon} />}
        <span>{text}</span>
      </a>
    ) : (
      <button class={buttonClass} type="submit">
        {icon && <BrandIcon name={icon} />}
        {hasTotal ? (
          <span data-total data-total-template={label}>
            {text}
          </span>
        ) : (
          <span>{text}</span>
        )}
      </button>
    )
  }

  {note && <p class="action-bar__note">{note}</p>}
</div>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: action-bar
     ---------------------------------------------------------------------------
     Barra fija inferior con la accion principal.
     Spec: alto 84 - padding 20 - bg #FFFFFF - border-top 1px
     84 = 20 + 44 (boton) + 20

     Con aviso (/mamayaya/recibido) la barra crece lo que ocupe: min-height y no
     height, asi el 84 sigue siendo el minimo de las demas pantallas.
     --------------------------------------------------------------------------- */
  .action-bar {
    position: sticky;
    bottom: 0;
    /* Empuja la barra al fondo cuando el contenido no llena la pantalla. Con
       contenido largo manda el sticky y queda fija al hacer scroll. */
    margin-top: auto;
    z-index: 1020;
    min-height: 84px;
    padding: 20px;
    padding-bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--sf-border);
    background-color: var(--sf-white);
  }

  /* El boton de la spec mide 350 como maximo y va centrado.
     El gap de 8 separa el icono del label cuando el boton lleva icono. */
  .action-bar__button {
    display: flex;
    width: 100%;
    max-width: 350px;
    height: 44px;
    margin-inline: auto;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  /* Selección incompleta: el boton se ve apagado pero SIGUE siendo pulsable a
     proposito. Un `disabled` real no emite click, y entonces no habria forma de
     contar que falta; con aria-disabled el envio lo intercepta el script, que
     revela el minimo incumplido de cada grupo. */
  .action-bar__button[aria-disabled=true] {
    --bs-btn-hover-bg: var(--bs-btn-bg);
    --bs-btn-hover-border-color: var(--bs-btn-border-color);
    --bs-btn-hover-color: var(--bs-btn-color);
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Element: aviso bajo el boton — Inter 500 12/16 centrado #9CA3AF.
     Misma tipografia que .legal-note, pero aquel vive en el cuerpo de la pantalla
     y este dentro de la barra: se queda como element para no atar los dos bloques.
     El hueco de 12 no viene en la spec; es el que separa label y control en el
     resto del proyecto. */
  .action-bar__note {
    max-width: 350px;
    margin: 12px auto 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    color: var(--sf-placeholder);
    text-align: center;
  }

  /* Apagado de verdad (tienda cerrada): gris, no dorado desvaido. El dorado al 50%
     del bloque de arriba dice "te falta algo"; esto dice "ahora no se puede", y son
     dos mensajes distintos que no pueden verse igual. Sin opacidad: el gris ya es el
     color del estado, y rebajarlo ademas lo dejaria ilegible. */
  .action-bar__button:disabled {
    --bs-btn-disabled-bg: var(--sf-border);
    --bs-btn-disabled-border-color: var(--sf-border);
    --bs-btn-disabled-color: var(--sf-placeholder);
    --bs-btn-disabled-opacity: 1;
  }

  /* Modifier: enviar por WhatsApp. Unica accion del sistema que no es dorada.
     Se sobreescriben las custom properties de .btn en lugar del background, para
     que hover y activo sigan la mecanica de Bootstrap. */
  .action-bar__button--whatsapp {
    --bs-btn-bg: var(--sf-whatsapp);
    --bs-btn-border-color: var(--sf-whatsapp);
    --bs-btn-hover-bg: var(--sf-whatsapp-hover);
    --bs-btn-hover-border-color: var(--sf-whatsapp-hover);
    --bs-btn-active-bg: var(--sf-whatsapp-hover);
    --bs-btn-active-border-color: var(--sf-whatsapp-hover);
    --bs-btn-color: var(--sf-white);
    --bs-btn-hover-color: var(--sf-white);
    --bs-btn-active-color: var(--sf-white);
  }
</style>
