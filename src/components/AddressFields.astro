---
import TextField from './TextField.astro';

// Spec movil: contenedor gap 12 — 4 campos de 44 y un textarea de 80, uno debajo
// de otro y sin etiquetas, que es lo que cabe en 350.
//
// En desktop es el mismo contenedor a 12, pero por dentro se reparte en tres:
// colonia, calle y numero comparten una linea —son las tres piezas de la misma
// direccion, y las tres cortas—, y los dos campos opcionales se quedan cada uno
// con su etiqueta encima. Nada de eso duplica marcado: .field-row y .field-group
// no existen en movil (ver components/TextField.astro), asi que alli los campos
// siguen siendo hijos de esta columna y su ritmo no cambia.
//
// El borde de 2px lo trae .field por defecto, comun a todos los campos.
interface Props {
  /**
   * Si la direccion se pide. A domicilio si —colonia, calle y numero—; al recoger
   * no se pide ninguno, y el bloque entero se oculta.
   *
   * Lo declara ya el servidor, con el modo que trae el borrador, para que un envio
   * antes de que arranque el script no reclame campos que no se ven. Despues lo
   * sincroniza el switch.
   */
  required?: boolean;
}

const { required = true } = Astro.props;
---

<div class="field-stack d-flex flex-column">
  {/* Los tres obligatorios. En desktop, una linea de tres a 12. */}
  <div class="field-row">
    <TextField
      name="neighborhood"
      label="Colonia"
      placeholder="Colonia"
      autocomplete="address-level3"
      required={required}
    />
    <TextField
      name="street"
      label="Calle"
      placeholder="Calle"
      autocomplete="address-line1"
      required={required}
    />
    <TextField
      name="number"
      label="Numero exterior"
      placeholder="Numero exterior"
      autocomplete="address-line2"
      required={required}
    />
  </div>

  {/*
    Los dos opcionales. La etiqueta la escribe el grupo y no <TextField>, porque
    en desktop va encima del campo y no dentro de el; el `for` apunta al id que
    arma el propio componente.
  */}
  <div class="field-group">
    <label class="field-label" for="field-cross_streets">Entre calles (opcional)</label>
    <TextField name="cross_streets" placeholder="Entre calles (opcional)" />
  </div>

  <div class="field-group">
    <label class="field-label field-label--soft" for="field-references">
      Referencias adicionales (opcional)
    </label>

    <textarea
      class="field-note form-control"
      id="field-references"
      name="references"
      placeholder="Referencias (opcional)"></textarea>
  </div>
</div>
