---
import TextField from './TextField.astro';

// Spec: contenedor gap 12 — 4 campos de 44 y un textarea de 80.
// El borde de 2px lo trae .field por defecto, comun a todos los campos.
interface Props {
  /**
   * Si la direccion se pide. A domicilio si —colonia, calle y numero—; al recoger
   * no se pide ninguno, y el bloque entero se oculta.
   *
   * Lo declara ya el servidor, con el modo que trae el borrador, para que un envio
   * antes de que arranque el script no reclame campos que no se ven. Despues lo
   * sincroniza el switch.
   */
  required?: boolean;
}

const { required = true } = Astro.props;

interface AddressField {
  name: string;
  label: string;
  placeholder: string;
  autocomplete?: string;
  required: boolean;
}

const fields: AddressField[] = [
  {
    name: 'neighborhood',
    label: 'Colonia',
    placeholder: 'Colonia',
    autocomplete: 'address-level3',
    required: true,
  },
  {
    name: 'street',
    label: 'Calle',
    placeholder: 'Calle',
    autocomplete: 'address-line1',
    required: true,
  },
  {
    name: 'number',
    label: 'Numero exterior',
    placeholder: 'Numero exterior',
    autocomplete: 'address-line2',
    required: true,
  },
  {
    name: 'cross_streets',
    label: 'Entre calles',
    placeholder: 'Entre calles (opcional)',
    required: false,
  },
];
---

<div class="d-flex flex-column gap-3">
  {
    fields.map((field) => (
      <TextField
        name={field.name}
        label={field.label}
        placeholder={field.placeholder}
        autocomplete={field.autocomplete}
        required={field.required && required}
      />
    ))
  }

  <label class="visually-hidden" for="field-references">Referencias</label>
  <textarea
    class="field-note form-control"
    id="field-references"
    name="references"
    placeholder="Referencias (opcional)"></textarea>
</div>
