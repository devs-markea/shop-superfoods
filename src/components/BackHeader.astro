---
import BackButton from './BackButton.astro';

interface Props {
  backHref?: string;
  /**
   * La cabecera se retira de md hacia arriba. Para las pantallas que tienen
   * cabecera propia de desktop (.navbar-desktop): dos cabeceras seguidas serian
   * una de mas, y ahi el control de vuelta lo releva el logo de la barra.
   */
  mobileOnly?: boolean;
}

const { backHref = '/', mobileOnly = false } = Astro.props;

// Cabecera sin titulo: solo el control de vuelta. La usa /confirmado,
// donde el titular ("Pedido confirmado") es el propio contenido y repetirlo
// arriba sobraria.
//
// Comparte el bloque .topbar con ScreenHeader y TopBar —mismo element __back,
// mismo padding 12/20— y cambia solo el alto y el tamano de la caja tactil.
// Spec: height 64 - padding 12/20 - control de 40.
---

<header class:list={['topbar', 'topbar--compact', mobileOnly && 'topbar--mobile']}>
  <BackButton href={backHref} />
</header>
