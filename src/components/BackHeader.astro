---
import BackButton from './BackButton.astro';

interface Props {
  backHref?: string;
}

const { backHref = '/' } = Astro.props;

// Cabecera sin titulo: solo el control de vuelta. La usa /confirmado,
// donde el titular ("Pedido confirmado") es el propio contenido y repetirlo
// arriba sobraria.
//
// Comparte el bloque .topbar con ScreenHeader y TopBar —mismo element __back,
// mismo padding 12/20— y cambia solo el alto y el tamano de la caja tactil.
// Spec: height 64 - padding 12/20 - control de 40.
---

<header class="topbar topbar--compact">
  <BackButton href={backHref} />
</header>
