---
// Marcas de terceros. Van aparte de Icon.astro porque son glifos rellenos con
// su forma oficial, no trazos del sistema de 20x20.
//
// Heredan el color con currentColor para poder ir en blanco sobre el boton.
//
// Los nombres son los mismos tokens que publica `socialLinks[].network` en
// `GET /api/store` —facebook, instagram, whatsapp, tiktok, youtube, x—, asi que
// el pie recorre la lista y pinta un icono por red sin traducir nada. Una red
// que la API estrene y no tenga glifo aqui se ignora al normalizar la
// configuracion (ver src/lib/store-config.ts): antes un icono de menos que uno
// generico que no se reconozca.
//
// `label` es el nombre de la marca, para quien lo necesite al pintar. El del
// enlace del pie NO sale de aqui: lo manda la API con cada red, que es lo que
// evita mantener esa tabla en la tienda.

export type BrandName = 'whatsapp' | 'facebook' | 'instagram' | 'tiktok' | 'youtube' | 'x';

interface Props {
  name: BrandName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const brands: Record<BrandName, { label: string; path: string }> = {
