---
import { Image } from 'astro:assets';
import logo from '../assets/logo-mama-yaya-pokes-rosado.png';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// El logo, en un solo sitio.
//
// Las dos barras lo pintan con el MISMO width/height a proposito: las dos van
// en el marcado y solo el breakpoint decide cual se ve, asi que pedir dos
// tamanos distintos serviria dos archivos y el navegador se descargaria los
// dos. Con una sola transformacion hay una sola URL —una peticion, y la segunda
// ya esta en cache— y la altura final la pone el CSS de cada barra. El pie
// tambien lo usa, y es el que lo pinta mas grande —96 de alto—: el tamano que se
// pide es ese, para que ahi no salga borroso y en las barras solo se reduzca.
//
// 99x96 es la proporcion del archivo (229x223). El original venia de 308x308
// con el logo flotando en el centro: recortado al contenido, la altura de la
// barra la decide el CSS y no el margen transparente de la exportacion. Esos
// 223 de alto dan para el 2x del pie —192— y para poco mas: pintarlo mas grande
// pide una exportacion mayor.
//
// Es el rosado de una tinta, el mismo de los iconos de public/. El cafe a color
// —logo-mama-yaya.png— sigue solo en el chat (WatiChat.astro).
---

<Image
  class={className}
  src={logo}
  width={99}
  height={96}
  densities={[1, 2]}
  alt="Mamá Yaya"
  loading="eager"
/>
