---
import Icon from './Icon.astro';

interface Props {
  /** Unidades en el carrito. En 0 la burbuja no se pinta. */
  count: number;
}

const { count } = Astro.props;

// El boton flotante del pedido: la via al carrito en MOVIL.
//
// Hasta ahora no habia ninguna desde la portada. La barra de movil son el logo y
// los iconos de la tienda —horario y ubicacion—, y el chip con el importe es de
// la barra de desktop, que ahi no se pinta: al pedido solo se llegaba por el
// redirect de agregar un platillo, asi que quien volvia al menu se quedaba sin
// puerta.
//
// De md hacia arriba no existe: ese chip lo releva, y dos accesos al mismo sitio
// no son mejores que uno. Lo apaga el bloque —ver
// los estilos de este archivo—, como hace .navbar con su breakpoint: la
// portada no tiene que saber en que pantalla se ve.
//
// El nombre accesible nombra lo que se ve —el pedido y sus unidades— y no el
// importe. Por eso no reusa cartChipLabel() de src/lib/cart-view.ts: aquella
// frase la escribe el chip de desktop, que si ensena el total.
const label =
  count > 0
    ? `Mi pedido: ${count} ${count === 1 ? 'articulo' : 'articulos'}`
    : 'Mi pedido, vacio';
---

<a class="cart-fab" href="/carrito" aria-label={label}>
  {/* Contexto de posicion del tamano exacto del icono, igual que en la barra de
      desktop: la burbuja se cuelga de la esquina del carrito y no de la del
      circulo, que es mas grande y la dejaria suelta en el aire. */}
  <span class="cart-fab__icon">
    <Icon name="shopping-cart" class="cart-fab__glyph" />

    {/* La cifra se pinta siempre y se esconde con `hidden` estando el pedido
        vacio, como en la barra de desktop: es el mismo elemento en los dos
        estados y no marcado que aparece y desaparece. */}
    <span class="cart-fab__count" aria-hidden="true" hidden={count <= 0}>
      {count}
    </span>
  </span>
</a>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: cart-fab
     ---------------------------------------------------------------------------
     El boton flotante del pedido. Solo movil y solo en la portada.
     Spec: 70x70 - padding 16 - radius 38 - blanco con sombra 0 0 4 al 25%
     icono de 38 - burbuja de 20x17 dorada, cifra en 11/700 blanco

     Flota, no empuja: `position: fixed` lo saca del flujo, asi que sigue en su
     esquina mientras se recorre el catalogo y no parte la rejilla. El hueco que
     necesita al final de la lista lo reserva <main> (ver
     pages/index.astro): el circulo esta fuera del flujo y no puede
     reservarselo el.

     La sangria de la derecha es la de la pagina —20 en movil, la misma a la que
     arrancan las tarjetas—, no una distancia inventada: el circulo cae en la
     vertical del borde derecho de la rejilla. Abajo se suma el safe-area para que
     no quede bajo la barra de gestos del iPhone.
     --------------------------------------------------------------------------- */
  .cart-fab {
    /* El 20 es el gutter de la pagina en movil. Este boton no existe de md en
       adelante —se oculta mas abajo—, asi que nunca ve el de 32 de desktop. */
    position: fixed;
    right: 20px;
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    z-index: 1020;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    padding: 16px;
    /* Dorado como el chip del pedido de la barra de desktop: es el mismo destino y
       el color de las acciones del sistema. La superficie es blanca y no el tinte
       de aquel chip porque aqui el circulo se recorta contra el gris de la pagina,
       no contra una barra. */
    color: var(--sf-gold);
    background-color: var(--sf-white);
    /* El 38 de la spec. En una caja de 70 los dos radios de un lado no caben, asi
       que el navegador los reduce en proporcion hasta 35: sale el circulo exacto. */
    border-radius: 38px;
    /* Halo en las cuatro direcciones, y no las sombras de tarjeta de _variables:
       aquellas caen hacia abajo porque despegan una superficie del fondo, y esto es
       una pieza suelta sobre el catalogo que tiene que recortarse contra el por
       cualquier lado, tambien por arriba. */
    box-shadow: 0 0 4px 0 rgba(0, 0, 0, 0.25);
    transition: background-color 160ms ease;
    /* El color se repite porque Reboot le da a los enlaces su propio color de
       hover, y sin esto el carrito dejaria de ser dorado al tocarlo. */
  }
  .cart-fab:hover {
    color: var(--sf-gold);
    background-color: var(--sf-body-bg);
  }
  .cart-fab:active {
    color: var(--sf-gold);
    background-color: var(--sf-border);
  }

  /* Element: icon — contexto de posicion de 38x38, el hueco exacto que deja el
     padding de 16 dentro del circulo. */
  .cart-fab__icon {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
  }

  /* Element: glyph — el carrito a 38.

     Viene dibujado en la rejilla de 28 (ver ICON_VIEWBOX en src/lib/icons.ts), asi
     que pintarlo a 38 agranda el dibujo un 36%, trazo incluido: los 2 de .icon
     saldrian a 2.7 y este seria el unico icono grueso de la tienda. El grosor se
     baja en la misma proporcion —2 x 28 / 38— para que en pantalla siga siendo el 2
     del sistema. */
  .cart-fab__glyph {
    width: 38px;
    height: 38px;
    stroke-width: 1.47;
  }

  /* Element: count — la burbuja dorada, colgada de la esquina superior derecha del
     carrito. Misma receta que la del chip de desktop: padding 2/6, radius 10 y la
     cifra en 11/700 blanco.

     Lo que cambia son los desplazamientos, mas cortos que alli: aquella cuelga de
     una pastilla y puede asomar por el borde, y esta tiene que caber DENTRO de un
     circulo, donde la esquina de la caja del icono ya esta cerca del filo.

     El alto es el de la spec y el ancho es su MINIMO, no una medida fija: 20 es lo
     que mide con un digito, y con dos la burbuja crece hacia la izquierda en lugar
     de recortar la cifra. */
  .cart-fab__count {
    position: absolute;
    top: -2px;
    right: -6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 17px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    color: var(--sf-white);
    background-color: var(--sf-gold);
    border-radius: 10px;
  }

  /* Con la tienda cerrada manda el aviso: ocupa ese mismo borde inferior de gutter
     a gutter (ver components/StoreClosedNotice.astro) y las dos piezas se pisarian.
     Gana la tarjeta, que explica por que no se puede pedir; el pedido, con la
     tienda cerrada, no lleva a ninguna parte.

     Se apaga desde aqui y no con una condicion en la portada para que el bloque
     siga decidiendo cuando se ve, igual que decide en que pantallas. */
  .page:has(.store-closed) .cart-fab {
    display: none;
  }

  /* --- Desktop -------------------------------------------------------------
     Lo releva el chip del pedido de .navbar-desktop, que ademas ensena el importe. */
  @media (min-width: 768px) {
    .cart-fab {
      display: none;
    }
  }
</style>
