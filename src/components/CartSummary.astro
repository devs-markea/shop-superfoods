---
import { formatPrice } from '../lib/price.ts';
import { shippingLabel, type ShippingResult } from '../lib/shipping.ts';

interface Props {
  /** Importe de los productos ANTES de descuentos: `subtotal` del carrito. */
  subtotal: number;
  /** Lo que descuentan las promociones. Con 0 la fila no se pinta. */
  discount: number;
  /** Lo que cuestan los productos ya descontados: `total` del carrito. */
  products: number;
  /**
   * El envio, ya resuelto por la pantalla (src/lib/shipping.ts). Aqui todavia
   * suele estar "Por cotizar" —la ubicacion se comparte en /mamayaya/datos—, salvo que el
   * negocio regale el envio o que se vuelva atras con la distancia ya medida.
   */
  shipping: ShippingResult;
  /**
   * Propina elegida, en MXN. Con 0 la fila no se pinta: solo la hay donde se
   * elige (/mamayaya/pago), y ahi puede volver a cero.
   */
  tip?: number;
  /** Texto del boton. */
  label: string;
  /**
   * A donde lleva el boton. Sin el, el control es un submit del formulario que lo
   * envuelve: la misma regla que <ActionBar>, y la que necesita /mamayaya/datos, donde
   * continuar es validar los campos antes de avanzar.
   */
  href?: string;
  /**
   * Apagado de verdad: ni navega ni envia, y se pinta gris. Para lo que ahora no
   * existe —continuar con la tienda cerrada, o con el pedido vacio—, la misma
   * regla que el `disabled` de <ActionBar>.
   */
  disabled?: boolean;
}

const {
  subtotal,
  discount,
  products,
  shipping,
  tip = 0,
  label,
  href,
  disabled = false,
} = Astro.props;

// La tarjeta de resumen del pedido, SOLO desktop: en movil no se pinta (ver
// los estilos de este archivo). Es la segunda columna de /mamayaya/carrito y donde se
// continua el flujo, porque alli la barra fija del fondo no existe.
//
// No sabe en que pantalla esta: recibe los importes ya calculados, el envio ya
// resuelto y a donde lleva su boton. Lo unico que decide por su cuenta es el
// total, y lo decide porque no puede recibirlo: una cifra que se pueda pasar por
// fuera es una cifra que puede contradecir a sus propias filas.
//
// Cierra la cuenta entera —lo que valen los productos, lo que descuentan las
// promociones, lo que cuesta llevarlo y lo que se paga—, y por eso en desktop
// releva al bloque .order-totals del cuerpo: dos "Subtotal" en la misma pantalla,
// uno con descuentos aplicados y otro sin ellos, son dos cifras que no cuadran.
//
// El total se calcula, nunca se escribe, igual que en <PaymentSummary>: la vista
// no puede contradecir a los datos. Y el que manda aqui es el de los PRODUCTOS
// —`products`, que ya trae los descuentos aplicados—, no el subtotal de arriba.
const total = products + shipping.cost + tip;

// El envio "Por cotizar" no suma nada al total: no hay importe cotizado, y poner
// una tarifa a ojo seria prometer algo que el pedido va a desmentir.
//
// La propina SI se desglosa, a diferencia de <PaymentSummary>, que la suma al
// total sin nombrarla porque el selector la tiene justo encima. Aqui esa columna
// no esta al lado: sin fila, el total de la tarjeta no cuadraria con las suyas.
---

<aside class="cart-summary" aria-labelledby="cart-summary-title" data-cart-summary>
  <h2 class="cart-summary__title" id="cart-summary-title">Resumen de compra</h2>

  <dl class="cart-summary__rows">
    <div class="cart-summary__row">
      <dt class="cart-summary__term">Subtotal</dt>
      <dd class="cart-summary__value" data-cart-subtotal>{formatPrice(subtotal)}</dd>
    </div>

    {/* Solo con promociones aplicadas. Se pinta siempre en el marcado —oculta
        con d-none— porque un cambio de cantidad puede estrenar o deshacer un
        descuento, y el script la ensena y la esconde sin recargar. */}
    <div
      class:list={['cart-summary__row', discount <= 0 && 'd-none']}
      data-cart-discount-row
    >
      <dt class="cart-summary__term">Descuentos</dt>
      <dd class="cart-summary__value cart-summary__value--save" data-cart-discount>
        {`− ${formatPrice(discount)}`}
      </dd>
    </div>

    {/* Al recoger no hay envio y la fila desaparece entera: un "Por cotizar" en un
        pedido que se recoge promete un cobro que no va a llegar. Se pinta oculta y
        no se omite porque en /mamayaya/datos el modo de entrega se elige aqui mismo, y la
        fila tiene que poder irse y volver con el switch. */}
    <div
      class:list={['cart-summary__row', shipping.state === 'none' && 'd-none']}
      data-cart-shipping-row
    >
      <dt class="cart-summary__term">Costo de envio</dt>

      {/* El estado va en data-state y no en un modificador por cada caso: el
          script lo cambia con una sola asignacion —al cruzar el umbral del envio
          gratis, o al llegar la distancia medida— y el color y el peso los pone
          el CSS. */}
      <dd class="cart-summary__value" data-state={shipping.state} data-cart-shipping>
        {shippingLabel(shipping)}
      </dd>
    </div>

    {/* Solo donde se elige (/mamayaya/pago), y solo si se dejo algo: una fila de $0.00 no
        dice nada. Se pinta oculta, como las otras dos condicionales, porque el
        selector la mueve sin recargar. */}
    <div class:list={['cart-summary__row', tip <= 0 && 'd-none']} data-cart-tip-row>
      <dt class="cart-summary__term">Propina</dt>
      <dd class="cart-summary__value" data-cart-tip>{formatPrice(tip)}</dd>
    </div>

    <hr class="cart-summary__divider" />

    <div class="cart-summary__row">
      <dt class="cart-summary__total-term">Total</dt>
      <dd class="cart-summary__total-value" data-cart-total>{formatPrice(total)}</dd>
    </div>
  </dl>

  {/*
    Hueco entre la cuenta y el boton, para lo que cada pantalla tenga que decir
    antes de continuar. Hoy solo lo llena /mamayaya/pago, con el aviso legal que en movil
    va al final del cuerpo.

    Es un slot y no una prop porque la tarjeta no sabe en que pantalla esta —ver
    la nota de arriba— y un `termsUrl` la obligaria a saberlo. Sin rellenar no
    pinta nada: no queda ni el nodo ni el hueco del gap.
  */}
  <slot name="note" />

  {
    // El mismo reparto que <ActionBar>: apagado es un <button disabled> y no un
    // enlace en gris, porque un <a> sin href sigue siendo enfocable y anunciable
    // como destino, y este control no lleva a ninguna parte. `type="button"` para
    // que no envie el formulario que lo envuelve.
    disabled ? (
      <button class="cart-summary__action btn btn-primary" type="button" disabled>
        {label}
      </button>
    ) : href ? (
      <a class="cart-summary__action btn btn-primary" href={href}>
        {label}
      </a>
    ) : (
      <button class="cart-summary__action btn btn-primary" type="submit">
        {label}
      </button>
    )
  }
</aside>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: cart-summary
     ---------------------------------------------------------------------------
     La tarjeta de resumen de /mamayaya/carrito, SOLO desktop. Spec: 390 de ancho - gap 24 -
     padding 24 - radius 16 - fondo blanco - sombra suave.

     No es una variante de .summary, el desglose de /mamayaya/pago: alli el resumen es una
     pieza mas de la columna —sin superficie, sin boton y con otra escala
     tipografica— y aqui es la segunda columna de la pantalla, la que cierra la
     cuenta y continua el flujo. Coinciden en tener filas de concepto e importe y en
     nada mas, asi que es otro bloque.

     En movil no existe: alli la cuenta la cierran el total de la barra superior, el
     bloque .order-totals del cuerpo y la barra de accion del fondo.

     Los colores de la spec ya son tokens de la tienda: #111827 es --sf-ink (el
     negro del resto de la interfaz, la misma equivalencia que ya documentan la
     ficha y el contador de unidades), #6B7280 es --sf-muted, #EAECF0 es --sf-border
     y #16A34A es --sf-success, el verde con el que se rotula lo que no se paga.
     --------------------------------------------------------------------------- */
  .cart-summary {
    display: none;
  }

  @media (min-width: 768px) {
    .cart-summary {
      display: flex;
      flex-direction: column;
      gap: 24px;
      width: 100%;
      padding: 24px;
      background-color: var(--sf-white);
      border-radius: 16px;
      box-shadow: 0 1px 2px 0 rgb(0 0 0 / 5%);
    }
    /* Element: title — Inter 700 18/100%. El 18 no esta en la escala de tamanos
       (12/14/16/24) y no la abre: es el del nombre de la tarjeta de platillo y el
       de los dos rotulos que encabezan una tarjeta del checkout de desktop —este y
       el del detalle del pedido—, y de nada mas. */
    .cart-summary__title {
      margin: 0;
      font-size: 18px;
      font-weight: 700;
      line-height: 1;
      color: var(--sf-ink);
    }
    /* Element: rows — los conceptos y la divisoria, a 16. Es un <dl>: son pares
       concepto/importe, no una lista de elementos sueltos. El margen que el Reboot
       pone al <dl> y a cada <dd> se anula. */
    .cart-summary__rows {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin: 0;
    }
    .cart-summary__row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
    }
    /* Element: term — Inter 400 14/100% */
    .cart-summary__term {
      margin: 0;
      font-size: 14px;
      font-weight: 400;
      line-height: 1;
      color: var(--sf-muted);
    }
    /* Element: value — Inter 600 14/100%. Tabular para que las cifras de las filas
       queden alineadas entre si. */
    .cart-summary__value {
      margin: 0;
      font-size: 14px;
      font-weight: 600;
      line-height: 1;
      color: var(--sf-ink);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    /* Modifier: lo que descuentan las promociones. En verde, como en el detalle del
       pedido: es lo mismo, dinero que no se paga. */
    .cart-summary__value--save {
      color: var(--sf-success);
    }
    /* Los tres estados del envio. El importe cotizado se rotula con el peso y el
       gris del concepto —lo pide la spec, y es coherente: es el unico importe de la
       tarjeta que todavia puede cambiar cuando se comparta la ubicacion—, el
       regalado en verde, y el que no se ha podido medir en el gris mas claro, el de
       los datos que aun no existen. */
    .cart-summary__value[data-state=quoted] {
      font-weight: 400;
      color: var(--sf-muted);
    }
    .cart-summary__value[data-state=free] {
      color: var(--sf-success);
    }
    .cart-summary__value[data-state=pending] {
      font-weight: 400;
      color: var(--sf-placeholder);
    }
    /* Element: divider — la linea de 1 de la spec (height 0 + borde) */
    .cart-summary__divider {
      height: 0;
      margin: 0;
      border: 0;
      border-top: 1px solid var(--sf-border);
      opacity: 1;
    }
    /* Element: total — Inter 700 16/100% el concepto, Inter 800 20/100% el importe.
       El 20 y el 800 son los de la cifra que remata una cuenta, y por eso los
       comparte el "Total a pagar" del detalle del pedido en las dos pantallas de
       cierre: es la misma cifra en la otra columna. En ningun otro sitio de la
       tienda aparecen. El 800 se descarga con la fuente: esta
       declarado en la config de Astro, junto al resto de pesos. */
    .cart-summary__total-term {
      margin: 0;
      font-size: 16px;
      font-weight: 700;
      line-height: 1;
      color: var(--sf-ink);
    }
    .cart-summary__total-value {
      margin: 0;
      font-size: 20px;
      font-weight: 800;
      line-height: 1;
      color: var(--sf-gold);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    /* Element: action — el boton que continua el flujo. Los 342 de la spec son el
       ancho del contenido de la tarjeta (390 - 24 - 24), asi que se piden como
       ancho completo y no como medida fija: la tarjeta ya decide cuanto mide.

       El dorado, el radius de 12, el relleno de 12/16 y la tipografia son los de
       .btn-primary, que ya son los de la spec (ver styles/bootstrap-overrides.css). */
    .cart-summary__action {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
    }
    /* Falta algo por elegir —en /mamayaya/datos, la ubicacion—: el boton se ve apagado
       pero SIGUE siendo pulsable a proposito. Un `disabled` real no emite click, y
       entonces no habria forma de contar que falta; con aria-disabled el envio lo
       intercepta el script, que lo escribe. La misma regla que .action-bar__button:
       en /mamayaya/datos los dos son el mismo control en dos pantallas. */
    .cart-summary__action[aria-disabled=true] {
      --bs-btn-hover-bg: var(--bs-btn-bg);
      --bs-btn-hover-border-color: var(--bs-btn-border-color);
      --bs-btn-hover-color: var(--bs-btn-color);
      opacity: 0.5;
      cursor: not-allowed;
    }
    /* Tienda cerrada: gris y no dorado desvaido, la misma regla que la barra de
       accion. El dorado al 50% dice "te falta algo"; esto dice "ahora no se puede". */
    .cart-summary__action:disabled {
      --bs-btn-disabled-bg: var(--sf-border);
      --bs-btn-disabled-border-color: var(--sf-border);
      --bs-btn-disabled-color: var(--sf-placeholder);
      --bs-btn-disabled-opacity: 1;
    }
  }
  /* --- Dos columnas ---------------------------------------------------------
     De lg la tarjeta es la segunda columna y toma su ancho de la spec. Hasta ahi va
     debajo del pedido y a todo lo ancho: un bloque de 390 solo, bajo una columna de
     700, se lee como algo que se quedo a medias. */
  @media (min-width: 992px) {
    .cart-summary {
      flex: 0 0 390px;
    }
  }
</style>
