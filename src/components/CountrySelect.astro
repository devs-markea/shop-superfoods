---
import Flag from './Flag.astro';
import { countries, defaultCountry } from '../data/countries.ts';

interface Props {
  name?: string;
}

const { name = 'country_code' } = Astro.props;

// Dropdown de Bootstrap: aporta apertura, cierre al pulsar fuera, navegacion
// con teclado y el aria-expanded. Sin la clase .dropdown-toggle a proposito,
// porque su caret no cabe en los 75 de la spec.
//
// El valor viaja en un input oculto para que se envie con el formulario.
---

<div class="dropdown">
  <button
    class="country-select btn-plain"
    type="button"
    data-bs-toggle="dropdown"
    aria-expanded="false"
    aria-label="Codigo de pais"
    data-country-toggle
  >
    <Flag country={defaultCountry.code} class="country-select__flag" decorative />
    <span class="country-select__code" data-country-code>{defaultCountry.dialCode}</span>
  </button>

  <ul class="dropdown-menu country-select__menu">
    {
      countries.map((country) => (
        <li>
          <button
            class="dropdown-item country-select__option"
            type="button"
            data-country-option
            data-code={country.code}
            data-dial-code={country.dialCode}
          >
            <Flag country={country.code} class="country-select__flag" decorative />
            <span class="country-select__name">{country.name}</span>
            <span class="country-select__dial">{country.dialCode}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <input type="hidden" name={name} value={defaultCountry.dialCode} data-country-value />
</div>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: country-select  (sobre .dropdown de Bootstrap)
     ---------------------------------------------------------------------------
     Selector de codigo de pais del telefono. Control propio y no un <select>
     nativo, porque tiene que mostrar la bandera junto al codigo.

     Spec: 75x44 - gap 4 - padding lateral 12 - radius 12 - borde 2px #EAECF0
     bandera 20x14 - codigo Inter 600 14/20 #141821

     Bootstrap aporta la mecanica del despliegue; no se usa .dropdown-toggle
     porque su caret no cabe en los 75 de la spec.
     --------------------------------------------------------------------------- */
  .country-select {
    display: inline-flex;
    flex: 0 0 75px;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 75px;
    height: 44px;
    padding-inline: 12px;
    border: 2px solid var(--sf-border);
    border-radius: 12px;
    transition: border-color 160ms ease;
  }
  .country-select:hover, .country-select[aria-expanded=true] {
    border-color: var(--sf-gold);
  }

  .country-select__flag {
    flex: 0 0 20px;
    width: 20px;
    height: 14px;
    border-radius: 2px;
  }

  .country-select__code {
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    color: var(--sf-ink);
    white-space: nowrap;
  }

  /* Element: lista desplegada */
  .country-select__menu {
    min-width: 220px;
  }

  /* Element: opcion — bandera + nombre + codigo alineado a la derecha */
  .country-select__option {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .country-select__name {
    flex: 1 1 auto;
  }

  .country-select__dial {
    flex: 0 0 auto;
    color: var(--sf-muted);
  }
</style>
