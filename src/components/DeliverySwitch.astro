---
import type { DeliveryType } from '../lib/checkout.ts';
import { DELIVERY_FIELD, SWITCH_VALUE } from '../lib/delivery-switch.ts';

interface Props {
  /**
   * Modo ya elegido. Lo trae el borrador: lo que se marco en el listado, o lo que
   * quedo al pasar por aqui antes de ir al pago. Sin el manda "a domicilio", que
   * es como llega quien entra por primera vez.
   */
  selected?: DeliveryType;
}

const { selected = 'delivery' } = Astro.props;

// Block: switch — "A domicilio" / "Para recoger".
// Dos radios con .btn-check: seleccion unica sin JavaScript, navegable con
// flechas y serializable en un formulario.
//
// Los `value` son los del diseno, no los del contrato. La traduccion vive en
// src/lib/delivery-switch.ts, que es tambien quien guarda la eleccion en el
// borrador: aqui solo se pinta la que llega.
const options: { id: string; mode: DeliveryType; label: string }[] = [
  { id: 'delivery-home', mode: 'delivery', label: 'A domicilio' },
  { id: 'delivery-pickup', mode: 'pickup', label: 'Para recoger' },
];
---

<div class="switch" role="group" aria-label="Modo de entrega" data-delivery-switch>
  {
    options.map((option) => (
      <>
        <input
          class="btn-check"
          type="radio"
          name={DELIVERY_FIELD}
          id={option.id}
          value={SWITCH_VALUE[option.mode]}
          checked={option.mode === selected}
          autocomplete="off"
        />
        <label class="switch__option btn" for={option.id}>
          {option.label}
        </label>
      </>
    ))
  }
</div>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: switch  (sobre .btn-check de Bootstrap)
     ---------------------------------------------------------------------------
     Dos opciones excluyentes: "A domicilio" / "Para recoger".

     La maqueta lo resolvia con <button> y JS que alternaba clases. Con .btn-check
     son dos <input type="radio">: el estado lo lleva el DOM, funciona sin
     JavaScript, es navegable con flechas y se envia con el formulario.

     La pista NO lleva .btn-group: sus reglas (0-3-0 y 0-4-0) cuadran las
     esquinas internas de cada opcion (border-end-radius en la primera,
     border-start-radius en la segunda), asi que la pastilla activa se veia
     cortada por el lado interior. Ademas metia margin-left: -1px y
     flex: 1 1 auto. Aqui la pista es un flex propio y cada opcion, una pastilla.

     Spec: pista 350x44 - radius 12 - padding 4 - bg #EAECF0
     opcion 171x36 - radius 8 - Inter 600 14/20
     350 - 8 (padding) = 342 -> 2 x 171, por eso flex: 1 1 0
     --------------------------------------------------------------------------- */
  .switch {
    display: flex;
    width: 100%;
    max-width: 350px;
    height: 44px;
    margin-inline: auto;
    padding: 4px;
    border-radius: 12px;
    background-color: var(--sf-border);
  }

  .switch__option {
    display: inline-flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    height: 36px;
    min-width: 0;
    padding-block: 0;
    padding-inline: 8px;
    border-radius: 8px; /* 12 de la pista - 4 de padding */
    background-color: transparent;
    color: var(--sf-muted);
    white-space: nowrap;
    user-select: none;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .switch__option:hover {
    color: var(--sf-ink);
  }

  /* Estado: opcion activa. Sustituye al modifier --active de la maqueta. */
  .btn-check:checked + .switch__option, .btn-check:checked + .switch__option:hover {
    background-color: var(--sf-gold);
    color: var(--sf-white);
  }

  .btn-check:focus-visible + .switch__option {
    outline: 2px solid var(--sf-gold);
    outline-offset: 2px;
  }

  /* --- Desktop -------------------------------------------------------------
     La pista sigue midiendo lo que le den: en /datos llena la columna de 350 del
     formulario, como cualquier otro campo. Quien la encoge a sus dos opciones de
     136 es la barra de la portada, porque alli comparte linea con las categorias
     y el ancho es suyo, no del switch. Ver components/OrderBar.astro. */
  @media (min-width: 768px) {
    .switch__option {
      padding-inline: 20px;
    }
  }
</style>
