---
import BrandLogo from './BrandLogo.astro';
import { whatsAppUrl } from '../lib/whatsapp.ts';
import { storeYear } from '../lib/schedule.ts';
import type { StoreSettings } from '../lib/store-config.ts';

interface Props {
  store: StoreSettings;
  /** Las categorias publicadas, ya sin el chip "Todos" que pone la interfaz. */
  categories: readonly string[];
}

const { store, categories } = Astro.props;

// Pie de pagina, SOLO desktop: en movil no se pinta (ver los estilos de este archivo). Tres
// franjas separadas por 32: marca y enlaces, la divisoria, y el aviso de derechos
// con las redes.
//
// El nombre no se escribe a mano en ningun sitio de aqui: lo pone la tienda. Sin
// el, la frase de presentacion se cae entera antes que quedarse sin sujeto —y el
// aviso de derechos sigue en pie, que para eso basta el ano—.
const name = store.name;

const about = name
  ? `${name} ofrece la mejor comida mexicana tradicional preparada con ingredientes de la mas alta calidad y un sabor inigualable.`
  : null;

const copyright = name
  ? `© ${storeYear()} ${name}. Todos los derechos reservados.`
  : `© ${storeYear()}. Todos los derechos reservados.`;

// "Descubre" no lista los platillos de la spec —"Tacos al Pastor", "Burritos
// Gigantes", "Bebidas Artesanales"—: son de la maqueta, y este catalogo vende
// otras cosas. Rotular en el pie un platillo que la tienda no sirve es la misma
// mentira que prometer un envio gratis que el negocio apago. Se pintan las
// categorias PUBLICADAS, que es lo que hay de verdad que descubrir, y hasta tres:
// la columna es un resumen, no un indice.
//
// Los cuatro navegan a la portada, que es donde vive el filtro —los chips de la
// barra, radios name="category"—. Los tres de categoria llevan ademas su nombre
// en un `data-`, y de ahi lo toma src/scripts/footer-discover.ts para dejarlo
// pasado a la portada por sessionStorage: asi la direccion sigue siendo `/mamayaya` a
// secas en lugar de arrastrar un parametro. Ver src/lib/discover.ts.
//
// El `href` no es decorativo: sin JavaScript el enlace sigue llevando al menu
// completo, y con el boton central o un Ctrl+click se abre en otra pestana.
const discover = categories.slice(0, 3);

// Las redes: de las tres, solo WhatsApp tiene dato. Facebook e Instagram no se
// pueden enlazar —`GET /api/store` no publica sus perfiles— y se quedan en texto
// en lugar de fingir un enlace a "#": la misma regla que el resto de la tienda,
// sin dato se degrada en vez de mentir.
const phone = store.whatsapp?.phone;

const socials: Array<{ label: string; href: string | null }> = [
  { label: 'Facebook', href: null },
  { label: 'Instagram', href: null },
  { label: 'WhatsApp', href: phone ? whatsAppUrl(phone) : null },
];
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__brand-link" href="/mamayaya">
          <BrandLogo class="footer__logo" />
        </a>

        {about && <p class="footer__about">{about}</p>}
      </div>

      <nav class="footer__nav" aria-labelledby="footer-discover">
        <h2 class="footer__heading" id="footer-discover">Descubre</h2>

        <ul class="footer__links list-unstyled" data-discover>
          <li>
            <a class="footer__link" href="/mamayaya">Menu completo</a>
          </li>

          {
            discover.map((category) => (
              <li>
                <a class="footer__link" href="/mamayaya" data-discover-category={category}>
                  {category}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <hr class="footer__divider" />

    <div class="footer__bottom">
      <p class="footer__copyright">{copyright}</p>

      <ul class="footer__social list-unstyled">
        {
          socials.map((social) => (
            <li>
              {social.href ? (
                <a
                  class="footer__social-link"
                  href={social.href}
                  target="_blank"
                  rel="noopener"
                >
                  {social.label}
                </a>
              ) : (
                <span class="footer__social-link">{social.label}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: footer
     ---------------------------------------------------------------------------
     Pie de pagina, SOLO desktop. Spec: padding 48/160/32, gap 32, fondo blanco.

     En movil no existe. No es una decision de estilo: la spec lo pide asi, y en una
     pantalla de 375 las dos columnas se apilarian en una torre de enlaces que nadie
     pidio, debajo de una rejilla que ya se lee scrolleando.

     El `color: #FFFFFF` de la spec es el FONDO. Cada rotulo trae su propio color
     —#6C757D, #D5AA53, #9CA3AF—, asi que no queda texto al que ese blanco pueda
     referirse; sobre el fondo gris de la pagina el pie es una superficie, como la
     barra de arriba. Es la misma clase de desliz que ya documenta el README en tres
     specs, ahi al reves.

     Los 160 de sangria son un MAXIMO, no una medida fija: son (1440 - 1120) / 2
     del lienzo de la spec, y por debajo el clamp cae al gutter de la pagina. El
     contenido para en 1140 para no separarse de la rejilla de platillos. La
     misma sangria la usa .navbar-desktop, que es la otra pieza a ancho completo.
     --------------------------------------------------------------------------- */
  .footer {
    display: none;
  }

  @media (min-width: 768px) {
    .footer {
      display: block;
      /* 48 arriba y 32 abajo. Los 48 no estan en la escala del sistema —32 es el
         ultimo escalon— y se escriben sumando dos que si estan, para no abrir un
         token que usaria un solo bloque. */
      padding: calc(32px + 16px) clamp(32px, calc((100% - 1120px) / 2), 160px) 32px;
      background-color: var(--sf-white);
    }
    .footer__inner {
      display: flex;
      flex-direction: column;
      gap: 32px;
      width: 100%;
      max-width: 1140px;
      margin-inline: auto;
    }
    /* Element: top — la marca a la izquierda y la columna de enlaces a la derecha */
    .footer__top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 32px;
    }
    .footer__brand {
      display: flex;
      flex-direction: column;
      gap: 16px;
      /* El parrafo no se estira a lo ancho del pie: a 1120 saldrian lineas de 150
         caracteres, ilegibles. Se corta donde el diseno lo corta, antes de la
         columna de enlaces. */
      max-width: 420px;
    }
    /* La caja del logo es la de la spec —160x36— y el logo va dentro a 160 de
       ancho: el archivo tiene proporcion 5.8:1, asi que a 160 mide 27.6 de alto y
       los 36 son el alto del marco, con el logo centrado. Las dos medidas de la
       spec no pueden cumplirse a la vez sin deformarlo, y de las dos la que se ve
       es el ancho. */
    .footer__brand-link {
      display: flex;
      align-items: center;
      align-self: flex-start;
      height: 36px;
      transition: opacity 160ms ease;
    }
    .footer__brand-link:hover {
      opacity: 0.8;
    }
    .footer__logo {
      width: 160px;
      height: auto;
    }
    /* 22 de interlineado: es un parrafo, el unico del sistema, y por eso no sale de
       la escala de --sf-line-height-*. */
    .footer__about {
      margin: 0;
      font-size: 14px;
      font-weight: 400;
      line-height: 22px;
      color: var(--sf-muted);
    }
    /* Element: nav — "Descubre" y su lista */
    .footer__nav {
      display: flex;
      flex: 0 0 auto;
      flex-direction: column;
      gap: 12px;
    }
    /* La spec pide letter-spacing 100%, que en Inter 14 son 14px por letra:
       "D E S C U B R E" ocuparia 180 y dejaria de leerse como una palabra. Se usa
       0.1em, el tracking con el que se compone un rotulo en versales, que es lo que
       el valor queria decir. */
    .footer__heading {
      margin: 0;
      font-size: 14px;
      font-weight: 600;
      line-height: 1;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--sf-gold);
    }
    .footer__links {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin: 0;
    }
    /* Los cuatro rotulos de "Descubre" son enlaces: "Menu completo" a la portada
       entera y las tres categorias a la portada ya filtrada (ver
       src/lib/discover.ts). La clase sigue partida en dos porque el hover se declara
       sobre `a` y no sobre ella, que es lo que .footer__social-link necesita: ahi si
       convive un <a> con dos <span>. */
    .footer__link {
      font-size: 14px;
      font-weight: 400;
      line-height: 1;
      color: var(--sf-muted);
    }
    a.footer__link {
      transition: color 160ms ease;
    }
    a.footer__link:hover {
      color: var(--sf-gold);
    }
    /* Element: divider — la linea de 1 de la spec (height 0 + borde) */
    .footer__divider {
      height: 0;
      margin: 0;
      border: 0;
      border-top: 1px solid var(--sf-border);
      opacity: 1;
    }
    /* Element: bottom — derechos a la izquierda, redes a la derecha */
    .footer__bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    /* 13px: el cuerpo menor del pie. No esta en la escala (12/14/16/24) y no la
       abre, igual que el 15 de los rotulos de la barra de desktop. */
    .footer__copyright {
      margin: 0;
      font-size: 13px;
      font-weight: 400;
      line-height: 1;
      color: var(--sf-placeholder);
    }
    .footer__social {
      display: flex;
      align-items: center;
      gap: 16px;
      margin: 0;
    }
    /* Igual que .footer__link: Facebook e Instagram son texto hasta que la tienda
       publique sus perfiles, y no pueden verse distintos de WhatsApp, que si lo es. */
    .footer__social-link {
      font-size: 13px;
      font-weight: 400;
      line-height: 1;
      color: var(--sf-placeholder);
    }
    a.footer__social-link {
      transition: color 160ms ease;
    }
    a.footer__social-link:hover {
      color: var(--sf-gold);
    }
  }
</style>
