---
interface Props {
  /** Titular del banner, maximo 80. */
  title?: string;
  /** Linea de apoyo, maximo 180. */
  description?: string;
  /**
   * Fondo del banner. URL ABSOLUTA, ya resuelta por el backend: no se concatena
   * con ninguna base, que cambia entre local, staging y produccion.
   */
  image?: string;
}

const { title, description, image } = Astro.props;

// Panel de bienvenida de la portada. SOLO DESKTOP: en movil no se pinta —lo
// oculta los estilos de este archivo— porque ahi la primera pantalla es del catalogo y
// un panel de este tamano la empujaria entera fuera de la vista.
//
// Lo escribe el panel de la tienda (`home.banner` de GET /api/store) y no el
// codigo: es una campana, y cambiarla no puede exigir un despliegue.
//
// Las tres piezas sirven por separado, asi que se comprueban por separado: con
// texto y sin foto queda una franja de texto, con foto y sin texto un fondo, y
// sin nada de lo tres no hay banner que inventar —la portada abre en el
// catalogo—.
const hasText = Boolean(title || description);

// La URL acaba dentro de un `url()` en el atributo style, asi que se filtra
// antes: solo http(s), y citada con comillas para que un parentesis o un punto y
// coma en la ruta no cierren la declaracion y abran otra.
const photo = image && /^https?:\/\//i.test(image) ? image : undefined;

const style = photo ? `--sf-hero-photo: url(${JSON.stringify(photo)})` : undefined;
---

{
  (hasText || photo) && (
    <section class="hero" aria-label="Bienvenida">
      <div class="hero__panel" style={style}>
        {hasText && (
          <div class="hero__text">
            {title && <h1 class="hero__title">{title}</h1>}
            {description && <p class="hero__subtitle">{description}</p>}
          </div>
        )}
      </div>
    </section>
  )
}

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: hero
     ---------------------------------------------------------------------------
     Panel de bienvenida de la portada. SOLO DESKTOP: en movil la primera pantalla
     es del catalogo, y un panel de este tamano la empujaria entera fuera de la
     vista.

     Que se oculte con display: none, y que la foto solo se declare dentro del
     media query, es lo que evita que el movil descargue una imagen que no va a
     ver: la referencia a --sf-hero-photo no existe hasta los 768.

     Spec: radius 16 - padding 48 - texto blanco sobre foto de comida
     titulo Inter 700 36/44 - bajada Inter 400 16/24 - gap 12
     --------------------------------------------------------------------------- */
  .hero {
    display: none;
  }

  /* --- Desktop ------------------------------------------------------------- */
  @media (min-width: 768px) {
    /* Sin sangria propia: el margen lateral lo pone la pila de la portada (ver
       pages/index.astro), que es el contenedor de los tres bloques. */
    .hero {
      display: block;
    }
    .hero__panel {
      width: 100%;
      /* 48 + 44 (titulo) + 12 + 24 (bajada) + 48. Lo declara como minimo y no como
         alto para que el banner no cambie de tamano segun lo que traiga: un
         titular de dos lineas lo estira, y uno que llega solo con foto —sin texto
         que lo sostenga— sigue siendo un banner y no una tira de 96. */
      min-height: 176px;
      padding: 48px;
      border-radius: 16px;
      /* Dos capas: el velo oscuro y, debajo, la foto que manda el panel. El velo
         no es decoracion —es lo que sostiene el texto blanco—: una foto de comida
         trae zonas claras y sin el la bajada de 16 desaparece en la primera
         tortilla que le toque. Componerlo es cosa de la tienda: la API manda las
         tres piezas sueltas, no una imagen con el texto quemado dentro.

         Sin foto manda el degradado de marca, el mismo de la ficha de platillo:
         asi un banner de solo texto se lee como una franja intencionada y no como
         una imagen que no cargo. */
      background-color: var(--sf-ink);
      background-image: linear-gradient(0deg, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)), var(--sf-hero-photo, linear-gradient(180deg, var(--sf-amber) 0%, var(--sf-gold) 100%));
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
    }
    .hero__text {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    /* 36/44 no esta en la escala de tokens y no se anade por una pieza: es el
       unico titular de este tamano del diseno. */
    .hero__title {
      margin: 0;
      font-size: 36px;
      font-weight: 700;
      line-height: 44px;
      color: var(--sf-white);
    }
    .hero__subtitle {
      margin: 0;
      font-size: 16px;
      font-weight: 400;
      line-height: 24px;
      color: var(--sf-white);
    }
  }
</style>
