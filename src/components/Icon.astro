---
// Sistema de iconos de la maqueta. Los trazos viven en src/lib/icons.ts, no
// aqui: el carrito los necesita tambien desde el navegador, donde un componente
// .astro no se puede invocar. Este componente es la forma de dibujarlos en el
// marcado servido; iconHtml() es la otra.

import {
  ICON_PATHS,
  iconClass,
  iconViewBox,
  type IconName,
  type IconSize,
} from '../lib/icons.ts';

export type { IconName };

interface Props {
  name: IconName;
  size?: IconSize;
  class?: string;
}

const { name, size = 'md', class: className } = Astro.props;
---

<svg
  class:list={[iconClass(size), className]}
  viewBox={iconViewBox(name)}
  aria-hidden="true"
  focusable="false"
  set:html={ICON_PATHS[name]}
/>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: icon
     ---------------------------------------------------------------------------
     SVG en linea que hereda el color del padre (currentColor), asi los estados
     de los botones no necesitan reglas extra.

     viewBox 20x20, trazo 2 y remates redondos. Los tamanos escalan el trazo en
     proporcion, por eso --sm no lo recalcula.
     --------------------------------------------------------------------------- */
  .icon {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Modifier: tamano 16x16 (metas y boton "+") */
  .icon--sm {
    width: 16px;
    height: 16px;
  }

  /* Modifier: tamano 40x40. Solo el sello de /confirmado, donde el visto
     ocupa la mitad de un circulo de 80. */
  .icon--lg {
    width: 40px;
    height: 40px;
  }
</style>
