---
// Sistema de iconos de la maqueta. Los trazos viven en src/lib/icons.ts, no
// aqui: el carrito los necesita tambien desde el navegador, donde un componente
// .astro no se puede invocar. Este componente es la forma de dibujarlos en el
// marcado servido; iconHtml() es la otra.

import {
  ICON_PATHS,
  iconClass,
  iconViewBox,
  type IconName,
  type IconSize,
} from '../lib/icons.ts';

export type { IconName };

interface Props {
  name: IconName;
  size?: IconSize;
  class?: string;
}

const { name, size = 'md', class: className } = Astro.props;
---

<svg
  class:list={[iconClass(size), className]}
  viewBox={iconViewBox(name)}
  aria-hidden="true"
  focusable="false"
  set:html={ICON_PATHS[name]}
/>
