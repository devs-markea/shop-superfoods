---
interface Props {
  /** De `legal.termsUrl`. Sin ella, la frase se rotula sin enlazar. */
  termsUrl?: string;
}

const { termsUrl } = Astro.props;

// Aviso legal antes de confirmar.
//
// "Terminos y condiciones" es un enlace solo si hay URL configurada. Sin ella se
// rotula como texto: un enlace que no lleva a ninguna parte es peor que ninguno,
// y aqui ademas se afirma que el comprador los acepta.
const label = 'Terminos y condiciones';
---

<p class="legal-note">
  Al continuar aceptas nuestros{' '}
  {
    termsUrl ? (
      <a class="legal-note__link" href={termsUrl} target="_blank" rel="noopener">
        {label}
      </a>
    ) : (
      label
    )
  }{' '}
  de servicio.
</p>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: legal-note
     ---------------------------------------------------------------------------
     Aviso legal antes de confirmar.
     Spec: Inter 500 12/16 centrado #9CA3AF
     --------------------------------------------------------------------------- */
  .legal-note {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    color: var(--sf-placeholder);
    text-align: center;
  }

  /* Element: enlace a los terminos. Solo aparece si hay URL configurada; sin ella la
     frase es texto del mismo aviso, sin subrayar, para no prometer un destino.

     Subrayado y no dorado: es letra legal, no una accion del flujo, y un dorado aqui
     competiria con el boton que tiene justo debajo. */
  .legal-note__link {
    color: var(--sf-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-note__link:hover {
    color: var(--sf-ink);
  }
</style>
