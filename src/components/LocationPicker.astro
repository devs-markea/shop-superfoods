---
import Icon from './Icon.astro';
import Sheet from './Sheet.astro';

interface Props {
  /**
   * Modo de pruebas. Cambia quien da el punto: en lugar de pedirselo al
   * navegador, el boton abre la hoja para escribirlo a mano. Es lo que permite
   * probar el flujo de envio desde fuera de Cancun.
   */
  testMode?: boolean;
}

const { testMode = false } = Astro.props;

// Spec: gap 16 — etiqueta + boton dorado + pista.
// El icono es el mismo componente que usa la navbar en gris: hereda el dorado
// de .location__button por currentColor.
//
// La ubicacion elegida se guarda en un input oculto, que es lo que la API llama
// `customer.locationUrl`: un enlace de Google Maps al punto. Debajo del boton
// aparece el label con la ubicacion, oculto mientras no haya ninguna.
//
// Es OPCIONAL y complementa a la direccion escrita, que es la que lee el
// repartidor. Lo que aporta es el envio: con un punto, el backend puede medir la
// distancia y cotizarlo; sin el, se confirma al final, a mano.
//
// DE DONDE SALE EL PUNTO
//
// Primero del dispositivo, que es lo unico que sabe donde esta. Pero pedirselo al
// navegador no garantiza un GPS: sin sensor, sin permiso o en un escritorio, lo
// que responde es una posicion deducida de la IP del proveedor, que puede caer a
// cientos de kilometros —la de un cliente de Cancun puede dar Monterrey— y con
// ella el envio se cotizaria mal. Por eso la respuesta se mira antes de aceptarla
// (ver src/scripts/delivery-form.ts) y, cuando no sirve, queda esta hoja: abrir
// Maps, encontrar el domicilio y pegar el enlace.
---

<div class="location" data-location>
  <h2 class="section-label" id="location-label">Ubicacion</h2>

  <button
    class="location__button btn-plain"
    type="button"
    aria-describedby="location-label"
    data-share-location
  >
    <Icon name="map-pin" />
    <span>{testMode ? 'Indicar ubicacion (modo de pruebas)' : 'Compartir ubicacion (recomendado)'}</span>
  </button>

  <input type="hidden" name="locationUrl" data-location-url />

  {/*
    Ubicacion elegida. El propio texto es el enlace al punto en Google Maps, para
    que se pueda comprobar antes de seguir.
  */}
  <p class="location__selected" hidden data-location-selected>
    <Icon name="map-pin" size="sm" />

    <a class="location__value" href="#" target="_blank" rel="noopener" data-location-link>
      <span data-location-label></span>
    </a>

    <button
      class="location__clear btn-plain"
      type="button"
      aria-label="Quitar la ubicacion"
      data-location-clear
    >
      Quitar
    </button>
  </p>

  <p class="location__hint">o ingresa manualmente</p>
</div>

{/*
  La hoja de la ubicacion a mano. Es la misma en los dos casos —modo de pruebas y
  respaldo cuando el dispositivo no da un punto fiable—, porque el trabajo es el
  mismo: traer un punto de Google Maps.

  Vive fuera de .location para no heredar su columna: el <dialog> se coloca solo.
*/}
<Sheet id="location-input" title="Indicar tu ubicacion">
  <p class="sheet__text" data-manual-intro>
    {
      testMode
        ? 'Modo de pruebas: escribe el punto a mano en lugar de pedirselo al navegador.'
        : 'Abre Google Maps, busca tu domicilio y manten pulsado el punto exacto. Copia las coordenadas o el enlace y pegalos aqui.'
    }
  </p>

  <a
    class="btn btn-outline-secondary"
    href="https://www.google.com/maps/@21.1619,-86.8515,13z"
    target="_blank"
    rel="noopener"
  >
    Abrir Google Maps
  </a>

  <label class="visually-hidden" for="field-manual-location">Enlace o coordenadas</label>
  <input
    class="field form-control"
    id="field-manual-location"
    type="text"
    inputmode="text"
    autocomplete="off"
    placeholder="21.1421, -86.8235"
    data-manual-input
  />

  <p class="form-error" role="alert" hidden data-manual-error></p>

  <button class="btn btn-primary" type="button" data-manual-apply>Usar esta ubicacion</button>
</Sheet>
