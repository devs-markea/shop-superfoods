---
import Icon from './Icon.astro';
import Sheet from './Sheet.astro';
import LocationMap from './LocationMap.astro';
import FormError from './FormError.astro';
import SectionLabel from './SectionLabel.astro';
import { GOOGLE_MAPS_API_KEY } from 'astro:env/client';

// Spec: gap 16 — etiqueta + boton dorado + pista.
// El icono es el mismo componente que usa la navbar en gris: hereda el dorado
// de .location__button por currentColor.
//
// La ubicacion elegida se guarda en un input oculto, que es lo que la API llama
// `customer.locationUrl`: un enlace de Google Maps al punto. Debajo del boton
// aparece el label con la ubicacion, oculto mientras no haya ninguna.
//
// Es OPCIONAL y complementa a la direccion escrita, que es la que lee el
// repartidor. Lo que aporta es el envio: con un punto, el backend puede medir la
// distancia y cotizarlo; sin el, se confirma al final, a mano.
//
// EN DESKTOP ES SOLO EL BOTON
//
// El rotulo "Ubicacion" y la pista "o ingresa manualmente" son de movil: alli
// este bloque va suelto y tiene que decir de que va y que hay otro camino. En
// desktop el grupo entero lo rotula "Direccion" —lo pone /datos— y los campos
// escritos quedan justo debajo, asi que las dos frases sobrarian: repetirian el
// mismo titulo y describirian algo que ya se ve. Se retiran con d-md-none, y con
// ellas se va la columna de este bloque (ver los estilos de este archivo): el boton
// pasa a ser una pieza mas del bloque de direccion.
//
// DE DONDE SALE EL PUNTO
//
// Lo senala el comprador en un mapa, aqui dentro: se mueve el mapa hasta el
// domicilio y se acepta. Ni el pedido ni el envio dependen ya de lo que el
// navegador crea que sabe —ver src/lib/map-picker.ts, donde esta el porque—.
//
// Y hay DOS caminos hasta ese mapa, segun conteste Google:
//
//   con mapa   el panel de <LocationMap> se pinta aqui mismo, en el hueco del
//              boton, y se confirma con su boton verde. Es el camino normal.
//   sin mapa   —sin clave, clave rechazada, sin red— el panel se retira y queda
//              este boton, que abre la hoja de abajo. Alli el respaldo es la
//              posicion del dispositivo, con filtro de precision.
//
// Cual de los dos manda no se sabe en el servidor: se descubre al pedirle el SDK
// a Google. Asi que los dos se sirven y lo decide src/lib/location-map.ts, que
// destapa el panel y retira las piezas marcadas con `data-location-fallback` —el
// boton, su pista y el enlace de quitar, que en el panel es el boton rojo—.
//
// Y si tampoco hay posicion utilizable, lo dice y ya: esto es opcional, lo que el
// pedido necesita es la direccion escrita, y lo unico que se pierde es la
// cotizacion previa del envio.
---

<div class="location" data-location>
  <SectionLabel as="h2" class="d-md-none" id="location-label">Ubicacion</SectionLabel>

  <button
    class="location__button btn-plain"
    type="button"
    aria-describedby="location-label"
    aria-haspopup="dialog"
    data-share-location
    data-location-fallback
  >
    <Icon name="map-pin" />
    <span>Elegir ubicacion en el mapa</span>
  </button>

  {/* El mapa en linea, que releva al boton cuando Google responde. Se sirve
      oculto: si hay mapa o no se descubre en el navegador. */}
  <LocationMap />

  <input type="hidden" name="locationUrl" data-location-url />

  {/*
    Ubicacion elegida. El propio texto es el enlace al punto en Google Maps, para
    que se pueda comprobar antes de seguir.
  */}
  <p class="location__selected" hidden data-location-selected>
    <Icon name="map-pin" size="sm" />

    <a class="location__value" href="#" target="_blank" rel="noopener" data-location-link>
      <span data-location-label></span>
    </a>

    {/* Con el panel puesto lo hace su boton rojo, que ademas desbloquea el mapa
        para senalar otro punto: dos formas de quitar la misma ubicacion, una al
        lado de la otra, solo pueden confundir. */}
    <button
      class="location__clear btn-plain"
      type="button"
      aria-label="Quitar la ubicacion"
      data-location-clear
      data-location-fallback
    >
      Quitar
    </button>
  </p>

  {/* La pista del boton. El panel lleva la suya en la cabecera, y ademas la
      cambia al confirmar, asi que esta se retira con el resto del camino. */}
  <p class="location__hint d-md-none" data-location-fallback>Mueve el mapa hasta tu domicilio</p>
</div>

{/*
  La hoja del mapa. Vive fuera de .location para no heredar su columna: el
  <dialog> se coloca solo.
*/}
<Sheet id="location-input" title="Indicar tu ubicacion" wide persistent>
  {/*
    El mapa y sus dos controles. La clave viaja en un data-, como el resto de lo
    que el servidor le pasa a un script de esta tienda; sin ella el bloque se
    retira solo y queda el respaldo de abajo.
  */}
  <div class="map-picker" data-map-picker data-maps-key={GOOGLE_MAPS_API_KEY}>
    <p class="sheet__text">
      Mueve el mapa hasta tu domicilio. El pin marca el punto exacto al que llega el repartidor.
    </p>

    {/* El buscador de Google se inserta aqui al cargar el mapa. Oculto mientras
        no llegue: un hueco vacio encima del mapa no dice nada. */}
    <div class="map-picker__search" hidden data-map-search></div>

    <div class="map-picker__stage" data-map-stage>
      <div class="map-picker__canvas" data-map-canvas></div>

      {/*
        El pin, clavado en el centro. No se arrastra —lo que se mueve es el mapa
        por debajo, ver src/lib/map-picker.ts— asi que no recibe el puntero y no
        se anuncia: lo que dice donde esta el punto es el texto de abajo.
      */}
      <span class="map-picker__pin" aria-hidden="true">
        <Icon name="map-pin" />
      </span>

      <button
        class="map-picker__locate btn-plain"
        type="button"
        aria-label="Centrar el mapa en mi ubicacion"
        data-map-locate
      >
        <Icon name="crosshair" size="sm" />
      </button>

      {/* Mientras carga el SDK. Se queda sobre el hueco del mapa para que la
          hoja no de un salto de alto al llegar. */}
      <p class="map-picker__status" hidden data-map-status></p>
    </div>

    {/*
      Aqui NO se rotula la direccion del pin, a proposito. Lo que confirma el
      sitio es el mapa —sus calles estan pintadas y el pin queda sobre el techo—
      y la direccion escrita aparece al aceptar, en /datos, resuelta por el
      backend al cotizar. Leerla tambien aqui costaba una consulta a Google en
      CADA parada del mapa para acabar diciendo lo mismo. Ver
      src/lib/map-picker.ts.
    */}
  </div>

  {/*
    Aceptar. Si el mapa no llega a cargar, el script lo retira junto al mapa y su
    buscador: sin mapa este boton confirmaria el centro de Cancun como si fuera el
    domicilio de alguien. En su lugar se destapa el respaldo de abajo.
  */}
  <button class="btn btn-primary" type="button" data-map-apply>Usar esta ubicacion</button>

  {/*
    El respaldo, y solo para cuando el mapa no se puede usar: sin clave, con una
    clave que Google rechaza, sin red o con el script bloqueado. Se sirve oculto
    porque ese fallo se descubre en el navegador y no aqui.

    Pide la posicion al dispositivo, que es el otro sitio de donde puede salir un
    punto sin hacer copiar nada. Va con filtro de precision —ver
    MAX_ACCURACY_METERS en src/lib/map-picker.ts—: aqui el punto se acepta sin
    verlo, asi que una posicion deducida de la IP se rechaza en lugar de acabar
    cotizando un envio a otra ciudad.

    Y si tampoco hay posicion, no pasa nada grave: lo dice y el pedido sigue con la
    direccion escrita, que es la obligatoria.
  */}
  <div class="map-picker__offline" hidden data-map-offline>
    <p class="sheet__text">
      No pudimos cargar el mapa. Puedes usar la ubicacion de tu dispositivo, o cerrar esta ventana y
      escribir tu direccion en el formulario: en ese caso confirmamos el costo de envio al finalizar
      tu pedido.
    </p>

    <button class="btn btn-primary" type="button" data-map-geolocate>
      <Icon name="crosshair" size="sm" />
      <span>Usar mi ubicacion actual</span>
    </button>

    <FormError mark="data-map-offline-error" />
  </div>
</Sheet>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: location
     ---------------------------------------------------------------------------
     Bloque de ubicacion: etiqueta, boton de compartir y pista de alternativa.
     Spec: gap 16
     --------------------------------------------------------------------------- */
  .location {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* La etiqueta usa el bloque .section-label, compartido con el resto de grupos. */
  /* Element: boton de compartir ubicacion
     Spec: 350x44 - gap 8 - padding vertical 12 - radius 12 - borde 1 #D5AA53
     label Inter 600 14/20 #D5AA53

     El `color` dorado lo hereda el icono por currentColor: el mismo componente
     Icon sale gris en la navbar y dorado aqui, sin duplicar el trazado. */
  .location__button {
    display: flex;
    width: 100%;
    max-width: 350px;
    height: 44px;
    margin-inline: auto;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-block: 12px;
    border: 1px solid var(--sf-gold);
    border-radius: 12px;
    color: var(--sf-gold);
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    transition: background-color 160ms ease;
  }
  .location__button:hover {
    background-color: var(--sf-gold-tint);
  }

  /* Element: ubicacion elegida. Aparece bajo el boton en cuanto hay una, con el
     icono en dorado y el texto legible del punto. */
  .location__selected {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 0;
    color: var(--sf-gold);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    text-align: center;
  }

  /* Element: el texto del punto, que enlaza a Google Maps */
  .location__value {
    color: var(--sf-ink);
    text-decoration: underline;
    text-decoration-color: var(--sf-border);
    text-underline-offset: 2px;
  }
  .location__value:hover {
    color: var(--sf-ink);
    text-decoration-color: var(--sf-gold);
  }

  /* Element: quitar la ubicacion */
  .location__clear {
    flex: 0 0 auto;
    color: var(--sf-placeholder);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    text-decoration: underline;
  }
  .location__clear:hover {
    color: var(--sf-muted);
  }

  /* Element: pista — Inter 500 12/16 centrado #9CA3AF */
  .location__hint {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    color: var(--sf-placeholder);
    text-align: center;
  }

  /* --- Desktop -------------------------------------------------------------
     Aqui este bloque deja de ser una columna con rotulo propio: sus dos frases son
     de movil y las retira el marcado (ver LocationPicker.astro), y lo que queda
     —el boton y la ubicacion elegida— pasa a formar parte del bloque de direccion,
     que es quien lleva el ritmo de 12 en desktop.

     `display: contents` es lo que lo consigue sin tocar el marcado de movil: el
     envoltorio deja de pintar y de ocupar, y sus hijos se reparten en la columna de
     arriba como si fueran suyos. */
  @media (min-width: 768px) {
    .location {
      display: contents;
    }
    /* El boton pierde el tope de 350 y ocupa la columna entera, como los campos que
       tiene debajo: es una pieza mas del bloque de direccion y se alinea con ellos
       por los dos lados. El `margin-inline: 0` va explicito porque el `auto` que lo
       centra en movil solo se anula si el ancho llena el hueco, y aqui el ancho lo
       decide la columna.

       Y se rellena de blanco, que es el otro cambio de la spec: en movil el boton se
       lee por su borde dorado sobre el fondo de la pagina; aqui es un control con
       superficie propia. El alto sigue siendo el de todos los controles, 44. */
    .location__button {
      max-width: none;
      margin-inline: 0;
      padding-inline: 16px;
      background-color: var(--sf-white);
    }
  }
  /* ---------------------------------------------------------------------------
     Block: map-picker
     ---------------------------------------------------------------------------
     El selector de ubicacion de /datos: un mapa dentro de la hoja, con un pin
     clavado en su centro. El comprador mueve el MAPA hasta su domicilio y acepta.

     No hay spec de Figma para esta pieza: se compone con el sistema que ya existe
     —radius 12 como los campos, el dorado de marca en el pin, los grises de las
     notas— para que no se lea como algo pegado de otro proyecto.

     La ley de este bloque es que el pin y el centro del mapa sean EL MISMO PUNTO.
     De ahi salen las dos reglas que no se pueden tocar sin romperlo: el escenario
     es `position: relative` y el pin va al 50/50 con su punta en ese cruce.
     --------------------------------------------------------------------------- */
  .map-picker {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Element: el hueco del mapa.

     `relative` para que el pin, el boton de la diana y el aviso de carga se
     coloquen contra el, y `overflow: hidden` para que el mapa —que pinta sus
     propios tiles hasta el borde— respete el radio. */
  .map-picker__stage {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--sf-border);
    border-radius: 12px;
    /* El fondo se ve mientras cargan los tiles: gris de pagina, no blanco, para
       que el hueco se lea como "aqui va algo" y no como una tarjeta vacia. */
    background-color: var(--sf-body-bg);
  }

  /* Element: el lienzo de Google.

     El alto es fijo y en dvh con tope: la hoja entera vive dentro de un 85dvh, y
     un mapa que crezca con el contenido dejaria el boton de aceptar fuera de la
     pantalla justo en el movil donde mas se usa.

     En desktop crece con la hoja (.sheet--wide): ahi sobra alto de pantalla, y un
     mapa mas grande es menos arrastre para llegar al mismo portal. El `clamp`
     sigue mandando, asi que en un portatil bajo no se come el boton de aceptar. */
  .map-picker__canvas {
    width: 100%;
    height: clamp(220px, 42dvh, 360px);
  }
  @media (min-width: 768px) {
    .map-picker__canvas {
      height: clamp(320px, 55dvh, 480px);
    }
  }

  /* Element: el pin.

     Centrado en los dos ejes y subido su propio alto, para que la PUNTA quede en
     el centro exacto del mapa: es lo que hace que lo que se ve senalado y lo que
     se guarda sean el mismo punto. Sin ese desplazamiento, el punto quedaria medio
     pin mas abajo de donde parece.

     `pointer-events: none` porque no es un control: los gestos son del mapa que
     tiene debajo, y un pin que los intercepte congela el arrastre justo en el
     centro, que es donde el dedo suele estar. */
  .map-picker__pin {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -100%);
    color: var(--sf-gold);
    pointer-events: none;
    /* Encima de los controles del mapa, que Google pinta en su propia capa. */
    z-index: 2;
    /* El pin es dorado sobre un mapa de colores cualesquiera: la sombra es lo que
       lo despega de una avenida amarilla o de un parque verde. */
    filter: drop-shadow(0 2px 4px var(--sf-scrim));
  }

  /* Element: la diana que centra el mapa donde esta el comprador.

     Abajo a la derecha, que es donde la ponen todos los mapas y donde el pulgar
     llega sin tapar el centro. Caja de 36 y no de 44: es un atajo sobre el mapa,
     no un control del formulario, y a 44 competiria con el pin. */
  .map-picker__locate {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background-color: var(--sf-white);
    color: var(--sf-ink);
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 5%);
    transition: color 160ms ease;
  }
  .map-picker__locate:hover {
    color: var(--sf-gold);
  }
  .map-picker__locate:disabled {
    color: var(--sf-placeholder);
  }

  /* Element: el aviso sobre el hueco del mapa. Sirve para los dos momentos en los
     que no hay mapa que ensenar —mientras carga, y si no llego a cargar— y ocupa el
     hueco entero para que la hoja no de un salto de alto en ninguno de ellos. */
  .map-picker__status {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    color: var(--sf-muted);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }

  /* Element: el buscador de Google, encima del mapa.

     El widget es un web component de Google con su propio shadow DOM, asi que de
     aqui solo se puede gobernar la caja: el ancho, y las variables que el propio
     componente publica para su tipografia y su radio. */
  .map-picker__search {
    --gmp-mat-color-primary: var(--sf-gold);
    width: 100%;
  }
  .map-picker__search gmp-place-autocomplete {
    width: 100%;
    font-family: var(--sf-font-inter), -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    border-radius: 12px;
  }

  /* Bajo el mapa no va nada: la direccion del pin no se rotula aqui. El cierre de
     la hoja es el boton de aceptar. Ver LocationPicker.astro. */
  /* Element: el respaldo, cuando el mapa no se pudo cargar. Releva al mapa entero
     —no convive con el— y pide la posicion al dispositivo. Mismo ritmo que el resto
     de la hoja, para que el cambio de piel no se lea como otra pantalla.

     El boton lleva icono y texto, asi que necesita la misma fila que los botones de
     icono del proyecto: .btn de Bootstrap no centra su contenido en linea. */
  .map-picker__offline {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .map-picker__offline .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
</style>
