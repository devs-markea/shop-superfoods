---
import Sheet from './Sheet.astro';
import Icon from './Icon.astro';

interface Props {
  /** Direccion escrita. Puede faltar: entonces solo se ofrece el boton. */
  address?: string;
  /** Enlace de Google Maps al local. Puede faltar: entonces no hay boton. */
  mapsUrl?: string;
}

const { address, mapsUrl } = Astro.props;

// Ubicacion de la tienda, detras del icono del pin.
//
// Los dos datos sirven por separado y por eso ninguno obliga al otro: de un enlace
// de Maps no sale una direccion legible —`maps.app.goo.gl/xxxx` es opaco— y de una
// direccion escrita no sale un enlace fiable. Con los dos, se lee y se abre; con
// uno, se hace lo que ese permita.
//
// Quien decide si esta hoja existe es la barra superior: sin ninguno de los dos, el
// icono no se pinta y aqui no se llega.
---

<Sheet id="sheet-location" title="Ubicacion">
  {
    address ? (
      <p class="location-sheet__address">{address}</p>
    ) : (
      <p class="location-sheet__hint">Abre el mapa para ver donde estamos.</p>
    )
  }

  {
    mapsUrl && (
      <a
        class="location-sheet__link btn btn-primary"
        href={mapsUrl}
        target="_blank"
        rel="noopener"
      >
        <Icon name="map-pin" size="sm" />
        <span>Abrir en Google Maps</span>
      </a>
    )
  }
</Sheet>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: location-sheet
     ---------------------------------------------------------------------------
     Contenido de la hoja de ubicacion: la direccion escrita y el boton que abre
     Google Maps.

     Sin spec de Figma: el boton es el de accion del proyecto (44 de alto, radius 12,
     dorado) y la direccion, el tipo de dato de las tarjetas.

     Los dos elementos son independientes: con solo direccion la hoja se queda sin
     boton, y con solo enlace la direccion se sustituye por una pista.
     --------------------------------------------------------------------------- */
  /* Element: direccion — Inter 500 14/20 */
  .location-sheet__address {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--sf-ink);
  }

  /* Element: pista cuando no hay direccion escrita */
  .location-sheet__hint {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    color: var(--sf-placeholder);
  }

  /* Element: boton a Maps. Mismas medidas que la accion principal del proyecto. */
  .location-sheet__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
  }
</style>
