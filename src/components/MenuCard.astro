---
import Icon from './Icon.astro';
import PromoBadge from './PromoBadge.astro';
import { formatPrice } from '../lib/price.ts';
import { productHref, type ProductListItem } from '../lib/catalog.ts';
import { productCardView } from '../lib/product-card.ts';

interface Props {
  product: ProductListItem;
  /** La primera tarjeta no se carga en diferido: entra en el primer viewport. */
  eager?: boolean;
  /** Ver la prop del mismo nombre en <ProductCard>. */
  storeClosed?: boolean;
}

const { product, eager = false, storeClosed = false } = Astro.props;

// La tarjeta de las categorias de la portada. Cuenta lo mismo que <ProductCard> —lo
// deciden las dos en src/lib/product-card.ts— con otra estructura en desktop:
//
//   texto a la izquierda   nombre, precio y descripcion, en ese orden
//   foto a la derecha      de arriba abajo, con el "+" en su esquina: se queda
//                          donde estaba, abajo a la derecha de la tarjeta, y ahora
//                          eso cae sobre la foto
//
// EN MOVIL ES LA TARJETA DE SIEMPRE —foto de 80 a la izquierda; nombre,
// descripcion y, al pie, precio y "+"—: la estructura nueva es solo de desktop.
// Como el marcado va en el orden de desktop, en movil el cuerpo se deshace
// (`display: contents`) y cada pieza se coloca en la rejilla de la tarjeta.
//
// LOS ROTULOS SON LOS DE <ProductCard>: nombre, insignia, precios, descripcion y
// "+" llevan sus clases, y con ellas sus estilos —tamanos, colores y recortes—. Las clases propias, .menu-card__*, son solo de la
// estructura. Esos estilos viven en components/ProductCard.astro, que la portada
// carga siempre: <MenuSection> importa las dos tarjetas.
const { orderable, notice, promo, displayName, image } = productCardView(product, storeClosed);
---

<article
  class:list={[
    'menu-card',
    'card',
    !image && 'menu-card--no-media',
    !orderable && 'menu-card--unavailable',
  ]}
>
  <div class="menu-card__body">
    <h3 class="product-card__title">
      <!-- stretched-link: toda la tarjeta es clicable, el "+" incluido.
           Los no disponibles tambien enlazan: el detalle existe.
           El title lleva el nombre entero: es lo que recupera lo que corta el
           recorte. -->
      <a class="stretched-link text-reset" href={productHref(product)} title={product.name}>
        {displayName}
      </a>

      {promo && <PromoBadge label={promo.label} name={promo.name} class="product-card__promo" />}
    </h3>

    <div class="menu-card__pricing">
      <span class="product-card__prices">
        {/* "Desde" solo en desktop, como en <ProductCard>. Final primero y tachado
            despues: lo que se paga es lo que se viene a leer. */}
        <span class="product-card__from">Desde</span>
        <span class="product-card__price">{formatPrice(promo?.price ?? product.basePrice)}</span>

        {
          promo?.original !== undefined && promo?.original !== null && (
            <s class="price-was">{formatPrice(promo.original)}</s>
          )
        }
      </span>

      {/* La aclaracion del descuento que no alcanza a todas las variantes. La
          etiqueta de ahorro sigue oculta, como en <ProductCard>. */}
      {
        promo?.note && (
          <p class="product-card__deal">
            <span class="promo-note">{promo.note}</span>
          </p>
        )
      }
    </div>

    <!-- La API manda cadena vacia cuando no hay descripcion -->
    {product.description && <p class="product-card__description">{product.description}</p>}
  </div>

  {/* La caja de la foto arranca como esqueleto y lo suelta cuando la imagen llega
      (src/scripts/image-skeleton.ts), igual que en <ProductCard>. Sin foto no hay
      caja: el texto se queda con todo el ancho. */}
  {
    image && (
      <div class="menu-card__media skeleton" data-skeleton>
        <img
          class="menu-card__image"
          src={image.src}
          width="168"
          height="168"
          alt={image.alt}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      </div>
    )
  }

  {/* El "+" o, si el platillo no se puede pedir por un motivo propio, ese motivo en
      su lugar. Con la tienda cerrada el "+" se queda, apagado, y la etiqueta se
      calla porque repetiria lo ya dicho.

      El "+" no es un boton: es un dibujo dentro del area del enlace, igual que en
      <ProductCard>. */}
  <div class="menu-card__action">
    {
      notice ? (
        <span class="tag tag--optional badge">{notice}</span>
      ) : (
        <span
          class:list={['product-card__add', !orderable && 'product-card__add--disabled']}
          aria-hidden="true"
        >
          <Icon name="plus" size="sm" />
        </span>
      )
    }
  </div>
</article>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: menu-card  (sobre .card de Bootstrap)
     ---------------------------------------------------------------------------
     La tarjeta de las categorias. Sale de .product-card: en movil reproduce su
     disposicion medida por medida, y en desktop cambia la estructura y conserva
     los rotulos.

     Movil (la de .product-card):
       height 128 - gap 12 - radius 16 - padding 16
       foto 80x80 a la izquierda; nombre, descripcion y, al fondo, precio y "+"

     Desktop: height 168 - foto a la derecha, de arriba abajo
       cuerpo: padding 20 - gap 12 - nombre, precio, descripcion
       "+" abajo a la derecha, a 20 de los bordes, sobre la foto
     --------------------------------------------------------------------------- */
  /* Movil: una rejilla en lugar de dos cajas flex anidadas, porque el marcado va en
     el orden de desktop —nombre, precio, descripcion— y aqui se lee nombre,
     descripcion, precio. El cuerpo se deshace y sus piezas caen en la rejilla de la
     tarjeta:

       foto | nombre       nombre
       foto | descripcion  descripcion
       foto | precio       "+"

     La fila del medio es la que crece: la descripcion se queda arriba y el pie al
     fondo, que es lo que hacia el `margin-top: auto` del pie de .product-card. Los
     huecos son los suyos: 12 entre columnas y 4 entre filas. */
  .menu-card {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr auto;
    gap: 4px 12px;
    min-height: 128px;
    height: 100%;
    padding: 16px;
    transition: box-shadow 160ms ease;
  }
  .menu-card:hover {
    box-shadow: 0 4px 12px 0 rgb(0 0 0 / 8%);
  }

  /* Modifier: sin foto. Sin su columna: una vacia seguiria cobrando su hueco de 12.
     Las piezas se colocan contando desde el final, asi que no hay que moverlas. */
  .menu-card--no-media {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .menu-card__body {
    display: contents;
  }
  .menu-card .product-card__title {
    grid-column: -3 / -1;
    grid-row: 1;
  }
  .menu-card .product-card__description {
    grid-column: -3 / -1;
    grid-row: 2;
    align-self: start;
  }

  /* Element: pricing — el par de precios y, debajo, lo que significa. En movil es
     el pie: 28 de alto, centrado con el "+". */
  .menu-card__pricing {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    grid-column: -3 / -2;
    grid-row: 3;
    align-self: center;
    min-width: 0;
    min-height: 28px;
  }

  /* Element: media — la foto. El gris es el esqueleto en reposo, como en
     .product-card__media. */
  .menu-card__media {
    grid-column: 1;
    grid-row: 1 / -1;
    align-self: start;
    width: 80px;
    height: 80px;
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--sf-border);
  }
  .menu-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Element: action — el "+" o el motivo. Debajo del stretched-link, que cubre la
     tarjeta entera con su ::after de z-index 1: pulsarlo es pulsar la tarjeta. */
  .menu-card__action {
    display: flex;
    grid-column: -2 / -1;
    grid-row: 3;
    align-self: center;
  }

  /* Modifier: no comprable ahora. Como .product-card--unavailable: atenuada,
     clicable y, en el sitio del "+", el motivo —o el "+" apagado, si lo que pasa es
     que la tienda esta cerrada—. */
  .menu-card--unavailable .menu-card__media,
  .menu-card--unavailable .product-card__title,
  .menu-card--unavailable .product-card__description,
  .menu-card--unavailable .menu-card__pricing {
    opacity: 0.55;
  }
  /* El area de clic, por encima de las piezas atenuadas: el titulo lleva dentro el
     enlace, y sin esto la foto, el precio y la descripcion se quedaban con el clic.
     Le vale sin `position` por ser un item de la rejilla en movil y uno flex en
     desktop. El porque, entero, en .product-card--unavailable
     (components/ProductCard.astro). */
  .menu-card--unavailable .product-card__title {
    z-index: 1;
  }
  .menu-card--unavailable:hover {
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 5%);
  }

  /* --- Desktop -------------------------------------------------------------
     El texto a la izquierda y la foto a la derecha, de arriba abajo. El "+" no se
     mueve de la esquina de abajo a la derecha, que ahora es la de la foto. */
  @media (min-width: 768px) {
    /* `flex-direction` explicito: .card de Bootstrap trae `column`. */
    .menu-card {
      position: relative;
      display: flex;
      flex-direction: row;
      gap: 0;
      height: 168px;
      min-height: 0;
      padding: 0;
    }

    .menu-card__body {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      gap: 12px;
      min-width: 0;
      padding: 20px;
      overflow: hidden;
    }
    /* Sin foto, el "+" cae sobre el texto: se le guarda su sitio a la derecha
       (34 del boton y 12 de aire, ademas de los 20 del borde). */
    .menu-card--no-media .menu-card__body {
      padding-right: 66px;
    }

    /* `align-self` vuelve a su sitio: el de movil centraba en la fila de la
       rejilla, y en una columna flex centraria en horizontal. */
    .menu-card__pricing {
      align-self: stretch;
      justify-content: flex-start;
      min-height: 0;
    }

    /* La foto ocupa la altura entera y redondea solo por la derecha, que es donde
       toca el borde de la tarjeta. Ancha en proporcion a la tarjeta —para que al
       texto le quede sitio en una columna estrecha— y como mucho cuadrada. */
    .menu-card__media {
      flex: 0 0 40%;
      width: auto;
      align-self: stretch;
      max-width: 168px;
      height: auto;
      border-radius: 0 16px 16px 0;
    }

    .menu-card__action {
      position: absolute;
      right: 20px;
      bottom: 20px;
    }
  }
</style>
