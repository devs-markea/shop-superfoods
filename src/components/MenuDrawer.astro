---
// Cajon del menu: .offcanvas de Bootstrap, abierto por la hamburguesa de la
// navbar. Es el unico componente de la vista que necesita JS de Bootstrap.
// Enlaces provisionales: aun no existen esas rutas.
const links = [
  { href: '/', label: 'Menu' },
  { href: '/mi-pedido', label: 'Mi pedido' },
  { href: '/pedidos', label: 'Mis pedidos' },
  { href: '/ubicaciones', label: 'Ubicaciones' },
  { href: '/ayuda', label: 'Ayuda' },
];
---

<div
  class="offcanvas offcanvas-start"
  tabindex="-1"
  id="menuDrawer"
  aria-labelledby="menuDrawerLabel"
>
  <div class="offcanvas-header">
    <h2 class="offcanvas-title h6 mb-0" id="menuDrawerLabel">Shop Superfoods</h2>
    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="offcanvas"
      aria-label="Cerrar"></button>
  </div>

  <div class="offcanvas-body">
    <ul class="list-unstyled d-flex flex-column gap-4 m-0">
      {
        links.map((link) => (
          <li>
            <a class="text-body" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
