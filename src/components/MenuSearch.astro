---
import Icon from './Icon.astro';

// El buscador de la portada. SOLO DESKTOP: va en la fila de la barra de pedido, a la
// izquierda del switch (ver components/OrderBar.astro).
//
// Busca en los platillos que ya estan en la pagina —no pide nada a la API— y, mientras
// hay texto, la portada cambia sus secciones por una sola lista de resultados. Todo eso
// lo hace src/scripts/menu-search.ts.
//
// La pista del atajo no es un boton aparte: va dentro de la etiqueta, asi que pulsarla
// lleva al campo como pulsar cualquier otra parte de la caja. El atajo funciona con ⌘K y
// con Ctrl+K; el rotulo es el del diseno.
---

<label class="menu-search">
  <Icon name="search" class="menu-search__icon" />

  <input
    class="menu-search__input"
    type="search"
    placeholder="Buscar en el menú"
    aria-label="Buscar en el menú"
    aria-keyshortcuts="Meta+K Control+K"
    autocomplete="off"
    enterkeyhint="search"
    data-menu-search
  />

  <kbd class="menu-search__shortcut" aria-hidden="true">⌘K</kbd>
</label>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: menu-search
     ---------------------------------------------------------------------------
     Spec: height 44 - radius 12 - fondo #FFFFFF
           lupa 20x20 · texto Inter 600 14/20 #98A2B3 · atajo a 8 del borde:
           40x28, padding 4/8, radius 7, fondo #F8F9FB, Inter 600 14/20 #6C757D

     El ancho no es fijo: ocupa lo que deja el switch en la fila.
     --------------------------------------------------------------------------- */
  .menu-search {
    display: none;
  }

  @media (min-width: 768px) {
    .menu-search {
      display: flex;
      flex: 1 1 auto;
      align-items: center;
      gap: 8px;
      min-width: 0;
      height: 44px;
      padding: 0 8px 0 16px;
      border-radius: 12px;
      background-color: var(--sf-white);
      color: var(--sf-subtle);
      cursor: text;
      transition: box-shadow 160ms ease;
    }
    /* El aro de foco va en la caja y no en el campo, que no tiene borde propio: es la
       caja entera la que se ve como buscador. */
    .menu-search:focus-within {
      box-shadow: 0 0 0 2px var(--sf-accent);
    }

    .menu-search__icon {
      flex: 0 0 auto;
    }

    .menu-search__input {
      flex: 1 1 auto;
      min-width: 0;
      height: 100%;
      padding: 0;
      border: 0;
      background: none;
      font-size: 14px;
      font-weight: 600;
      line-height: 20px;
      color: var(--sf-ink);
      outline: none;
    }
    .menu-search__input::placeholder {
      color: var(--sf-subtle);
      opacity: 1;
    }

    .menu-search__shortcut {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
      min-width: 40px;
      height: 28px;
      padding: 4px 8px;
      border-radius: 7px;
      background-color: var(--sf-body-bg);
      /* <kbd> trae del Reboot su propia fuente, monoespaciada, y su propio fondo. */
      font-family: inherit;
      font-size: 14px;
      font-weight: 600;
      line-height: 20px;
      color: var(--sf-muted);
      box-shadow: none;
    }
  }
</style>
