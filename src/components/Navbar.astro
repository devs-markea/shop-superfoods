---
import BrandLogo from './BrandLogo.astro';
import Icon from './Icon.astro';
import NavbarDesktop from './NavbarDesktop.astro';
import ScheduleSheet from './ScheduleSheet.astro';
import LocationSheet from './LocationSheet.astro';
import type { StoreSchedule, StoreSettings } from '../lib/store-config.ts';
import type { DeliveryType } from '../lib/checkout.ts';
import { shiftLabel } from '../lib/schedule.ts';

interface Props {
  store: StoreSettings;
  schedule: StoreSchedule | null;
  /** Modo de entrega ya elegido. Decide cual de los dos plazos lee la barra de desktop. */
  selected?: DeliveryType;
  /** Total del carrito de la sesion. Solo lo pinta la barra de desktop. */
  cartTotal?: number;
  /** Unidades en el carrito. Idem: la etiqueta sobre el icono es de desktop. */
  cartCount?: number;
}

const { store, schedule, selected, cartTotal = 0, cartCount = 0 } = Astro.props;

// La cabecera del listado son DOS barras, no una barra que se adapta: en movil
// manda .navbar —logo y iconos— y de md hacia arriba la releva .navbar-desktop,
// con las metas de la tienda y el carrito. Los elementos no coinciden en casi
// nada, asi que cada una es su propio bloque y el breakpoint decide cual se ve
// (ver los estilos de este archivo).
//
// Barra de movil: logo (izq) - iconos (der). El logo abre a la izquierda, a la
// misma sangria que el switch de la barra de abajo: ya no hay hamburguesa que lo
// empuje al centro.
//
// Los iconos existen solo si tienen algo que ensenar: un icono que abre una hoja
// vacia es peor que un icono que no esta. Quien decide es el dato, no la
// pantalla.
const message = store.location?.message;
const address = store.location?.address;
const mapsUrl = store.location?.mapsUrl;

// Ubicacion: basta con uno de los dos para que la hoja exista. Con direccion se
// lee, con enlace se abre. La abreviada no cuenta aqui —no es contenido de la
// hoja, que muestra la completa— y por eso una tienda que solo la tenga se queda
// sin pin en las dos barras: no hay nada que abrir.
//
// El mensaje tampoco cuenta. Es como presenta el negocio su ubicacion, no la
// ubicacion, y lo lee SOLO la hoja: aqui no se hace con el mas que pasarselo.
const hasLocation = Boolean(address || mapsUrl);

// Horario: hace falta algo que ensenar. Sin horario predeterminado —o con uno sin
// turnos— la API devuelve `isOpen: null` y `days` vacio, y entonces el reloj no
// abriria mas que una hoja en blanco.
const hasSchedule = Boolean(schedule && schedule.days.length > 0);
---

<header class="navbar">
  <div class="navbar__inner">
    <a class="navbar__brand" href="/mamayaya">
      <BrandLogo class="navbar__logo" />
    </a>

    <div class="navbar__actions">
      {
        hasSchedule && (
          <button
            class="navbar__action btn-plain"
            type="button"
            aria-label="Horario de la tienda"
            aria-haspopup="dialog"
            data-sheet="sheet-schedule"
          >
            <Icon name="clock" class="navbar__icon" />
          </button>
        )
      }

      {
        hasLocation && (
          <button
            class="navbar__action btn-plain"
            type="button"
            aria-label="Ubicacion de la tienda"
            aria-haspopup="dialog"
            data-sheet="sheet-location"
          >
            <Icon name="map-pin" class="navbar__icon" />
          </button>
        )
      }

      {/* Compartir no se pinta: sigue pendiente del dominio real (`publicUrl`),
          y un icono que no comparte nada no gana su sitio en la barra. */}
    </div>
  </div>
</header>

{/* Las dos condiciones viajan a la barra de desktop porque alli deciden lo mismo
    que aqui: si el pin y el reloj se pintan. Las calcula esta
    cabecera, que es tambien quien monta las hojas: si las dedujera cada barra por
    su cuenta, una podria ofrecer un boton para una hoja que la otra no montó. */}
<NavbarDesktop
  hasLocation={hasLocation}
  hasSchedule={hasSchedule}
  shift={schedule ? shiftLabel(schedule) : null}
  estimate={store.delivery?.estimate}
  pickup={store.pickup?.estimate}
  selected={selected}
  cartTotal={cartTotal}
  cartCount={cartCount}
/>

{/* Las dos hojas las monta esta cabecera para las dos barras y para la barra de
    pedido, que abre la ubicacion desde su "Ver mapa". */}
{hasSchedule && schedule && <ScheduleSheet schedule={schedule} />}
{hasLocation && <LocationSheet message={message} address={address} mapsUrl={mapsUrl} />}

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: navbar  (sobre .navbar de Bootstrap)
     ---------------------------------------------------------------------------
     La barra de MOVIL. 2 zonas: logo (izq) - iconos (der)
     Spec mobile: height 92 - padding 12/20 - space-between
     La fila mide 24 y queda centrada en los 92: el aire de arriba y abajo es de la
     barra, no del relleno. La barra de pedido se ancla por detras de esta, a 32
     (components/OrderBar.astro): cuanto asoma de ella al bajar depende de este
     alto.

     Se usa .navbar de Bootstrap por el sticky y el fondo; el reparto es propio.

     De md hacia arriba esta barra desaparece y la releva .navbar-desktop, que no
     es una variante de esta sino otro bloque: otros elementos y otro reparto. Ver
     components/NavbarDesktop.astro.
     --------------------------------------------------------------------------- */
  /* El fondo es el de la pagina, no una superficie blanca: en movil la barra no
     es una tarjeta sobre el fondo sino la continuacion de el, y lo que se recorta
     contra el gris son las tarjetas de platillo, que si son superficie.

     Opaco y no transparente aunque el color sea el mismo: la barra es sticky y el
     catalogo le pasa por debajo. Con un fondo transparente se leerian las tarjetas
     a traves del logo. La excepcion es arriba del todo sobre el banner, mas
     abajo. */
  .navbar {
    position: sticky;
    top: 0;
    z-index: 1020;
    min-height: 92px;
    /* El 20 es el gutter de la pagina en movil. Esta barra no existe de md en
       adelante —la releva .navbar-desktop— asi que nunca ve el de 32. */
    padding: 12px 20px;
    background-color: var(--sf-body-bg);
    transition: background-color 200ms ease;
  }

  /* Sobre el banner — la portada con banner (components/Hero.astro) lo sube por
     detras de esta barra, y mientras la pagina esta arriba del todo la barra es
     transparente: logo e iconos van sobre la foto. En cuanto la pagina baja,
     src/scripts/navbar-scroll.ts pone --scrolled y vuelve el fondo.

     Lo decide el :has() y no una clase puesta por la pagina porque el banner se
     pinta o no segun lo que mande el panel: sin banner no hay nada debajo y la
     barra lleva su fondo desde el principio. Y transparente es el punto de partida,
     sin esperar al script: es lo que toca en casi toda carga, que empieza arriba.

     Los iconos pasan a blanco, dentro de un circulo oscuro: el gris de siempre se
     pierde sobre la foto, y el circulo los sostiene tambien sobre una foto clara o
     sin velo. Spec: 32x32 - radius 26 - padding 4 - fondo #00000099.

     Y el logo no se pinta: vuelve con el fondo. Con visibility y no solo con
     opacity, para que el enlace invisible no reciba ni el toque ni el foco; y no
     con display, para que conserve su sitio y los iconos no se muevan. */
  .page:has(.hero) .navbar:not(.navbar--scrolled) {
    background-color: transparent;
  }
  .page:has(.hero) .navbar:not(.navbar--scrolled) .navbar__action {
    color: var(--sf-white);
    background-color: rgba(0, 0, 0, 0.6);
  }
  .page:has(.hero) .navbar:not(.navbar--scrolled) .navbar__brand {
    visibility: hidden;
    opacity: 0;
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    max-width: 1140px;
    height: 24px;
    margin-inline: auto;
  }

  /* Element: navbar__actions — los iconos de la derecha */
  .navbar__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* Element: navbar__action — area tactil 32x32, redonda, con icono de 20.

     Mide 32 en los dos estados aunque el circulo solo se pinte sobre el banner:
     si encogiera a 24 al volver el fondo de la barra, los iconos saltarian de sitio
     a media bajada. Es mas alta que los 24 de la fila y la desborda 4 por arriba
     y 4 por abajo, sobre el aire de la barra, como el logo.

     El padding 4 del spec no se declara: .btn-plain lo pone a 0 con la misma
     especificidad, y el centrado del flex deja el icono donde lo dejaria. */
  .navbar__action {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--sf-muted);
    border-radius: 26px;
    transition:
      opacity 160ms ease,
      color 200ms ease,
      background-color 200ms ease;
  }
  .navbar__action:hover {
    opacity: 0.7;
  }
  .navbar__action:active {
    opacity: 0.5;
  }

  /* Element: navbar__icon — 20x20, tanto los SVG de img/ como los inline */
  .navbar__icon {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
  }

  /* Element: navbar__brand */
  .navbar__brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    height: 24px;
    margin: 0;
    padding: 0;
    transition:
      opacity 160ms ease,
      visibility 160ms ease;
  }
  .navbar__brand:hover {
    opacity: 0.8;
  }

  /* Element: navbar__logo — 40 de alto, el ancho lo da la proporcion del archivo.
     Mas alto que los 24 de la fila, a proposito: es un emblema cuadrado con el
     nombre dentro, y a 24 no se leeria. El enlace que lo envuelve conserva los 24
     y lo centra, asi que desborda 8 por arriba y 8 por abajo sobre el aire de la
     barra y su alto no se mueve. */
  .navbar__logo {
    width: auto;
    height: 40px;
  }

  /* --- Desktop -------------------------------------------------------------
     Releva .navbar-desktop. Se apaga con display y no con una utilidad en el
     marcado para que el bloque siga decidiendo donde vive. */
  @media (min-width: 768px) {
    .navbar {
      display: none;
    }
  }
</style>
