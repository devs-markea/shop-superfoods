---
import Icon, { type IconName } from './Icon.astro';
import BrandLogo from './BrandLogo.astro';
import { formatPrice } from '../lib/price.ts';
import { cartChipLabel } from '../lib/cart-view.ts';
import type { DeliveryType } from '../lib/checkout.ts';

interface Props {
  /** Si la cabecera monto la hoja de ubicacion. Sin ella no hay nada que abrir. */
  hasLocation?: boolean;
  /** Si la cabecera monto la hoja del horario. Idem. */
  hasSchedule?: boolean;
  /** El turno en curso ya redactado (ver shiftLabel en src/lib/schedule.ts). */
  shift?: string | null;
  /** Estimado a domicilio. Sin el, no se promete un tiempo. */
  estimate?: string;
  /** Estimado para recoger. Es otra promesa: no se sustituye por la de arriba. */
  pickup?: string;
  /**
   * Modo de entrega ya elegido, que la pagina saca del borrador —o del pedido,
   * donde ya lo hay—. Decide cual de los dos plazos se lee en las pantallas sin
   * switch; donde lo hay, manda el (ver los estilos de este archivo).
   */
  selected?: DeliveryType;
  /** Total del carrito de la sesion. */
  cartTotal: number;
  /** Unidades en el carrito. En 0 el chip va sin etiqueta. */
  cartCount: number;
}

const {
  hasLocation,
  hasSchedule,
  shift,
  estimate,
  pickup,
  selected = 'delivery',
  cartTotal,
  cartCount,
} = Astro.props;

// Barra de desktop. Dos elementos: logo - tienda y carrito.
//
// No es una variante de .navbar: son otros elementos, otro reparto y otro alto,
// asi que es otro bloque. La monta <Navbar>, que es quien decide cual de las dos
// se ve segun el breakpoint.
//
// En medio iban los rotulos de seccion —"Menu" y "Mi pedido"—, que marcaban en
// que pantalla estabas sin llevar a ninguna parte. Se retiraron: el reparto vuelve
// a ser logo a un lado y tienda al otro.

// Las metas de la tienda que abren algo: pin y reloj, cada uno con su rotulo.
//
// Abren las MISMAS hojas que los iconos de la barra de movil —las monta <Navbar>
// una sola vez para las dos—, asi que aqui no hay JavaScript nuevo: basta el
// `data-sheet` que ya escucha src/scripts/sheet.ts.
//
// Los dos solo existen con su hoja: sin nada que abrir, un boton que no funciona
// es peor que no ofrecerlo.
interface Meta {
  icon: IconName;
  /** Lo que se lee. */
  label: string;
  /** La hoja que abre. */
  sheet: string;
  /**
   * Que abre, cuando el rotulo no lo dice. Va en el nombre accesible del boton,
   * detras del rotulo; sin el, el nombre es el rotulo.
   */
  name?: string;
  /** El rotulo es un dato de largo variable: cede el ancho que falte y se recorta. */
  truncate?: boolean;
}

const metas: Meta[] = [];

// El pin rotula lo que abre —"Ubicación", fijo— y no la direccion. Llevaba la
// abreviada y se retiro de la barra: aqui la direccion se lee en la hoja, que
// muestra la completa. La abreviada sigue en las metas de la barra de pedido, en
// movil (ver components/OrderMeta.astro).
//
// Sin direccion ni enlace no hay hoja, y entonces tampoco pin, tenga o no
// abreviada la tienda.
if (hasLocation) {
  metas.push({
    icon: 'map-pin',
    label: 'Ubicación',
    sheet: 'sheet-location',
  });
}

// El reloj rotula el turno en curso —"12:00 p.m. - 11:00 p.m.", o cuando vuelve a
// abrir—, que es lo que iba bajo el encabezado de la columna lateral de la portada
// y se mudo aqui: en la barra se lee en todas las pantallas, y al lado del boton
// que abre la semana entera.
//
// El turno no dice que abre el boton, asi que eso va en su nombre accesible. Sin
// turno que rotular —abierta, pero la API no publica ni el tramo ni el cierre—
// queda "Horarios", que si lo dice.
//
// Sin turnos no hay hoja, y entonces tampoco reloj.
if (hasSchedule) {
  metas.push({
    icon: 'clock',
    label: shift || 'Horarios',
    sheet: 'sheet-schedule',
    name: shift ? 'Horarios' : undefined,
    truncate: true,
  });
}

// El plazo, al lado del horario: cuanto tarda el pedido, segun como se reciba. Son
// dos promesas distintas y cada una lleva su icono —la moto, la de domicilio; el
// local, la de recoger—, porque el dato solo ("25-35 min") no dice de cual habla.
//
// Las dos se sirven en el marcado y se lee una: la del modo de entrega elegido. Es
// el mismo relevo de las metas de la barra de pedido en movil, y lo hace CSS (ver
// los estilos de este archivo y components/OrderMeta.astro).
//
// Cada una es opcional por su cuenta, como alli: sin estimado configurado no se
// promete un tiempo, y ese modo se queda sin plazo en la barra.
//
// No abren nada: son texto, no botones.
interface Estimate {
  mode: DeliveryType;
  icon: IconName;
  /** Que promete el valor. No se pinta —lo dice el icono—: es para quien no lo ve. */
  name: string;
  value: string;
}

const estimates: Estimate[] = [];

if (estimate) {
  estimates.push({
    mode: 'delivery',
    icon: 'moto',
    name: 'Tiempo estimado de entrega',
    value: estimate,
  });
}

if (pickup) {
  estimates.push({
    mode: 'pickup',
    icon: 'store',
    name: 'Tiempo estimado de recolección',
    value: pickup,
  });
}

// El chip es la unica via al pedido que queda en la portada de desktop, asi que
// enlaza. El importe y las unidades vienen del carrito de la sesion, que pide la
// pagina: sin sesion abierta llegan en cero y la etiqueta se queda vacia.
//
// En /mamayaya/carrito los tres —importe, cifra y nombre accesible— los reescribe
// src/scripts/order-summary.ts en cada cambio de cantidad: es la unica pantalla
// donde el carrito se edita con la barra a la vista, y un chip que se queda en el
// importe anterior contradice a la tarjeta que tiene justo debajo.
const cartLabel = cartChipLabel(cartTotal, cartCount);
---

<header class="navbar-desktop">
  <div class="navbar-desktop__inner">
    <a class="navbar-desktop__brand" href="/mamayaya">
      <BrandLogo class="navbar-desktop__logo" />
    </a>

    {/* `data-delivery`: el modo con el que llega la pagina. Decide el plazo que se
        lee donde no hay switch que lo diga. */}
    <div class="navbar-desktop__store" data-delivery={selected}>
      {
        metas.map((meta) => (
          // El nombre accesible lleva el rotulo DELANTE, no en su lugar: quien
          // navega por voz pide el boton por lo que ve (el turno), y lo que hace
          // al pulsarlo no se lee en el rotulo. "Ubicación" si lo dice: el pin va
          // sin `name` y su nombre es el texto.
          <button
            class:list={[
              'navbar-desktop__meta',
              meta.truncate && 'navbar-desktop__meta--truncate',
              'btn-plain',
            ]}
            type="button"
            aria-label={
              // El turno puede acabar en "p.m.": ese punto ya cierra la frase.
              meta.name
                ? `${meta.label}${meta.label.endsWith('.') ? '' : '.'} ${meta.name}`
                : undefined
            }
            aria-haspopup="dialog"
            data-sheet={meta.sheet}
          >
            <Icon name={meta.icon} />

            <span
              class="navbar-desktop__meta-value"
              title={meta.truncate ? meta.label : undefined}
            >
              {meta.label}
            </span>
          </button>
        ))
      }

      {
        estimates.map((item) => (
          <span class="navbar-desktop__meta" data-mode={item.mode}>
            <Icon name={item.icon} />

            <span class="navbar-desktop__meta-value">
              <span class="visually-hidden">{item.name}: </span>
              {item.value}
            </span>
          </span>
        ))
      }

      <a class="navbar-desktop__cart" href="/mamayaya/carrito" aria-label={cartLabel} data-cart-chip>
        <span class="navbar-desktop__cart-total" data-cart-chip-total>
          {formatPrice(cartTotal)}
        </span>

        {/* Contexto de posicion del tamano exacto del icono: la etiqueta se
            cuelga de su esquina, no del chip. */}
        <span class="navbar-desktop__cart-icon">
          <Icon name="shopping-cart" class="navbar-desktop__cart-glyph" />

          {/* La cifra se pinta siempre y se esconde con `hidden` en lugar de no
              existir: en /mamayaya/carrito el chip se actualiza sin recargar, y una
              etiqueta que hay que crear desde el script es marcado dibujado dos
              veces. Vacio el pedido, `hidden` la retira igual que antes. */}
          <span
            class="navbar-desktop__cart-count"
            aria-hidden="true"
            hidden={cartCount <= 0}
            data-cart-chip-count
          >
            {cartCount}
          </span>
        </span>
      </a>
    </div>
  </div>
</header>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: navbar-desktop
     ---------------------------------------------------------------------------
     La barra de DESKTOP: logo - tienda y carrito.
     Spec: space-between - padding 16/160 - borde inferior de 1

     En medio iban los rotulos de seccion ("Menu" y "Mi pedido"), retirados del
     marcado: con dos elementos el space-between los manda a los dos extremos, que
     es el mismo reparto de antes sin el grupo del centro.

     Bloque propio y no un modificador de .navbar: coinciden en el logo y en nada
     mas. Solo una de las dos se ve, y el breakpoint md es la frontera.

     Los 160 de sangria de la spec son un MAXIMO, no una medida fija: son
     (1440 - 1120) / 2 del lienzo, y por debajo el clamp cae al gutter de la
     pagina —escribirlos fijos dejaria 448 de contenido en una pantalla de 768—.
     El contenido se para en 1140 para no separarse de la rejilla de platillos.
     La misma sangria la usa el pie, que es la otra pieza a ancho completo.
     --------------------------------------------------------------------------- */
  .navbar-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .navbar-desktop {
      position: sticky;
      top: 0;
      z-index: 1020;
      display: block;
      padding-block: 16px;
      padding-inline: clamp(32px, calc((100% - 1120px) / 2), 160px);
      background-color: var(--sf-white);
      border-bottom: 1px solid var(--sf-border);
    }
    .navbar-desktop__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      width: 100%;
      max-width: 1140px;
      margin-inline: auto;
    }
    /* Element: brand y logo — el enlace mide 28 de alto, el mismo que el carrito,
       que es el elemento mas alto de la fila. Con el padding de 16 la barra mide 60.

       El logo mide 44: es un emblema cuadrado con el nombre dentro, y a 28 no se
       leeria. El enlace lo centra en sus 28, asi que desborda 8 por arriba y 8 por
       abajo sobre el padding y la barra sigue midiendo 60. */
    .navbar-desktop__brand {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      height: 28px;
      transition: opacity 160ms ease;
    }
    .navbar-desktop__brand:hover {
      opacity: 0.8;
    }
    .navbar-desktop__logo {
      width: auto;
      height: 44px;
    }
    /* Element: store — las metas de la tienda y el carrito */
    .navbar-desktop__store {
      display: flex;
      align-items: center;
      gap: 20px;
      min-width: 0;
    }
    /* El icono no lleva clase propia: el tamano lo da .icon y el color lo hereda de
       aqui con currentColor, que es justo lo que hace falta para que el hover del
       boton se lo lleve tambien. */
    .navbar-desktop__meta {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 400;
      line-height: 1;
      color: var(--sf-slate);
      white-space: nowrap;
    }
    /* El pin y el reloj abren las mismas hojas que en movil, asi que son <button>;
       el plazo no abre nada y se queda en texto. Se distingue por la etiqueta y no
       por un modificador: la diferencia ya la lleva el marcado, y una clase mas solo
       podria contradecirlo.

       No se atenua con opacity como los iconos de la barra de movil: ahi el boton es
       solo un icono y aqui lleva texto, que en gris al 70% se lee peor. */
    button.navbar-desktop__meta {
      transition: color 160ms ease;
    }
    button.navbar-desktop__meta:hover {
      color: var(--sf-accent);
    }
    /* Modifier: el rotulo es un dato de largo variable —el turno, que cerrada dice
       tambien cuando abre: "Cerrado · Abre el miercoles a las 9:00 a.m."—. Es la
       unica meta que cede ancho: se recorta antes de empujar al carrito, y el texto
       entero queda en el `title`. El `min-width: 0` es lo que deja encoger a un hijo
       flex por debajo de su texto.

       El interlineado sube a 20, el alto del icono: con el 1 del resto, el
       `overflow: hidden` le cortaria el rabo a la "p" de "p.m.". La fila no crece. */
    .navbar-desktop__meta--truncate {
      flex: 0 1 auto;
      min-width: 0;
    }
    .navbar-desktop__meta--truncate .navbar-desktop__meta-value {
      overflow: hidden;
      line-height: 20px;
      text-overflow: ellipsis;
    }

    /* --- Relevo por modo de entrega -------------------------------------------
       El plazo son dos metas en el mismo sitio —la de domicilio y la de recoger— y
       se lee una. Las dos estan en el marcado, como en la barra de pedido de movil
       (ver components/OrderMeta.astro) y por lo mismo: el relevo no espera a ningun
       JavaScript.

       Sin switch en la pantalla manda el modo con el que llega la pagina, que el
       servidor deja escrito en el grupo. */
    .navbar-desktop__meta[data-mode] {
      display: none;
    }
    .navbar-desktop__store[data-delivery=delivery] [data-mode=delivery],
    .navbar-desktop__store[data-delivery=pickup] [data-mode=pickup] {
      display: inline-flex;
    }
    /* Con switch —la portada y /mamayaya/datos— manda el radio marcado, que es el
       estado de verdad: se mueve al elegir y cuando src/lib/delivery-switch.ts
       repone el borrador, y el plazo lo sigue sin que nadie se lo copie.

       Se lee desde .page, el <body>: la barra y el switch no comparten otro
       ancestro. Sin :has() se queda el modo del servidor, que al cargar es el mismo. */
    .page:has([name=delivery][value=domicilio]:checked) .navbar-desktop__meta[data-mode=pickup],
    .page:has([name=delivery][value=recoger]:checked) .navbar-desktop__meta[data-mode=delivery] {
      display: none;
    }
    .page:has([name=delivery][value=domicilio]:checked) .navbar-desktop__meta[data-mode=delivery],
    .page:has([name=delivery][value=recoger]:checked) .navbar-desktop__meta[data-mode=pickup] {
      display: inline-flex;
    }
    /* Element: cart — chip dorado con importe, icono y cantidad */
    .navbar-desktop__cart {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      color: var(--sf-accent);
      background-color: var(--sf-accent-tint);
      border-radius: 20px;
      transition: background-color 160ms ease;
    }
    .navbar-desktop__cart:hover {
      background-color: var(--sf-accent-edge);
      color: var(--sf-accent);
    }
    .navbar-desktop__cart-total {
      font-size: 14px;
      font-weight: 600;
      line-height: 1;
    }
    /* Contexto de posicion del tamano exacto del icono: la etiqueta se cuelga de
       su esquina y no del chip, que es mas ancho por el importe. */
    .navbar-desktop__cart-icon {
      position: relative;
      display: inline-flex;
      flex: 0 0 auto;
    }
    /* 28x28: el unico tamano del sistema que no sale de los tres de .icon, y por
       eso se pide aqui en lugar de abrir un modificador para un solo uso. */
    .navbar-desktop__cart-glyph {
      width: 28px;
      height: 28px;
    }
    /* La cantidad, colgada de la esquina superior derecha del icono. Los negativos
       caben en el padding del chip: no se sale de la pastilla. */
    .navbar-desktop__cart-count {
      position: absolute;
      top: -2px;
      right: -8px;
      padding: 2px 6px;
      font-size: 11px;
      font-weight: 700;
      line-height: 1;
      color: var(--sf-white);
      background-color: var(--sf-accent);
      border-radius: 10px;
    }
  }
</style>
