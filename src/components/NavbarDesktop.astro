---
import Icon, { type IconName } from './Icon.astro';
import BrandLogo from './BrandLogo.astro';
import { formatPrice } from '../lib/price.ts';
import { cartChipLabel } from '../lib/cart-view.ts';

interface Props {
  /**
   * La direccion ABREVIADA. Es la que cabe en una barra, y la unica que se rotula
   * aqui: la completa es del modal. Sin ella el pin rotula la accion, no el dato.
   */
  shortAddress?: string;
  /** Plazo a domicilio configurado. Sin el, no se promete un tiempo. */
  estimate?: string;
  /** Si la cabecera monto la hoja de ubicacion. Sin ella no hay nada que abrir. */
  hasLocation?: boolean;
  /** Si la cabecera monto la hoja del horario. Idem. */
  hasSchedule?: boolean;
  /** Total del carrito de la sesion. */
  cartTotal: number;
  /** Unidades en el carrito. En 0 el chip va sin etiqueta. */
  cartCount: number;
}

const {
  shortAddress,
  estimate,
  hasLocation,
  hasSchedule,
  cartTotal,
  cartCount,
} = Astro.props;

// Barra de desktop. Dos elementos: logo - tienda y carrito.
//
// No es una variante de .navbar: son otros elementos, otro reparto y otro alto,
// asi que es otro bloque. La monta <Navbar>, que es quien decide cual de las dos
// se ve segun el breakpoint.
//
// En medio iban los rotulos de seccion —"Menu" y "Mi pedido"—, que marcaban en
// que pantalla estabas sin llevar a ninguna parte. Se retiraron: el reparto vuelve
// a ser logo a un lado y tienda al otro.

// Las metas de la tienda: pin y reloj, cada uno con su rotulo.
//
// Abren las MISMAS hojas que los iconos de la barra de movil —las monta <Navbar>
// una sola vez para las dos—, asi que aqui no hay JavaScript nuevo: basta el
// `data-sheet` que ya escucha src/scripts/sheet.ts.
//
// Con hoja el rotulo es un boton; sin hoja se queda en texto, porque un boton que
// no abre nada es peor que un dato quieto. Los dos casos existen: se puede tener
// plazo de envio configurado y ningun turno de horario.
//
// El plazo no depende del switch de la barra de abajo: se lee directo de la
// configuracion. En movil los dos plazos se turnan —domicilio y recoger— porque
// comparten sitio con el switch que los elige; esta barra no tiene switch, asi
// que afirma uno solo y es el de domicilio.
interface Meta {
  icon: IconName;
  /** Lo que se lee. */
  label: string;
  /** La hoja que abre. `null` deja el rotulo en texto. */
  sheet: string | null;
  /** Que es. Va en el nombre accesible del boton, detras del rotulo. */
  name: string;
  /** Cinturon: la abreviada admite hasta 60 caracteres y la barra no da tantos. */
  truncate: boolean;
}

const metas: Meta[] = [];

// El pin rotula la direccion ABREVIADA y nunca la completa. No es que no quepa:
// es que no es la misma cosa. Recortar la larga por caracteres deja fuera justo lo
// que ubica el local —la colonia, la referencia— y lo que sobrevive no dice a
// donde ir; cual es el trozo que identifica la tienda lo decide el negocio, y por
// eso viaja aparte. Sin abreviada no hay direccion en la barra: se rotula la
// accion —el mismo "Ver mapa" de las metas de la barra de pedido— y no un recorte
// de la otra.
//
// Los dos datos son independientes, asi que se dan las cuatro combinaciones y cada
// una tiene su forma:
//
//   abreviada + hoja   boton con la direccion
//   solo abreviada     texto con la direccion: no hay hoja que abrir
//   solo hoja          boton "Ver mapa"
//   ninguna            no se pinta pin
if (shortAddress || hasLocation) {
  metas.push({
    icon: 'map-pin',
    label: shortAddress || 'Ver mapa',
    sheet: hasLocation ? 'sheet-location' : null,
    name: 'Ubicacion de la tienda',
    truncate: true,
  });
}

// El reloj se pinta si hay algo que decir —el plazo— o algo que abrir —el
// horario—. Sin plazo pero con turnos, rotula el horario, que es lo que abre.
if (estimate || hasSchedule) {
  metas.push({
    icon: 'clock',
    label: estimate || 'Horario',
    sheet: hasSchedule ? 'sheet-schedule' : null,
    name: 'Horario de la tienda',
    truncate: false,
  });
}

// El chip es la unica via al pedido que queda en la portada de desktop, asi que
// enlaza. El importe y las unidades vienen del carrito de la sesion, que pide la
// pagina: sin sesion abierta llegan en cero y la etiqueta se queda vacia.
//
// En /carrito los tres —importe, cifra y nombre accesible— los reescribe
// src/scripts/order-summary.ts en cada cambio de cantidad: es la unica pantalla
// donde el carrito se edita con la barra a la vista, y un chip que se queda en el
// importe anterior contradice a la tarjeta que tiene justo debajo.
const cartLabel = cartChipLabel(cartTotal, cartCount);
---

<header class="navbar-desktop">
  <div class="navbar-desktop__inner">
    <a class="navbar-desktop__brand" href="/">
      <BrandLogo class="navbar-desktop__logo" />
    </a>

    <div class="navbar-desktop__store">
      {
        metas.map((meta) => {
          // Boton cuando hay hoja, texto cuando no: es la misma pieza con dos
          // envoltorios, asi que se elige la etiqueta y el contenido se escribe
          // una vez.
          const Wrapper = meta.sheet ? 'button' : 'span';

          // El nombre accesible lleva el rotulo DELANTE, no en su lugar: quien
          // navega por voz pide el boton por lo que ve ("25-35 min"), y lo que
          // hace al pulsarlo no se lee en el rotulo.
          const opener = meta.sheet
            ? {
                type: 'button' as const,
                'aria-label': `${meta.label}. ${meta.name}`,
                'aria-haspopup': 'dialog' as const,
                'data-sheet': meta.sheet,
              }
            : {};

          return (
            <Wrapper
              class:list={['navbar-desktop__meta', meta.sheet && 'btn-plain']}
              {...opener}
            >
              <Icon name={meta.icon} />

              <span
                class:list={[
                  'navbar-desktop__meta-value',
                  meta.truncate && 'navbar-desktop__meta-value--truncate',
                ]}
                title={meta.truncate ? meta.label : undefined}
              >
                {meta.label}
              </span>
            </Wrapper>
          );
        })
      }

      <a class="navbar-desktop__cart" href="/carrito" aria-label={cartLabel} data-cart-chip>
        <span class="navbar-desktop__cart-total" data-cart-chip-total>
          {formatPrice(cartTotal)}
        </span>

        {/* Contexto de posicion del tamano exacto del icono: la etiqueta se
            cuelga de su esquina, no del chip. */}
        <span class="navbar-desktop__cart-icon">
          <Icon name="shopping-cart" class="navbar-desktop__cart-glyph" />

          {/* La cifra se pinta siempre y se esconde con `hidden` en lugar de no
              existir: en /carrito el chip se actualiza sin recargar, y una
              etiqueta que hay que crear desde el script es marcado dibujado dos
              veces. Vacio el pedido, `hidden` la retira igual que antes. */}
          <span
            class="navbar-desktop__cart-count"
            aria-hidden="true"
            hidden={cartCount <= 0}
            data-cart-chip-count
          >
            {cartCount}
          </span>
        </span>
      </a>
    </div>
  </div>
</header>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: navbar-desktop
     ---------------------------------------------------------------------------
     La barra de DESKTOP: logo - tienda y carrito.
     Spec: space-between - padding 16/160 - borde inferior de 1

     En medio iban los rotulos de seccion ("Menu" y "Mi pedido"), retirados del
     marcado: con dos elementos el space-between los manda a los dos extremos, que
     es el mismo reparto de antes sin el grupo del centro.

     Bloque propio y no un modificador de .navbar: coinciden en el logo y en nada
     mas. Solo una de las dos se ve, y el breakpoint md es la frontera.

     Los 160 de sangria de la spec son un MAXIMO, no una medida fija: son
     (1440 - 1120) / 2 del lienzo, y por debajo el clamp cae al gutter de la
     pagina —escribirlos fijos dejaria 448 de contenido en una pantalla de 768—.
     El contenido se para en 1140 para no separarse de la rejilla de platillos.
     La misma sangria la usa el pie, que es la otra pieza a ancho completo.
     --------------------------------------------------------------------------- */
  .navbar-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .navbar-desktop {
      position: sticky;
      top: 0;
      z-index: 1020;
      display: block;
      padding-block: 16px;
      padding-inline: clamp(32px, calc((100% - 1120px) / 2), 160px);
      background-color: var(--sf-white);
      border-bottom: 1px solid var(--sf-border);
    }
    .navbar-desktop__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      width: 100%;
      max-width: 1140px;
      margin-inline: auto;
    }
    /* Element: brand y logo — 28 de alto, el mismo que el carrito, que es el
       elemento mas alto de la fila. Con el padding de 16 la barra mide 60. */
    .navbar-desktop__brand {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      transition: opacity 160ms ease;
    }
    .navbar-desktop__brand:hover {
      opacity: 0.8;
    }
    .navbar-desktop__logo {
      width: auto;
      height: 28px;
    }
    /* Element: store — las metas de la tienda y el carrito */
    .navbar-desktop__store {
      display: flex;
      align-items: center;
      gap: 20px;
      min-width: 0;
    }
    /* El icono no lleva clase propia: el tamano lo da .icon y el color lo hereda de
       aqui con currentColor, que es justo lo que hace falta para que el hover del
       boton se lo lleve tambien. */
    .navbar-desktop__meta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
      font-size: 14px;
      font-weight: 400;
      line-height: 1;
      color: var(--sf-slate);
    }
    /* El pin y el reloj abren las mismas hojas que en movil, asi que cuando hay hoja
       el rotulo es un <button>. Se distingue por la etiqueta y no por un
       modificador: la diferencia ya la lleva el marcado, y una clase mas solo podria
       contradecirlo.

       No se atenua con opacity como los iconos de la barra de movil: ahi el boton es
       solo un icono y aqui lleva texto, que en gris al 70% se lee peor. */
    button.navbar-desktop__meta {
      transition: color 160ms ease;
    }
    button.navbar-desktop__meta:hover {
      color: var(--sf-gold);
    }
    /* El rotulo del pin es la direccion abreviada, que la API admite de hasta 60
       caracteres: mas de lo que da la barra. El tope corta antes de que empuje al
       carrito, y el `overflow: hidden` es tambien lo que deja al span encogerse por
       debajo de su texto —en un flex item la altura minima automatica pasa a 0—, asi
       que en una pantalla de md se acorta sola. El texto entero queda en el title. */
    .navbar-desktop__meta-value--truncate {
      max-width: 320px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    /* Element: cart — chip dorado con importe, icono y cantidad */
    .navbar-desktop__cart {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      color: var(--sf-gold);
      background-color: var(--sf-gold-tint);
      border-radius: 20px;
      transition: background-color 160ms ease;
    }
    .navbar-desktop__cart:hover {
      background-color: var(--sf-gold-edge);
      color: var(--sf-gold);
    }
    .navbar-desktop__cart-total {
      font-size: 14px;
      font-weight: 600;
      line-height: 1;
    }
    /* Contexto de posicion del tamano exacto del icono: la etiqueta se cuelga de
       su esquina y no del chip, que es mas ancho por el importe. */
    .navbar-desktop__cart-icon {
      position: relative;
      display: inline-flex;
      flex: 0 0 auto;
    }
    /* 28x28: el unico tamano del sistema que no sale de los tres de .icon, y por
       eso se pide aqui en lugar de abrir un modificador para un solo uso. */
    .navbar-desktop__cart-glyph {
      width: 28px;
      height: 28px;
    }
    /* La cantidad, colgada de la esquina superior derecha del icono. Los negativos
       caben en el padding del chip: no se sale de la pastilla. */
    .navbar-desktop__cart-count {
      position: absolute;
      top: -2px;
      right: -8px;
      padding: 2px 6px;
      font-size: 11px;
      font-weight: 700;
      line-height: 1;
      color: var(--sf-white);
      background-color: var(--sf-gold);
      border-radius: 10px;
    }
  }
</style>
