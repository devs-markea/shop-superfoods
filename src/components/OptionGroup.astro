---
import QuantityStepper from './QuantityStepper.astro';
import SectionLabel from './SectionLabel.astro';
import { formatPrice } from '../lib/price.ts';
import { VARIANT_FALLBACK_LABEL, type OptionGroupView } from '../lib/catalog.ts';
import {
  OPTIONAL_LABEL,
  isInert,
  ruleLabel,
  unitCap,
  type OptionRule,
} from '../lib/options.ts';

interface Props {
  group: OptionGroupView;
}

const { group } = Astro.props;
const labelId = `${group.id}-label`;
const errorId = `${group.id}-error`;

// Los tres controles comparten la misma estructura: lo unico que cambia son los
// valores, y de ellos sale todo lo demas. min y max cuentan unidades DEL GRUPO
// en los tres —en radio y checkbox una casilla marcada es una unidad, asi que
// alli da el mismo numero de siempre—; maxPerOption cuenta unidades de UNA
// opcion y solo existe en `quantity`, donde convive con los otros dos.
const rule: OptionRule = {
  control: group.control,
  min: group.min,
  max: group.max,
  maxPerOption: group.maxPerOption,
};

// max: 0 significa grupo que no admite ninguna opcion. Se dibuja, pero en solo
// lectura: cualquier cosa que se enviara de el la rechaza el carrito.
const inert = isInert(rule);

// La etiqueta de una opcion son dos cosas pegadas: el NOMBRE y, detras, lo que
// cuesta. Se escriben por separado —no una cadena sola, como antes— porque en
// desktop el nombre lleva su propia tipografia y necesita un elemento donde
// colgarla (ver los estilos de este archivo). El texto que sale es el mismo.
//
// El nombre solo cae al rotulo de respaldo en las variantes: una variante sin
// nombre sigue siendo elegible y hay que poder senalarla, mientras que las
// personalizaciones llegan siempre con el suyo.
function choiceName(label: string): string {
  return group.kind === 'variant' ? label || VARIANT_FALLBACK_LABEL : label;
}

// Variante: el precio ES el precio del platillo, sustituye a las otras, se
// escribe sin signo y se muestra aunque valga 0.
// Opcion: el precio es un sobrecoste que se suma, lleva `+` y con 0 no se
// dibuja nada. La asimetria es deliberada, no un olvido.
//
// El espacio de delante es del separador, no del marcado: asi da igual como
// quede sangrada la plantilla.
function choicePrice(price: number): string {
  if (group.kind === 'variant') {
    return ` — ${formatPrice(price)}`;
  }
  return price > 0 ? ` + ${formatPrice(price)}` : '';
}

// El precio que CUENTA para el total: el descontado cuando la promocion alcanza
// a esa variante. El de lista se sigue pintando, tachado a su izquierda. En las
// personalizaciones finalPrice es siempre null, asi que esto no las toca.
const effectivePrice = (choice: { price: number; finalPrice: number | null }) =>
  choice.finalPrice ?? choice.price;

// El tag del encabezado ya dice "Opcional": no se repite debajo.
const hint = ruleLabel(rule);
const showHint = hint !== OPTIONAL_LABEL;

// El control `quantity` no es un <input>, se dibuja con steppers. Los otros dos
// coinciden con el type del input.
const inputType = group.control === 'checkbox' ? 'checkbox' : 'radio';
---

<div
  class="option-group"
  role="group"
  aria-labelledby={labelId}
  data-option-group
  data-group-id={group.id}
  data-kind={group.kind}
  data-control={group.control}
  data-label={group.label}
  data-min={group.min}
  data-max={group.max ?? ''}
  data-max-per-option={group.maxPerOption ?? ''}
  data-inert={inert ? '' : undefined}
>
  <div class="option-group__header">
    <SectionLabel id={labelId}>{group.label}</SectionLabel>
    <span class:list={['tag', 'badge', group.required ? 'tag--required' : 'tag--optional']}>
      {group.required ? 'Obligatorio' : 'Opcional'}
    </span>
  </div>

  {showHint && <p class="option-group__hint">{hint}</p>}

  <div class="option-group__list">
    {
      group.control === 'quantity'
        ? group.choices.map((choice) => (
            // El techo del CONTADOR lo pone maxPerOption —unidades de esta
            // opcion—, acotado por max: una sola opcion tampoco puede pasar del
            // total del grupo. Sin ninguno de los dos queda el tope de forma de
            // la API, 99. Lo que este render no puede saber es cuanto han
            // gastado las demas, y de eso se encarga el script: al llegar el
            // grupo a max deshabilita el `+` de TODAS, tengan unidades o no.
            <div
              class="option option--quantity"
              data-choice
              data-option-id={choice.id}
              data-price={effectivePrice(choice)}
            >
              <span class="option__label">
                <span class="option__name">{choiceName(choice.label)}</span>{choicePrice(choice.price)}
              </span>

              {/* Lo rellena el script entre la segunda unidad y el techo de la
                  opcion: es el unico control donde el precio se multiplica, y
                  al llegar al tope se retira para no recargar la fila. */}
              <span class="option__amount" data-option-amount hidden />

              <QuantityStepper
                quantity={0}
                itemName={choice.label}
                min={0}
                max={unitCap(rule)}
                disabled={inert}
              />
            </div>
          ))
        : group.choices.map((choice) => {
            const id = `${group.id}-${choice.id}`;
            return (
              <label class="option" for={id}>
                <input
                  class="option__input form-check-input"
                  type={inputType}
                  name={group.name}
                  id={id}
                  value={choice.id}
                  checked={choice.checked}
                  disabled={inert}
                  data-choice
                  data-option-id={choice.id}
                  data-price={effectivePrice(choice)}
                />

                {/* La variante con descuento parte la etiqueta en tres: nombre,
                    precio de lista tachado y precio final. El resto —incluidas
                    las variantes que la promocion no alcanza— sigue siendo una
                    sola cadena. */}
                {choice.finalPrice === null ? (
                  <span class="option__label">
                    <span class="option__name">{choiceName(choice.label)}</span>{choicePrice(choice.price)}
                  </span>
                ) : (
                  <span class="option__label">
                    <span class="option__name">{choiceName(choice.label)}</span>
                    {' — '}
                    <s class="price-was">{formatPrice(choice.price)}</s>{' '}
                    <span class="option__price-final">{formatPrice(choice.finalPrice)}</span>
                  </span>
                )}
              </label>
            );
          })
    }
  </div>

  <!-- Nace vacio SIEMPRE: nada de lo que se sabe en el servidor justifica un
       aviso antes de que el comprador toque el grupo. Lo rellena
       src/scripts/order-form.ts, primero con los minimos que faltan y despues
       con lo que devuelva el 422, que la API nombra por grupo en
       `options.{personalizationId}`. El servidor revalida igualmente. -->
  <p class="option-group__error" id={errorId} role="alert" hidden data-group-error></p>
</div>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: option-group
     ---------------------------------------------------------------------------
     Bloque de opciones: encabezado (label + tag) y lista.
     Spec: grupo gap 16 - lista gap 12 - label Inter 600 12/16 #6C757D
     --------------------------------------------------------------------------- */
  .option-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .option-group__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  /* La etiqueta usa el bloque .section-label, compartido con el resto de grupos. */
  /* Element: hint — "Selecciona 2", "Hasta 3", cuando el grupo tiene min o max.
     El gap del bloque ya separa; el margen propio se anula. */
  .option-group__hint {
    margin: calc(16px * -1 + 4px) 0 0;
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    color: var(--sf-muted);
  }

  .option-group__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Element: error — validacion de min/max antes de enviar. Oculto por defecto
     con el atributo hidden, que el Reboot lleva a display: none. */
  .option-group__error {
    margin: calc(16px * -1 + 4px) 0 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    color: var(--sf-indigo);
  }

  /* ---------------------------------------------------------------------------
     Block: option  (sobre .form-check de Bootstrap)
     ---------------------------------------------------------------------------
     La maqueta ocultaba el control nativo y dibujaba la marca con un <span>.
     Con Bootstrap se usa el .form-check-input real: mismo aspecto, pero el
     control es visible para el navegador y las herramientas de accesibilidad.

     Spec: control 20x20 - borde 2px
     activo   #D5AA53 + label Inter 500 14/20 #141821
     inactivo #EAECF0 + label Inter 500 14/20 #6C757D

     El tamano, el borde y el color marcado vienen de .form-check-input, que
     ajusta styles/bootstrap-overrides.css; aqui solo el layout en fila y el estado del label.
     --------------------------------------------------------------------------- */
  .option {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    cursor: pointer;
  }

  .option__input {
    flex: 0 0 20px;
    height: 20px;
    margin: 0;
    float: none; /* .form-check-input flota cuando vive en un .form-check */
    cursor: pointer;
    transition: border-color 160ms ease;
  }

  .option__label {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--sf-muted);
    cursor: pointer;
    transition: color 160ms ease;
  }

  /* Element: name — el nombre de la opcion, dentro del label y delante de su
     importe. En movil no declara nada a proposito: ahi la etiqueta es una sola voz
     —Inter 500 14/20— y el nombre se lee igual que el precio que lo sigue. Existe
     por desktop, que si los separa (ver el final del archivo).

     Es el mismo elemento en los dos sitios donde se elige: el nombre de la
     variante y el de la personalizacion. */
  /* Modifier: control de cantidad. No hay casilla que marcar, asi que la fila
     es etiqueta a la izquierda y stepper a la derecha. Es la fila mas alta de
     las tres: el stepper mide 28 frente a los 20 del radio y del checkbox. */
  .option--quantity {
    justify-content: space-between;
    cursor: default;
  }
  .option--quantity .option__label {
    cursor: default;
  }

  /* Element: precio final de una variante con descuento. El de lista queda a su
     izquierda con .price-was, tachado. Va en dorado —el color del precio en el
     catalogo— para que se lea como el importe que cuenta, no como una segunda
     cifra al lado de otra. */
  .option__price-final {
    color: var(--sf-gold);
    font-weight: 600;
  }

  /* Element: importe — cantidad x precio de la opcion. Solo lo dibuja el control
     de cantidad, que es el unico donde el precio se multiplica por algo distinto
     de 0 o 1, y solo mientras la opcion pueda seguir creciendo: en el tope se
     oculta. El margen automatico lo pega al stepper. */
  .option__amount {
    margin-inline-start: auto;
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--sf-ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* --- Estados ------------------------------------------------------------- */
  .option__input:checked ~ .option__label {
    color: var(--sf-ink);
  }

  .option:hover .option__label {
    color: var(--sf-ink);
  }

  /* Una opcion con unidades pedidas se lee como elegida, igual que una marcada. */
  .option--quantity[data-selected] .option__label {
    color: var(--sf-ink);
  }

  /* El tope de unidades del grupo alcanzado: las casillas que quedan sin marcar
     ya no se pueden marcar. Bootstrap ya atenua el .form-check-input
     deshabilitado. */
  .option__input:disabled ~ .option__label {
    color: var(--sf-placeholder);
    cursor: not-allowed;
  }

  /* Tope de unidades del grupo alcanzado en un control de cantidad: esta opcion
     esta en 0 y ya no se puede abrir, porque el total esta repartido entre las
     demas. Mismo tratamiento que el checkbox deshabilitado porque significa lo
     mismo. Ojo: no se atenua una opcion CON unidades aunque su `+` este frenado
     —esa si esta elegida. */
  .option--quantity[data-blocked] .option__label {
    color: var(--sf-placeholder);
  }

  /* Grupo con max: 0 — no admite ninguna opcion, asi que se lee pero no se toca. */
  .option-group[data-inert] .option {
    cursor: default;
    opacity: 0.6;
  }

  /* --- Desktop -------------------------------------------------------------
     El nombre de la opcion sube a 15/15 y se lleva el estado de la fila: sin elegir
     es Inter 400 gris y elegida Inter 600 negra. En la columna de la derecha la
     lista es lo que se recorre para elegir, asi que la elegida se reconoce por su
     nombre y no solo por la casilla.

     El 15 va literal por lo mismo que el 32 del titulo: no esta en la escala de
     tamanos y es el unico rotulo de la tienda que lo pide. Los dos colores de la
     spec ya son tokens: #111827 es --sf-ink, el negro del resto de la ficha, y
     #4B5563 es --sf-slate, el mismo gris con el que se lee la descripcion.

     El importe que sigue al nombre no se toca: lo mueve el color del label, que es
     de donde hereda. */
  @media (min-width: 768px) {
    .option__name {
      font-size: 15px;
      font-weight: 400;
      line-height: 1;
      color: var(--sf-slate);
      transition: color 160ms ease;
    }
    /* Elegida: casilla marcada, o unidades pedidas, que en el control de cantidad
       significa lo mismo. */
    .option__input:checked ~ .option__label .option__name,
    .option--quantity[data-selected] .option__name {
      font-weight: 600;
      color: var(--sf-ink);
    }
    /* El raton adelanta el color, pero no el peso: engordar el nombre al pasar por
       encima le cambia el ancho a la fila y la lista temblaria al recorrerla. El
       peso se reserva para lo que de verdad se eligio. */
    .option:hover .option__name {
      color: var(--sf-ink);
    }
    /* Al final del bloque, y por eso: una opcion deshabilitada puede estar marcada
       —un grupo con max: 0 apaga sus casillas sin desmarcarlas—, asi que esta regla
       y la de "elegida" chocan con la misma especificidad y gana la ultima. El
       nombre de algo que no se puede elegir no debe leerse como elegido. */
    .option__input:disabled ~ .option__label .option__name,
    .option--quantity[data-blocked] .option__name {
      font-weight: 400;
      color: var(--sf-placeholder);
    }
  }

  /* Este bloque lo comparten <OptionGroup>, <ProductCard> y <PaymentOption>.
     Se repite en los tres, y no en un archivo comun, porque cada uno vive en
     una pantalla distinta —la ficha, la portada y el pago—: ninguna pagina
     carga mas de una copia. Si se cambia, hay que cambiarlo en los tres. */

  /* ---------------------------------------------------------------------------
     Block: tag  (sobre .badge de Bootstrap)
     ---------------------------------------------------------------------------
     Bootstrap aporta forma, padding y tipografia via .badge. Aqui solo quedan
     el alto de la spec y los dos esquemas de color.

     Spec: alto 24 - radius 32 - padding 4/8 - label Inter 600 12/16
     --required: bg #D5AA531A - color #4F46E5
     --optional: bg #EAECF0   - color #616673
     --------------------------------------------------------------------------- */
  .tag {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 8px;
    height: 24px;
    white-space: nowrap;
  }

  /* Modifier: obligatorio */
  .tag--required {
    background-color: var(--sf-gold-tint);
    color: var(--sf-indigo);
  }

  /* Modifier: opcional */
  .tag--optional {
    background-color: var(--sf-border);
    color: var(--sf-ink-soft);
  }

  /* Viene de la familia de promociones, que comparten la portada, la ficha, el
       pedido y el cierre. Cada consumidor lleva solo las piezas que pinta: en
       ninguna pantalla coinciden dos, asi que nadie carga la misma regla dos
       veces. Si se toca una, mirar quien mas la tiene. */

  /* Block: price-was — el precio de lista. Tachado, nunca subrayado: es la
     convencion universal y es lo que implementa la referencia del panel. */
  .price-was {
    color: var(--sf-muted);
    font-size: 12px;
    font-weight: 400;
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    white-space: nowrap;
  }
</style>
