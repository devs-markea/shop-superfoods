---
import DeliverySwitch from './DeliverySwitch.astro';
import OrderMeta from './OrderMeta.astro';
import CategoryNav from './CategoryNav.astro';
import type { DeliveryType } from '../lib/checkout.ts';

interface Props {
  categories: readonly string[];
  /** Estimado a domicilio configurado. */
  estimate?: string;
  /** Rotulo de envio ya resuelto por la pagina. */
  shipping?: string;
  /** Estimado para recoger configurado. */
  pickup?: string;
  /** Si hay ubicacion que ensenar: decide el boton "Ver mapa". */
  hasLocation?: boolean;
  /**
   * Modo de entrega ya elegido, que la pagina saca del borrador. Decide la marca
   * del switch y, con ella, cual de los dos pares de metas se lee: el relevo lo
   * hace CSS leyendo el radio marcado (ver components/OrderMeta.astro), asi que
   * la barra llega correcta sin esperar a ningun JavaScript.
   */
  selected?: DeliveryType;
}

const { categories, estimate, shipping, pickup, hasLocation, selected } = Astro.props;
---

<section class="order-bar" aria-label="Opciones de entrega">
  <div class="order-bar__inner">
    <DeliverySwitch selected={selected} />
    <OrderMeta
      estimate={estimate}
      shipping={shipping}
      pickup={pickup}
      hasLocation={hasLocation}
    />
    <CategoryNav categories={categories} />
  </div>
</section>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: order-bar
     ---------------------------------------------------------------------------
     Agrupa los 3 contenedores: switch (44) + meta (16) + chips (40)
     Spec mobile: height 132 - gap 12 - padding 0 20 8
     44 + 12 + 16 + 12 + 40 + 8 = 132

     min-height en lugar de height para que nada se recorte si el usuario sube
     el tamano de fuente del sistema.

     En desktop son 2 y en una sola linea: las metas no se pintan (ver
     components/OrderMeta.astro) y el switch sube al nivel de las categorias.
     --------------------------------------------------------------------------- */
  /* Mismo fondo que la pagina, igual que la barra de movil: entre la cabecera y
     el catalogo no hay tres franjas de color sino una sola continua, y lo unico
     que se levanta sobre ella son las tarjetas. */
  .order-bar {
    min-height: 132px;
    padding: 0 20px 8px;
    background-color: var(--sf-body-bg);
  }

  .order-bar__inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 1140px;
    margin-inline: auto;
  }

  /* --- Desktop -------------------------------------------------------------
     La columna de tres filas se convierte en una: sin las metas quedan el switch y
     las categorias, uno en cada extremo de la barra. */
  @media (min-width: 768px) {
    /* Sin fondo, sin borde y sin aire propio: en desktop la barra deja de ser una
       franja de cabecera y pasa a ser un bloque mas de la portada, entre el panel
       de bienvenida y la lista. El hueco que la separa de los dos lo pone la pila
       (ver pages/index.astro), asi que sumar aqui el suyo lo duplicaria.
       Sin fondo, sin borde y sin aire propio —tampoco el lateral—: el margen de
       los lados lo pone la pila, igual que el hueco de arriba y abajo. */
    .order-bar {
      min-height: 0;
      padding: 0;
      border-bottom: 0;
      background-color: transparent;
    }
    /* Y sin tope de ancho: la fila llega hasta donde llega la rejilla, que es lo
       que alinea el switch con la primera tarjeta y el ultimo chip con la tercera. */
    .order-bar__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      max-width: none;
    }
    /* La pista deja de ocupar el ancho de la pantalla y se mide por sus dos
       opciones, de 136 cada una: 136 x 2 + 4 x 2 de padding = 280. Va aqui y no en
       el bloque del switch porque es cosa de esta fila: en /mamayaya/datos la misma pista
       llena la columna de 350 del formulario, como cualquier otro campo.

       Tampoco cede ancho: encogerla parte los rotulos de las dos opciones. Quien
       cede es el carrusel, que para eso lleva scroll.

       `margin-inline: 0` no es cosmetico: los margenes automaticos se sirven ANTES
       que justify-content, asi que el `auto` que centra el switch en movil se
       comeria todo el espacio libre y no quedaria nada que repartir entre los dos
       extremos. */
    .order-bar__inner .switch {
      flex: 0 0 auto;
      width: auto;
      max-width: none;
      margin-inline: 0;
    }
    .order-bar__inner .switch__option {
      flex: 0 0 136px;
    }
    /* La sangria del carrusel es de cuando ocupaba la fila entera y tenia que
       llegar hasta el borde de la pantalla; compartiendo linea, solo lo meteria
       debajo del switch.

       El min-width es lo que le permite encoger por debajo de sus chips —un item
       flex no baja de su contenido sin el— y scrollear en su hueco en lugar de
       empujar al switch fuera de la barra. */
    .order-bar__inner .category-nav {
      min-width: 0;
      margin-inline: 0;
      padding-inline: 0;
    }
  }
</style>
