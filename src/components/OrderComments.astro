---
import SectionLabel from './SectionLabel.astro';
interface Props {
  /** Lo ya escrito, si se vuelve al pedido desde el checkout. */
  value?: string;
}

const { value = '' } = Astro.props;

const id = 'order-comments';
---

<div class="order-comments">
  <SectionLabel as="label" for={id}>Comentarios generales</SectionLabel>

  <!-- .form-control aporta padding 16, radius 12, borde 1 y el placeholder.
       data-auto-grow: el campo se expande al escribir, sin tirador. -->
  <textarea
    class="order-comments__field form-control"
    id={id}
    name="comments"
    rows="3"
    maxlength="1000"
    placeholder="Instrucciones adicionales, alergias..."
    data-auto-grow>{value}</textarea>
</div>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: order-comments
     ---------------------------------------------------------------------------
     Comentarios generales del pedido. Spec: gap 8.
     El textarea (padding 16, radius 12, borde 1 #EAECF0 y color de placeholder)
     lo resuelve .form-control, que ajusta styles/bootstrap-overrides.css.
     --------------------------------------------------------------------------- */
  .order-comments {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* La etiqueta usa el bloque .section-label, compartido con el resto de grupos. */
  /* 100 de alto por defecto. Sin tirador de redimensionado ni barra de scroll:
     el campo crece solo con el texto (src/scripts/auto-grow.ts), asi que nada
     delata que sea un <textarea>. */
  .order-comments__field {
    min-height: 100px;
    resize: none;
    overflow-y: hidden;
  }

  /* --- Desktop -------------------------------------------------------------
     El bloque solo lo pinta /carrito, asi que sus reglas de desktop viven aqui y no
     en el armazon de la pantalla. */
  @media (min-width: 768px) {
    /* La etiqueta sube de 12 a 14 y se oscurece: #4B5563 es --sf-slate, el gris con
       el que desktop rotula lo secundario (la descripcion de la ficha, las metas de
       la barra). Solo aqui: .section-label es de seis bloques y en el resto sigue
       siendo la de 12 de la spec de movil. */
    .order-comments .section-label {
      font-size: 14px;
      line-height: 1;
      color: var(--sf-slate);
    }
    /* Sobre el fondo gris de la pagina el campo pasa a ser superficie, como las
       tarjetas. El borde de 1 y el radius ya son los de .form-control.

       El `:focus` va aparte porque Bootstrap repone ahi el fondo del campo
       (que en esta tienda es transparente): sin esta segunda regla
       el blanco se perderia justo al escribir. */
    .order-comments__field,
    .order-comments__field:focus {
      background-color: var(--sf-white);
    }
  }
</style>
