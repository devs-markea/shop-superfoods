---
import SectionLabel from './SectionLabel.astro';
import { formatPrice } from '../lib/price.ts';
import { formatKm, type ShippingResult } from '../lib/shipping.ts';
import { describeSelection } from '../lib/cart-view.ts';
import { assetUrl } from '../lib/api.ts';
import type { CartItem } from '../lib/cart.ts';

interface Props {
  /**
   * Lineas del carrito de la sesion.
   *
   * En movil se leen tres cosas —cantidad, nombre y promocion—; en desktop, ademas,
   * la foto, el importe de la linea y la configuracion elegida. Por eso el tipo es
   * la linea del carrito y no la del pedido (`OrderLine`, que es lo que viaja al
   * checkout): esos tres datos solo los tiene el carrito.
   */
  items: CartItem[];
  /** Importe a transferir o a pagar, en MXN. Ya lleva el envio y la propina. */
  total: number;
  /** Suma de los productos ANTES de descontar. */
  subtotal?: number;
  /** Lo que descuentan las promociones. 0 = no hay fila que pintar. */
  discount?: number;
  /** Propina elegida. 0 = no hay fila que pintar. */
  tip?: number;
  /**
   * El envio ya resuelto por la pantalla, igual que en el resumen de /mamayaya/pago. Con
   * `none` —al recoger— no hay fila: no hay envio del que hablar.
   */
  shipping?: ShippingResult;
}

const {
  items,
  total,
  subtotal = total,
  discount = 0,
  tip = 0,
  shipping = { state: 'none', cost: 0 },
} = Astro.props;

// Recordatorio de lo que se pidio, ya en la pantalla de pago: aqui no se edita
// nada, por eso las lineas son texto y no controles.
//
// Spec movil: contenedor gap 12 - padding 16 - radius 16 - borde 1px
//             lineas gap 8, 12/16 #6C757D - divisora discontinua - total 14/20
//
// Spec desktop: rotulo 18 - lista gap 16 - linea gap 16 con foto de 56
//               nombre 15/600 e importe 15/700 en la misma fila, y debajo la
//               configuracion en 13/400
//
// UN MARCADO, DOS PANTALLAS: la foto, el importe y la configuracion existen solo
// en desktop, y los envoltorios que los colocan son `display: contents` en movil,
// donde la linea sigue siendo el mismo renglon de texto de siempre. Ver
// los estilos de este archivo.
//
// El desglose aparece solo cuando hay algo que explicar. Con un descuento, un
// envio o una propina, un unico "Total a pagar" obligaria al comprador a fiarse:
// la resta no le cuadraria con lo que vio en el pedido. Sin ninguno de los tres,
// las filas sobran porque el subtotal seria el total repetido.
//
// En desktop no se pintan: esas mismas cuatro filas —y con las mismas cifras— las
// lleva la tarjeta de resumen de al lado, que ademas es donde esta el boton. Lo
// que se queda es "Total a pagar", que es lo que cierra el recordatorio.
const breakdown = discount > 0 || tip > 0 || shipping.state !== 'none';
---

<div class="order-detail">
  <SectionLabel>Detalle del pedido</SectionLabel>

  {
    items.length > 0 ? (
      <ul class="order-detail__items list-unstyled">
        {items.map((item) => {
          // La variante y las personalizaciones, con guiones: "Grande - Guacamole
          // x2". Es lo que distingue dos lineas del mismo platillo, y se arma con
          // la misma funcion que las pinta en el pedido para que no puedan decir
          // dos cosas distintas de la misma linea.
          const selection = describeSelection(item, ' - ');

          return (
            <li class="order-detail__item">
              {/* Solo desktop. La foto llega absoluta salvo el placeholder de los
                  platillos sin foto, que es una ruta del Laravel: assetUrl() es
                  quien lo resuelve.

                  `loading="lazy"` es aqui lo que evita que un movil pague por una
                  foto que no va a ver: una imagen dentro de un `display: none` no
                  llega a entrar en pantalla, asi que la carga se queda esperando
                  un momento que en movil no ocurre. */}
              <span class="order-detail__media">
                <img
                  class="order-detail__image"
                  src={assetUrl(item.image.url)}
                  width="56"
                  height="56"
                  alt={item.image.alt}
                  loading="lazy"
                  decoding="async"
                />
              </span>

              <span class="order-detail__line">
                <span class="order-detail__head">
                  <span class="order-detail__info">
                    <span class="order-detail__name">{`${item.quantity}× ${item.name}`}</span>

                    {item.promotion?.label && (
                      <span class="promo-badge promo-badge--sm">
                        <span class="promo-badge__label">{item.promotion.label}</span>
                      </span>
                    )}
                  </span>

                  {/* Solo desktop: en movil la linea no lleva importes, que los
                      cierra el total de abajo. */}
                  <span class="order-detail__price">{formatPrice(item.lineTotal)}</span>
                </span>

                {selection && <span class="order-detail__custom">{selection}</span>}
              </span>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="order-detail__item">Tu pedido esta vacio.</p>
    )
  }

  <hr class="dashed-divider" />

  {
    breakdown && (
      <dl class="order-detail__rows">
        <div class="order-detail__row">
          <dt class="order-detail__term">Subtotal</dt>
          <dd class="order-detail__value">{formatPrice(subtotal)}</dd>
        </div>

        {discount > 0 && (
          <div class="order-detail__row order-detail__row--discount">
            <dt class="order-detail__term">Descuentos</dt>
            <dd class="order-detail__value">{`− ${formatPrice(discount)}`}</dd>
          </div>
        )}

        {shipping.state !== 'none' && (
          <div class="order-detail__row">
            <dt class="order-detail__term">
              Envio
              {shipping.state === 'quoted' && shipping.km !== null && (
                <span class="order-detail__hint">{formatKm(shipping.km)}</span>
              )}
            </dt>

            {shipping.state === 'quoted' ? (
              <dd class="order-detail__value">{formatPrice(shipping.cost)}</dd>
            ) : shipping.state === 'free' ? (
              <dd class="order-detail__value order-detail__value--free">Gratis</dd>
            ) : (
              <dd class="order-detail__value order-detail__value--pending">Por cotizar</dd>
            )}
          </div>
        )}

        {tip > 0 && (
          <div class="order-detail__row">
            <dt class="order-detail__term">Propina</dt>
            <dd class="order-detail__value">{formatPrice(tip)}</dd>
          </div>
        )}
      </dl>
    )
  }

  <div class="order-detail__total">
    <span class="order-detail__total-term">Total a pagar</span>
    <span class="order-detail__total-value">{formatPrice(total)}</span>
  </div>
</div>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: order-detail
     ---------------------------------------------------------------------------
     Recordatorio de lo pedido en la pantalla de pago.
     Spec: gap 12 - padding 16 - radius 16 - borde 1px #EAECF0 - bg #FFFFFF
     lineas gap 8, Inter 500 12/16 #6C757D
     total Inter 600 14/20, concepto #141821 e importe #D5AA53

     Es la unica tarjeta blanca del proyecto que se apoya en un borde en lugar de
     en la sombra: aqui el bloque no es una superficie interactiva, solo agrupa.
     --------------------------------------------------------------------------- */
  .order-detail {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--sf-border);
    border-radius: 16px;
    background-color: var(--sf-white);
  }

  .order-detail__items {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  /* Element: una linea de texto del detalle ("1× Tacos de Pastor"). Tambien
     rotula el pedido vacio, que es la misma linea sin lineas que listar. */
  .order-detail__item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    color: var(--sf-muted);
  }

  /* Los tres envoltorios que en desktop colocan la foto, el importe y la
     configuracion. En movil no existen: la linea es el renglon de texto de siempre
     —nombre e insignia— y sus hijos siguen siendo hijos del <li>. */
  .order-detail__line,
  .order-detail__head,
  .order-detail__info {
    display: contents;
  }

  /* Y esto es lo que no se pinta en movil: la linea de texto no lleva foto, ni
     importe —lo cierra el total de abajo— ni configuracion. */
  .order-detail__media,
  .order-detail__price,
  .order-detail__custom {
    display: none;
  }

  /* Element: el desglose. Aparece solo cuando hay algo que explicar —un descuento
     o una propina—: si no, sus filas serian el total repetido. */
  .order-detail__rows {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
  }

  .order-detail__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .order-detail__term {
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    color: var(--sf-muted);
  }

  .order-detail__value {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--sf-ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .order-detail__row--discount .order-detail__value,
  .order-detail__value--free {
    color: var(--sf-success);
  }

  /* Modifier: el envio que todavia no se pudo medir ("Por cotizar") */
  .order-detail__value--pending {
    font-weight: 500;
    color: var(--sf-placeholder);
  }

  /* Element: los kilometros del envio, junto al concepto. Acompanan al importe
     para poder cuadrarlo con la tarifa, como en el resumen de /mamayaya/pago. */
  .order-detail__hint {
    margin-left: 8px;
    font-weight: 400;
    color: var(--sf-placeholder);
    white-space: nowrap;
  }

  /* La divisora discontinua es .dashed-divider: la comparte con el resumen de
     /mamayaya/confirmado. */
  /* Element: fila del total */
  .order-detail__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .order-detail__total-term {
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    color: var(--sf-ink);
  }

  .order-detail__total-value {
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    color: var(--sf-gold);
    white-space: nowrap;
  }

  /* --- Desktop -------------------------------------------------------------
     El recordatorio deja de ser una lista de renglones y pasa a ensenar el pedido.
     Spec:
     rotulo         Inter 700 18/100% #111827
     lista          gap 16
     linea          gap 16, foto 56x56 radius 8
     texto          gap 4: arriba nombre e importe con space-between,
     debajo la configuracion
     nombre         Inter 600 15/100% #111827
     importe        Inter 700 15/100% #111827
     configuracion  Inter 400 13/100% #6C757D

     El 15 y el 13 son los de la tarjeta de la cuenta bancaria, que es la otra
     pieza de esta columna; el 18 es el del rotulo de la tarjeta de resumen. Los
     colores son tokens: #111827 es --sf-ink y #6C757D es --sf-muted exacto. */
  @media (min-width: 768px) {
    /* La tarjeta respira mas: 20 entre piezas y 24 de relleno, que es lo que pide
       una lista de lineas de 56 de alto. El radius de 16, el borde de 1 #EAECF0 y
       el fondo blanco ya son los de la spec desde movil y no se repiten.

       Los 680 de ancho y los 386 de alto no se declaran, la misma regla que ya
       siguen .screen-body y .order-item: 680 es lo que mide esta columna en el
       lienzo de 1440 —1120 menos los 48 del hueco y los 390 de la tarjeta—, asi que
       lo reparte la rejilla; y el alto lo pone el pedido, que puede tener una linea
       o seis. */
    .order-detail {
      gap: 20px;
      padding: 24px;
    }
    /* El rotulo encabeza una seccion de la pantalla, como en la tarjeta de la
       cuenta, pero un punto mas grande: aqui abre la pieza mas alta de la columna. */
    .order-detail .section-label {
      font-size: 18px;
      font-weight: 700;
      /* 100% del tamano: es un rotulo de una linea. */
      line-height: 1;
      color: var(--sf-ink);
    }
    .order-detail__items {
      gap: 16px;
    }
    /* La linea ya no envuelve: son dos piezas —foto y texto— y el texto encoge.
       Envolviendo, un nombre largo mandaria el bloque entero debajo de la foto. */
    .order-detail__item {
      flex-wrap: nowrap;
      gap: 16px;
    }
    /* Element: media — la foto, en una caja fija con el fondo del borde debajo,
       para que una imagen que tarda o falla no encoja la linea. */
    .order-detail__media {
      display: block;
      flex: 0 0 56px;
      width: 56px;
      height: 56px;
      overflow: hidden;
      border-radius: 8px;
      background-color: var(--sf-border);
    }
    .order-detail__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    /* Element: line — el texto de la linea, que ocupa lo que deje la foto. */
    .order-detail__line {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
    }
    /* Element: head — nombre a la izquierda, importe a la derecha. */
    .order-detail__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    /* Element: info — el nombre con su insignia, que es lo que puede encoger. */
    .order-detail__info {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }
    /* El nombre se recorta antes de empujar al importe: la fila la comparten los
       dos, y el que tiene que leerse entero es el que se paga. */
    .order-detail__name {
      overflow: hidden;
      font-size: 15px;
      font-weight: 600;
      line-height: 1;
      color: var(--sf-ink);
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .order-detail__price {
      display: block;
      font-size: 15px;
      font-weight: 700;
      line-height: 1;
      color: var(--sf-ink);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    /* La configuracion se recorta igual que el nombre: es la aclaracion de la
       linea, no puede partirla en tres renglones. */
    .order-detail__custom {
      display: block;
      overflow: hidden;
      font-size: 13px;
      font-weight: 400;
      line-height: 1;
      color: var(--sf-muted);
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    /* El desglose se retira: las mismas cuatro filas —subtotal, descuentos, envio
       y propina— las lleva la tarjeta de resumen de al lado, que ademas es donde
       se confirma. Dos veces la misma cuenta en una pantalla son dos sitios donde
       leer el mismo numero. Se queda "Total a pagar", que es lo que cierra el
       recordatorio. */
    .order-detail__rows {
      display: none;
    }
    /* Y con el desglose fuera, el total es lo unico que queda de la cuenta: crece
       al mismo remate que el de la tarjeta de resumen —16/700 el concepto y 20/800
       en dorado el importe—. Que coincidan no es casualidad ni descuido: es la
       MISMA cifra dicha en las dos columnas, lo que se va a pagar, y la de aqui no
       puede leerse como una nota al pie de la otra.

       Los colores no se repiten: el negro del concepto y el dorado del importe ya
       son los de la spec desde movil. Lo unico que cambia es cuanto pesan. */
    .order-detail__total-term {
      font-size: 16px;
      font-weight: 700;
      line-height: 1;
    }
    .order-detail__total-value {
      font-size: 20px;
      font-weight: 800;
      line-height: 1;
    }
  }

  /* Mismo caso que .tag: <OrderDetail> y <OrderReceipt> no coinciden en
     ninguna pantalla, asi que cada uno lleva su copia. */

  /* ---------------------------------------------------------------------------
     Block: dashed-divider
     ---------------------------------------------------------------------------
     Divisora discontinua. Spec: 1px, trazos de 4 y huecos de 2, #EAECF0.
     Separa el total del detalle en /mamayaya/pago/transferencia y en /mamayaya/confirmado.

     Es un bloque propio y no un element de cada uno por el mismo motivo que
     .section-label: son dos bloques distintos con la misma divisora, y la tecnica
     no es una sola declaracion.

     No usa `border-style: dashed`: ahi el largo de los trazos lo decide el
     navegador. Con un degradado repetido salen los 4/2 exactos de la spec.
     --------------------------------------------------------------------------- */
  .dashed-divider {
    height: 1px;
    margin: 0;
    border: 0;
    opacity: 1;
    background-image: repeating-linear-gradient(to right, var(--sf-border) 0 4px, transparent 4px 6px);
  }

  /* Viene de la familia de promociones, que comparten la portada, la ficha, el
       pedido y el cierre. Cada consumidor lleva solo las piezas que pinta: en
       ninguna pantalla coinciden dos, asi que nadie carga la misma regla dos
       veces. Si se toca una, mirar quien mas la tiene. */

  /* Block: promo-badge — "15%", "$50", "2x1". La etiqueta la compone el backend. */
  .promo-badge {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border-radius: 100px;
    background-color: var(--sf-gold);
    color: var(--sf-white);
    font-size: 12px;
    font-weight: 700;
    line-height: 16px;
    white-space: nowrap;
  }

  .promo-badge__label {
    /* El numero es lo que se lee de lejos: el icono solo lo acompaña. */
    letter-spacing: 0.01em;
  }

  /* Modifier: sin icono y mas apretada, para las listas de texto del cierre. */
  .promo-badge--sm {
    padding: 0 8px;
  }
</style>
