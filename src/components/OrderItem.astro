---
import Icon from './Icon.astro';
import QuantityStepper from './QuantityStepper.astro';
import { formatPrice } from '../lib/price.ts';
import { productHref } from '../lib/catalog.ts';
import { cartItemImageSrc, describeSelection, type CartItem } from '../lib/cart.ts';

interface Props {
  item: CartItem;
}

const { item } = Astro.props;
const selection = describeSelection(item);
---

<!-- data-line-id es cart_items.id, el que viaja en PATCH y DELETE.
     No se guarda el precio unitario en el marcado: los importes los recalcula
     la API en cada cambio de cantidad (las promociones de "compra y lleva"
     dependen de las unidades), asi que multiplicar aqui daria un total que
     contradice al servidor. -->
<li class="order-item" data-line data-line-id={item.id}>
  <div class="order-item__media">
    <img
      class="order-item__image"
      src={cartItemImageSrc(item)}
      width="70"
      height="70"
      alt={item.image.alt}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="order-item__body">
    <div class="order-item__head">
      <div class="order-item__info">
        <h2 class="order-item__title">
          <a class="text-reset" href={productHref({ id: item.productId })}>{item.name}</a>
        </h2>
        {selection && <p class="order-item__custom">{selection}</p>}
        {item.promotion && <p class="order-item__promo">{item.promotion.name}</p>}
      </div>

      <span class="order-item__price" data-line-subtotal>
        {formatPrice(item.lineTotal)}
      </span>
    </div>

    <div class="order-item__actions">
      <button
        class="order-item__remove btn-plain"
        type="button"
        aria-label={`Quitar ${item.name} del pedido`}
        data-remove-line
      >
        <Icon name="trash" size="sm" />
      </button>

      <QuantityStepper quantity={item.quantity} itemName={item.name} />
    </div>
  </div>
</li>
