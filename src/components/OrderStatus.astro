---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  title: string;
  /** Que pasa a continuacion, en una linea. */
  note: string;
  /** Folio del pedido, sin el "#". Solo lo lleva el pedido ya confirmado. */
  folio?: number | string;
  /**
   * Sello: `success` es el circulo verde con el visto (pedido confirmado);
   * `pending` el dorado con el reloj (pedido a la espera del comprobante).
   */
  state?: 'success' | 'pending';
}

const { title, note, folio, state = 'success' } = Astro.props;

// Cierre de una pantalla de resultado: sello, titular y aviso, todo centrado.
// Lo comparten /mamayaya/confirmado y /mamayaya/recibido, que solo se diferencian en
// el sello, la copia y el folio.
//
// Spec: bloque gap 24 - circulo 80 con radius 40 - labels gap 8
//       titulo 24/32 600 #141821 - folio 40 800 dorado - aviso 14/20 400 #6C757D

const icons: Record<'success' | 'pending', IconName> = {
  success: 'check',
  pending: 'clock',
};
---

<div class="order-status">
  <span
    class:list={['order-status__seal', { 'order-status__seal--pending': state === 'pending' }]}
  >
    <Icon name={icons[state]} size="lg" />
  </span>

  <div class="order-status__titles">
    <h1 class="order-status__title">{title}</h1>

    {folio !== undefined && <p class="order-status__folio">#{folio}</p>}

    <p class="order-status__note">{note}</p>
  </div>
</div>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: order-status
     ---------------------------------------------------------------------------
     Cierre de una pantalla de resultado: sello + titular + aviso.
     Spec: bloque gap 24 - circulo 80 radius 40 - labels gap 8, centrados

     Dos sellos, un solo bloque: el verde con el visto (pedido confirmado) y el
     dorado con el reloj (pedido recibido, a la espera del comprobante). Cambian el
     color y el icono; el resto —tamanos, tipos y huecos— es identico.
     --------------------------------------------------------------------------- */
  .order-status {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  /* Element: sello. El radius de 40 sobre una caja de 80 es un circulo, asi que se
     declara como tal: no depende de que el tamano no cambie nunca. */
  .order-status__seal {
    display: inline-flex;
    flex: 0 0 80px;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: var(--sf-success);
    color: var(--sf-white);
  }

  /* Modifier: a la espera. Dorado sobre su propio tinte, como el resto de cajas de
     icono del proyecto (.payment-option__media). */
  .order-status__seal--pending {
    background-color: var(--sf-gold-tint);
    color: var(--sf-gold);
  }

  .order-status__titles {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: center;
  }

  /* Element: titulo — Inter 600 24/32 */
  .order-status__title {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
    line-height: 32px;
    color: var(--sf-ink);
  }

  /* Element: folio — Inter 800 40/40 dorado.

     Es un numero corto —la numeracion del pedido, no el ULID de `orderNumber`—, asi
     que cabe de sobra a este tamano y no hace falta preverle un desbordamiento.

     Los 40 quedan fuera de la escala de tipos (12/14/16/24): es el numero
     protagonista de la pantalla y no se repite en ningun otro sitio, asi que no
     gana nada por ser token.

     La spec da letter-spacing -100%, que es imposible: sobre 40px serian -40px y
     las cifras se apilarian. Se lee como lo que pide un numero grande, un tracking
     negativo corto. */
  .order-status__folio {
    margin: 0;
    font-size: 40px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--sf-gold);
  }

  /* Element: aviso — Inter 400 14/20 */
  .order-status__note {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: var(--sf-muted);
  }

  /* --- Desktop -------------------------------------------------------------
     El sello encoge y el titular crece: en una columna de 580 con el pie debajo, un
     circulo de 80 pesa mas que el titulo que corona, y era al reves. Spec:
     sello    64 con relleno de 16 - icono de 28
     titular  Inter 800 32/100% centrado #111827
     aviso    Inter 400 16/100% centrado #6C757D

     El 32 es el del nombre del platillo en la ficha de desktop, y el 800 el peso
     del folio que este mismo bloque ya rotula: los dos estan en casa. El #111827 es
     --sf-ink y el #6C757D es --sf-muted exacto.

     El hueco de 24 del bloque, el de 8 de los rotulos y el centrado no cambian, asi
     que no se repiten. El folio tampoco: sus 40 en dorado siguen siendo la cifra
     mas grande de /mamayaya/confirmado, que es lo que tiene que ser. */
  @media (min-width: 768px) {
    .order-status__seal {
      flex: 0 0 64px;
      width: 64px;
      height: 64px;
      padding: 16px;
    }
    /* El icono del sello, y solo el: --lg son los 40 del circulo de 80 de movil. */
    .order-status__seal .icon {
      width: 28px;
      height: 28px;
    }
    .order-status__title {
      font-size: 32px;
      font-weight: 800;
      /* 100% del tamano: es un titular de una linea. */
      line-height: 1;
    }
    /* El aviso NO se compone al 100% de la spec. Ese valor vale para el titular,
       que cabe en una linea; este se parte en dos en cuanto la copia crece —"Te
       avisaremos por WhatsApp cuando tu pedido este listo. Lo pagas en efectivo al
       recogerlo."— y entonces las dos lineas se tocarian. Se compone al 20 de la
       escala, que es lo que ese 100% quiere decir en un texto que puede envolver. */
    .order-status__note {
      font-size: 16px;
      line-height: 20px;
    }
  }
</style>
