---
import PaymentOption from './PaymentOption.astro';
import SectionLabel from './SectionLabel.astro';
import MpLogo from '../assets/icons/mp-logo.svg';
import type { DeliveryType, PaymentMethod } from '../lib/checkout.ts';

interface Props {
  /** Metodo ya elegido, para cuando se vuelve atras desde el pago. */
  selected?: PaymentMethod | null;
  /**
   * Modo de entrega. Es lo que decide QUE metodos existen, no solo cual viene
   * marcado: al recoger, el unico es efectivo; a domicilio estan los tres.
   */
  deliveryType?: DeliveryType;
  /**
   * Si el negocio publico su cuenta bancaria —los tres datos, ver
   * lib/store-config.ts—. Sin ella no se pinta la transferencia: la pantalla
   * siguiente ensena la cuenta a la que hay que transferir, y sin cuenta que
   * ensenar ese camino solo lleva a una tarjeta vacia y a un pedido que el
   * comprador no puede pagar. Mejor no ofrecerlo que romperlo a la mitad.
   */
  hasBankTransfer?: boolean;
}

// Transferencia por defecto: es el metodo que hoy se cobra de verdad.
const {
  selected = 'bank_transfer',
  deliveryType = 'delivery',
  hasBankTransfer = true,
} = Astro.props;

const pickup = deliveryType === 'pickup';

// Al recoger no viene a cuento —se paga en el local— y sin cuenta publicada no
// hay a donde transferir. Las dos cosas quitan la opcion, no solo su marca.
const transfer = !pickup && hasBankTransfer;

// Cual llega marcado, resuelto aqui y no opcion por opcion. La transferencia es
// la de por defecto, pero solo existe con cuenta: sin ella el defecto cae al
// efectivo, que es el otro metodo que el negocio cobra de verdad. Dejar el grupo
// sin marcar mandaria a quien no tocara nada a un "Elige un metodo de pago." por
// una opcion que ni siquiera llego a ver.
const checked: PaymentMethod =
  selected === 'mercado_pago'
    ? 'mercado_pago'
    : transfer && selected !== 'efectivo'
      ? 'bank_transfer'
      : 'efectivo';

// Spec: etiqueta + opciones, gap 12 en los dos contenedores.
//
// Los `value` son los del diseno, no los del contrato: los traduce
// toPaymentMethod() al cerrar el pedido. Cambiarlos aqui obligaria a tocar
// tambien el CSS de los estados y las etiquetas de los labels.
---

<div class="payment-methods d-flex flex-column">
  <SectionLabel variant="strong" id="payment-label">Metodo de pago</SectionLabel>

  <div
    class="payment-methods__options d-flex flex-column"
    role="group"
    aria-labelledby="payment-label"
  >
    {
      pickup ? (
        /*
          Al recoger se paga en el local, y entonces transferencia y Mercado Pago
          no vienen a cuento: los dos son formas de pagar por adelantado un pedido
          que va a salir a la calle. Queda una sola opcion, marcada de entrada.

          Se pinta igual que las demas —no como un rotulo— para que la pantalla
          siga diciendo lo mismo en el mismo sitio: como se va a pagar.
        */
        <PaymentOption
          id="payment-cash"
          value="efectivo"
          title="Efectivo"
          icon="cash"
          note="Pagas al recoger tu pedido en el local"
          checked
        />
      ) : (
        <>
          {transfer && (
            <PaymentOption
              id="payment-transfer"
              value="transferencia"
              title="Transferencia bancaria"
              icon="phone"
              note="Transferencia bancaria"
              checked={checked === 'bank_transfer'}
            />
          )}

          {/*
            Efectivo a domicilio: se paga al repartidor al recibir el pedido. Va
            antes de Mercado Pago porque es de los dos metodos que el negocio cobra
            de verdad hoy; la pasarela sigue pendiente de conectar.

            El pedido no se cierra aqui, igual que en la transferencia: primero se
            lee en /mamayaya/pago/efectivo como se paga, y alli se confirma.
          */}
          <PaymentOption
            id="payment-cash"
            value="efectivo"
            title="Efectivo"
            icon="cash"
            note="Pagas al recibir tu pedido"
            checked={checked === 'efectivo'}
          />

          {/*
            Lleva nota como los otros dos: sin ella era la unica tarjeta de una
            sola linea, y la fila de metodos alternaba alturas segun cuales
            estuvieran disponibles.

            El unico metodo con marca: en lugar del icono de tarjeta va su logo,
            que llego como archivo y vive en assets/icons. No pasa por Icon.astro
            ni por BrandIcon.astro —los dos pintan un trazo que hereda el color
            del contenedor— porque un logo de un tercero se usa con SUS colores,
            que aqui son ademas los que lo hacen reconocible.

            El width/height es el del archivo, que es el tamano de movil; el de
            desktop lo pone el CSS junto con la caja, porque las dos medidas
            cambian a la vez. Oculto a lectores de pantalla, como los iconos: el
            titulo de al lado ya dice la marca.

            Seleccionable: cierra el pedido en /mamayaya/confirmado, sin pasar por los
            datos de la cuenta. Lo que falta es el cobro real —la pasarela no forma
            parte de las cuatro APIs—, no la pantalla.
          */}
          <PaymentOption
            id="payment-mercadopago"
            value="mercadopago"
            title="Mercado Pago"
            note="Paga con Mercado Pago"
            checked={checked === 'mercado_pago'}
          >
            {/* El slot va en el Fragment y no en el logo: los atributos que se
                le pasan al archivo terminan en su <svg>, y `slot` no pinta
                nada ahi. El Fragment no deja marcado propio. */}
            <Fragment slot="media">
              <MpLogo
                class="payment-option__logo"
                width={68}
                height={28}
                aria-hidden="true"
                focusable="false"
              />
            </Fragment>
          </PaymentOption>
        </>
      )
    }
  </div>
</div>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: payment-methods
     ---------------------------------------------------------------------------
     Etiqueta y opciones, y las opciones entre si: los dos huecos son de 12.

     Es lo unico que pone este componente: quien pinta cada opcion es
     .payment-option, en components/PaymentOption.astro. El reparto en columna lo
     hacen las utilidades de Bootstrap en el marcado; aqui va solo la medida del
     hueco, que sale de la escala de la tienda y no de la de Bootstrap.
     --------------------------------------------------------------------------- */
  .payment-methods,
  .payment-methods__options {
    gap: 12px;
  }
</style>
