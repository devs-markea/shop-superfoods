---
import PaymentOption from './PaymentOption.astro';
import MpLogo from '../assets/icons/mp-logo.svg';
import type { DeliveryType, PaymentMethod } from '../lib/checkout.ts';

interface Props {
  /** Metodo ya elegido, para cuando se vuelve atras desde el pago. */
  selected?: PaymentMethod | null;
  /**
   * Modo de entrega. Es lo que decide QUE metodos existen, no solo cual viene
   * marcado: al recoger, el unico es efectivo; a domicilio estan los tres.
   */
  deliveryType?: DeliveryType;
}

// Transferencia por defecto: es el metodo que hoy se cobra de verdad.
const { selected = 'bank_transfer', deliveryType = 'delivery' } = Astro.props;

const pickup = deliveryType === 'pickup';

// Spec: etiqueta + opciones, gap 12 en los dos contenedores.
//
// Los `value` son los del diseno, no los del contrato: los traduce
// toPaymentMethod() al cerrar el pedido. Cambiarlos aqui obligaria a tocar
// tambien el CSS de los estados y las etiquetas de los labels.
---

<div class="d-flex flex-column gap-3">
  <span class="section-label section-label--strong" id="payment-label">Metodo de pago</span>

  <div class="d-flex flex-column gap-3" role="group" aria-labelledby="payment-label">
    {
      pickup ? (
        /*
          Al recoger se paga en el local, y entonces transferencia y Mercado Pago
          no vienen a cuento: los dos son formas de pagar por adelantado un pedido
          que va a salir a la calle. Queda una sola opcion, marcada de entrada.

          Se pinta igual que las demas —no como un rotulo— para que la pantalla
          siga diciendo lo mismo en el mismo sitio: como se va a pagar.
        */
        <PaymentOption
          id="payment-cash"
          value="efectivo"
          title="Efectivo"
          icon="cash"
          note="Pagas al recoger tu pedido en el local"
          checked
        />
      ) : (
        <>
          <PaymentOption
            id="payment-transfer"
            value="transferencia"
            title="Transferencia bancaria"
            icon="phone"
            note="Transferencia bancaria"
            checked={selected !== 'mercado_pago' && selected !== 'efectivo'}
          />

          {/*
            Efectivo a domicilio: se paga al repartidor al recibir el pedido. Va
            antes de Mercado Pago porque es de los dos metodos que el negocio cobra
            de verdad hoy; la pasarela sigue pendiente de conectar.

            El pedido no se cierra aqui, igual que en la transferencia: primero se
            lee en /pago/efectivo como se paga, y alli se confirma.
          */}
          <PaymentOption
            id="payment-cash"
            value="efectivo"
            title="Efectivo"
            icon="cash"
            note="Pagas al recibir tu pedido"
            checked={selected === 'efectivo'}
          />

          {/*
            El unico metodo con marca: en lugar del icono de tarjeta va su logo,
            que llego como archivo y vive en assets/icons. No pasa por Icon.astro
            ni por BrandIcon.astro —los dos pintan un trazo que hereda el color
            del contenedor— porque un logo de un tercero se usa con SUS colores,
            que aqui son ademas los que lo hacen reconocible.

            El width/height es el del archivo, que es el tamano de movil; el de
            desktop lo pone el CSS junto con la caja, porque las dos medidas
            cambian a la vez. Oculto a lectores de pantalla, como los iconos: el
            titulo de al lado ya dice la marca.

            Seleccionable: cierra el pedido en /confirmado, sin pasar por los
            datos de la cuenta. Lo que falta es el cobro real —la pasarela no forma
            parte de las cuatro APIs—, no la pantalla.
          */}
          <PaymentOption
            id="payment-mercadopago"
            value="mercadopago"
            title="Mercado Pago"
            checked={selected === 'mercado_pago'}
          >
            {/* El slot va en el Fragment y no en el logo: los atributos que se
                le pasan al archivo terminan en su <svg>, y `slot` no pinta
                nada ahi. El Fragment no deja marcado propio. */}
            <Fragment slot="media">
              <MpLogo
                class="payment-option__logo"
                width={68}
                height={28}
                aria-hidden="true"
                focusable="false"
              />
            </Fragment>
          </PaymentOption>
        </>
      )
    }
  </div>
</div>
