---
import SectionLabel from './SectionLabel.astro';
import { formatPrice } from '../lib/price.ts';
import { formatKm, type ShippingResult } from '../lib/shipping.ts';

interface Props {
  /** Importe de los productos, en MXN. */
  products: number;
  /** Propina preseleccionada, en MXN. */
  tip: number;
  /**
   * El envio, ya resuelto por la pantalla (src/lib/shipping.ts). Son cuatro
   * respuestas distintas y cada una se pinta distinto:
   *
   *   none    al recoger no hay envio, y la fila desaparece: un "Por cotizar" en
   *           un pedido que se recoge promete un cobro que no va a llegar
   *   free    el negocio lo regala
   *   quoted  hay distancia medida, y con ella precio
   *   pending sin ubicacion compartida no hay nada que medir
   */
  shipping?: ShippingResult;
}

const { products, tip, shipping = { state: 'pending', cost: 0 } } = Astro.props;

// El total se calcula, nunca se escribe: la vista no puede contradecir a los
// datos. El script lo recalcula al cambiar la propina.
const total = products + tip + shipping.cost;
---

<div class="summary">
  <SectionLabel>Resumen</SectionLabel>

  <dl class="summary__rows">
    <div class="summary__row">
      <dt class="summary__term">Productos</dt>
      <dd class="summary__value">{formatPrice(products)}</dd>
    </div>

    {
      shipping.state !== 'none' && (
        <div class="summary__row">
          <dt class="summary__term">
            Costo de envio
            {/* La distancia junto al concepto: es de donde sale el importe, y
                asi el comprador puede cuadrarlo con la tarifa en lugar de
                fiarse de un numero que aparece solo. */}
            {shipping.state === 'quoted' && shipping.km !== null && (
              <span class="summary__hint">{formatKm(shipping.km)}</span>
            )}
          </dt>

          {shipping.state === 'quoted' ? (
            <dd class="summary__value">{formatPrice(shipping.cost)}</dd>
          ) : shipping.state === 'free' ? (
            <dd class="summary__value summary__value--free">Gratis</dd>
          ) : (
            <dd class="summary__value summary__value--pending">Por cotizar</dd>
          )}
        </div>
      )
    }

    <hr class="summary__divider" />

    <div class="summary__row">
      <dt class="summary__total-term">Total</dt>
      <dd class="summary__total-value" data-summary-total>{formatPrice(total)}</dd>
    </div>
  </dl>
</div>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: summary
     ---------------------------------------------------------------------------
     Desglose del importe. Spec: bloque gap 16 - lista gap 12

     Se marca como <dl>: son pares concepto/importe, no una lista de elementos
     sueltos. Los margenes del <dl>/<dd> que trae el Reboot se anulan.
     --------------------------------------------------------------------------- */
  .summary {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .summary__rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
  }

  /* Element: fila concepto + importe */
  .summary__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  /* Element: concepto — Inter 400 14/20 #6C757D */
  .summary__term {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: var(--sf-muted);
  }

  /* Element: importe — Inter 500 14/20 #141821 */
  .summary__value {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--sf-ink);
    white-space: nowrap;
  }

  /* Modifier: importe todavia sin calcular ("Por cotizar") */
  .summary__value--pending {
    font-weight: 400;
    color: var(--sf-placeholder);
  }

  /* Modifier: envio que no se cobra ("Gratis"). En verde, como los descuentos del
     detalle: es lo mismo, dinero que no se paga. */
  .summary__value--free {
    color: var(--sf-success);
  }

  /* Element: el dato del que sale el importe —los kilometros del envio—, junto al
     concepto y en pequeno: acompana a la fila, no compite con ella. */
  .summary__hint {
    margin-left: 8px;
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    color: var(--sf-placeholder);
    white-space: nowrap;
  }

  /* Element: divisora. Spec: 2px #EAECF0 */
  .summary__divider {
    height: 0;
    margin: 0;
    border: 0;
    border-top: 2px solid var(--sf-border);
    opacity: 1;
  }

  /* Element: fila del total — Inter 600 16/24 */
  .summary__total-term {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    color: var(--sf-ink);
  }

  .summary__total-value {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    color: var(--sf-gold);
    white-space: nowrap;
  }
</style>
