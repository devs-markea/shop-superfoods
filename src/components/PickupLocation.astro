---
import Icon from './Icon.astro';
import SectionLabel from './SectionLabel.astro';

interface Props {
  /** Direccion escrita del local. Puede faltar. */
  address?: string;
  /** Enlace de Google Maps al local. Puede faltar. */
  mapsUrl?: string;
}

const { address, mapsUrl } = Astro.props;

// Donde recoger el pedido. Se lee como una fila de <BankAccount> —etiqueta y
// dato—, pero aqui no hay nada que copiar y pegar: se abre el mapa.
//
// Hoy no lo pinta ninguna pantalla: el flujo de efectivo dejo de mostrar la
// direccion del local, ni al pagar ni en el acuse. Se conserva por si vuelve.
//
// Los dos datos llegan de GET /api/store y sirven por separado, como en la hoja de
// la barra superior: de un enlace de Maps no sale una direccion legible
// —`maps.app.goo.gl/xxxx` es opaco— y de una direccion escrita no sale un enlace
// fiable. Con los dos, se lee y se abre; con uno, se hace lo que ese permita.
//
// Sin ninguno de los dos la tarjeta sigue en pie, con la pista: el pedido se puede
// recoger igual, y el local lo dira por WhatsApp. Es lo contrario que en la cuenta
// bancaria, donde una fila vacia deja el pago sin destino.
//
// Sin spec de Figma: son las medidas de .bank-account, que es la tarjeta del mismo
// sitio en la otra pantalla, y el boton de accion del proyecto.
---

<div class="pickup-location">
  <div class="pickup-location__field">
    <SectionLabel variant="soft">Donde recoger</SectionLabel>

    {
      address ? (
        <span class="pickup-location__value">{address}</span>
      ) : (
        <span class="pickup-location__hint">
          Te confirmamos la direccion por WhatsApp al recibir tu pedido.
        </span>
      )
    }
  </div>

  {
    mapsUrl && (
      <a class="pickup-location__link" href={mapsUrl} target="_blank" rel="noopener">
        <Icon name="map-pin" size="sm" />
        <span>Abrir en Google Maps</span>
      </a>
    )
  }
</div>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: pickup-location
     ---------------------------------------------------------------------------
     Tarjeta con el local donde se recoge el pedido, en /mamayaya/recibido. Comparte
     las medidas de .bank-account: las dos son la tarjeta de datos de su pantalla.

     Sin spec de Figma. Tarjeta: gap 16 - padding 20 - radius 20 - bg #FFFFFF -
     sombra de tarjeta. Boton: el de compartir ubicacion (44 de alto, borde dorado),
     porque tambien abre un mapa y no es la accion principal de la pantalla.

     No es .bank-account con un modifier: aquella son filas de datos que se copian y
     esta una direccion con una salida al mapa. Solo coinciden en la caja.
     --------------------------------------------------------------------------- */
  .pickup-location {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px;
    border-radius: 20px;
    background-color: var(--sf-white);
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 5%);
  }

  /* Element: etiqueta + dato. El rotulo es .section-label--soft, el mismo de las
     filas de la cuenta bancaria. */
  .pickup-location__field {
    display: flex;
    flex-direction: column;
    /* Fuera de la escala de 4 del proyecto: el mismo 6 de .bank-account__field. */
    gap: 6px;
  }

  /* Element: la direccion — Inter 600 14/20 #141821 */
  .pickup-location__value {
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    color: var(--sf-ink);
  }

  /* Element: pista cuando la tienda no tiene direccion configurada */
  .pickup-location__hint {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--sf-muted);
  }

  /* Element: salida a Google Maps. Mismo tratamiento que .location__button: el
     icono hereda el dorado por currentColor. */
  .pickup-location__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    border: 1px solid var(--sf-gold);
    border-radius: 12px;
    color: var(--sf-gold);
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    transition: background-color 160ms ease;
  }
  .pickup-location__link:hover {
    background-color: var(--sf-gold-tint);
    color: var(--sf-gold);
  }
</style>
