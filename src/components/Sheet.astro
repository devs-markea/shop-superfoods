---
import Icon from './Icon.astro';

interface Props {
  /** Id con el que lo abre el boton (`data-sheet="..."`). */
  id: string;
  title: string;
  /**
   * Hoja ancha en desktop. Para las que no son una consulta rapida sino una
   * pantalla en la que se trabaja —hoy solo el mapa de la ubicacion, que a 390
   * se queda en una ventanita por la que buscar una casa es incomodo—.
   *
   * En movil no cambia nada: alli la hoja ya ocupa el ancho entero.
   */
  wide?: boolean;
  /**
   * No se cierra al pulsar fuera.
   *
   * Es para las hojas donde hay algo que perder. En una de consulta —el horario,
   * la direccion de la tienda— pulsar fuera es la forma comoda de salir y no
   * cuesta nada; en el mapa, un toque despistado tira el punto que se acababa de
   * buscar y hay que empezar por la ciudad otra vez.
   *
   * Escape y el boton de cerrar siguen funcionando: lo que se retira es el
   * cierre ACCIDENTAL, no la salida.
   */
  persistent?: boolean;
}

const { id, title, wide = false, persistent = false } = Astro.props;

// Hoja modal de la barra superior: horario y ubicacion.
//
// Es un <dialog> nativo y no el modal de Bootstrap. El nativo ya trae fondo,
// cierre con Escape, foco atrapado dentro y el resto de la pagina inerte, que es
// justo lo que un modal tiene que resolver; el de Bootstrap habria costado su
// SCSS, su JS y una entrada en optimizeDeps para acabar en lo mismo. El unico JS
// propio son las dos lineas que lo abren y lo cierran (scripts/sheet.ts).
//
// Se abre desde abajo, como una hoja: es una consulta rapida desde la cabecera,
// no una pantalla, y en movil el pulgar la alcanza.
//
// El titulo lo lee `aria-labelledby`, asi que el dialogo se anuncia por su nombre.
---

<dialog
  class:list={['sheet', wide && 'sheet--wide']}
  id={id}
  aria-labelledby={`${id}-title`}
  data-sheet-persistent={persistent ? '' : undefined}
>
  <div class="sheet__header">
    <h2 class="sheet__title" id={`${id}-title`}>{title}</h2>

    {/*
      Cierre propio y no el .btn-close de Bootstrap: aquel es una imagen de fondo
      con su grosor y su negro, y aqui el icono tiene que seguir el sistema —trazo
      de 2, currentColor— como el resto de botones de icono del proyecto.
    */}
    <button class="sheet__close btn-plain" type="button" aria-label="Cerrar" data-sheet-close>
      <Icon name="close" size="sm" />
    </button>
  </div>

  <div class="sheet__body">
    <slot />
  </div>
</dialog>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: sheet  (sobre <dialog> nativo)
     ---------------------------------------------------------------------------
     Hoja modal que sube desde abajo. La usan el horario y la ubicacion de la barra
     superior.

     No hay spec de Figma para estas dos: se componen con el sistema que ya existe
     —superficie blanca, radius 20 como las tarjetas del cierre, padding 20, y los
     tipos de .section-label y .topbar__title—, para que no se lean como una pieza
     de otro proyecto.

     Entra y sale animada, y con CSS solo: `@starting-style` da el fotograma de
     partida y `transition-behavior: allow-discrete` retrasa el `display: none`
     hasta el final para que haya salida y no un corte. Las reglas van repartidas
     entre el estado cerrado —la salida— y `[open]` —la entrada—, cada una con su
     comentario.
     --------------------------------------------------------------------------- */
  .sheet {
    width: 100%;
    max-width: 390px;
    max-height: 85dvh;
    padding: 20px;
    border: 0;
    /* Esquinas arriba: abajo se pega al borde de la pantalla. */
    border-radius: 20px 20px 0 0;
    background-color: var(--sf-white);
    color: var(--sf-ink);
    /* Al fondo y centrada. `margin: auto` en los dos ejes la centraria en alto. */
    margin: auto auto 0;
    overflow-y: auto;

    /* La COLOCACION del contenido vive aqui y no en `[open]`, aunque solo se vea
       con la hoja abierta.

       Es por el cierre: de `[open]` solo sobrevive lo que este en la transicion, y
       `flex-direction` y `gap` no se pueden transicionar. Puestos alli, revertian
       en el instante en que se quitaba el atributo —cabecera y cuerpo pasaban a
       ponerse en fila, con el hueco a cero— y la hoja se recomponia de golpe ANTES
       de empezar a bajar: parecia que se rompia y luego se iba.

       Aqui no reventian, porque nunca cambian. En `[open]` se queda solo el
       `display`, que es el unico que tiene que cambiar y el unico que sabe
       esperar. */
    flex-direction: column;
    gap: 16px;

    /* La misma colocacion que el navegador le da a un dialogo modal, escrita a
       mano. Al cerrar, la hoja sale de la capa superior antes de terminar de
       bajar en los motores que todavia no animan `overlay`; sin estas tres
       lineas perderia de golpe el `fixed` que venia de `dialog:modal` y saltaria
       al hueco que le tocase en la pagina justo en el ultimo fotograma.

       `height: fit-content` va con ellas: con arriba y abajo en 0 y un alto
       automatico, la hoja se estiraria de borde a borde en vez de encogerse a su
       contenido y pegarse abajo con el `margin` de arriba. */
    position: fixed;
    inset: 0;
    height: fit-content;

    /* ------------------------------------------------------------------------
       Cerrada — y con ello, la SALIDA
       ------------------------------------------------------------------------
       Un <dialog> vuelve a ESTAS reglas cuando se cierra, asi que lo que se
       declare aqui es a donde se va la hoja y en cuanto tiempo. La entrada se
       declara en `[open]`, y por eso cada una puede tener su curva y su duracion.

       `display` y `overlay` no se interpolan —van de un valor al otro sin nada en
       medio— y sin `allow-discrete` saltarian a `none` en el primer fotograma:
       eso era exactamente lo que hacia desaparecer la hoja de golpe. Con el, el
       salto se pospone al final del recorrido y la hoja se queda pintada, y en la
       capa superior, mientras baja.

       Salir dura menos que entrar —220 contra 360— y con una curva que acelera en
       vez de frenar: quien cierra ya decidio, y hacerle mirar la despedida entera
       es lo que convierte una animacion en un peaje. */
    translate: 0 100%;
    transition:
      translate 220ms cubic-bezier(0.4, 0, 0.9, 0.3),
      display 220ms allow-discrete,
      overlay 220ms allow-discrete;
  }

  /* ------------------------------------------------------------------------
     Abierta — y con ello, la ENTRADA
     ------------------------------------------------------------------------
     Sube desde el borde de abajo, que es de donde el gesto dice que viene una
     hoja. La curva arranca rapida y frena largo: llega enseguida y se posa, en
     lugar de chocar contra el borde.

     El <dialog> trae `display: none` cuando esta cerrado, asi que el flex solo
     aplica al abrirlo: por eso `[open]`.

     `@starting-style` es DE DONDE sale el movimiento. Sin el no hay entrada: el
     navegador pinta el primer fotograma con la hoja ya en su sitio y no queda
     nada que interpolar. */
  .sheet[open] {
    display: flex;
    translate: 0 0;
    transition:
      translate 360ms cubic-bezier(0.32, 0.72, 0, 1),
      display 360ms allow-discrete,
      overlay 360ms allow-discrete;
  }
  @starting-style {
    .sheet[open] {
      translate: 0 100%;
    }
  }

  /* El velo acompana a la hoja en los dos sentidos. Encender de golpe una sombra
     sobre toda la pagina es la mitad del sobresalto que produce un modal; que
     suba y baje con ella lo convierte en una capa que se corre, no en un susto.

     Se anima la opacidad y no el color para no tener que repetir aqui el valor de
     --sf-scrim con la alfa a cero: el token sigue siendo el unico sitio donde ese
     color esta escrito. */
  .sheet::backdrop {
    background-color: var(--sf-scrim);
    opacity: 0;
    transition:
      opacity 220ms ease,
      display 220ms allow-discrete,
      overlay 220ms allow-discrete;
  }
  .sheet[open]::backdrop {
    opacity: 1;
    transition:
      opacity 300ms ease,
      display 300ms allow-discrete,
      overlay 300ms allow-discrete;
  }
  @starting-style {
    .sheet[open]::backdrop {
      opacity: 0;
    }
  }

  /* Desktop: deja de ser una hoja y se centra, ya sin borde pegado abajo.
     Y con ello cambia el movimiento: una ventana centrada que sube desde abajo
     recorre media pantalla para nada. Aparece donde va a quedarse, creciendo
     desde un 97% —lo justo para que se lea como que llega, no como que estaba
     ya— y con un dedo de subida que le quita la rigidez. */
  @media (min-width: 768px) {
    .sheet {
      border-radius: 20px;
      margin: auto;

      translate: 0 8px;
      scale: 0.97;
      opacity: 0;
      transition:
        translate 160ms ease-in,
        scale 160ms ease-in,
        opacity 160ms ease-in,
        display 160ms allow-discrete,
        overlay 160ms allow-discrete;
    }
    .sheet[open] {
      translate: 0 0;
      scale: 1;
      opacity: 1;
      transition:
        translate 240ms cubic-bezier(0.2, 0.9, 0.3, 1),
        scale 240ms cubic-bezier(0.2, 0.9, 0.3, 1),
        opacity 180ms ease-out,
        display 240ms allow-discrete,
        overlay 240ms allow-discrete;
    }
    @starting-style {
      .sheet[open] {
        translate: 0 8px;
        scale: 0.97;
        opacity: 0;
      }
    }
  }

  /* Modifier: hoja ancha, SOLO en desktop.

     Las hojas de consulta —horario, direccion de la tienda— se leen de un vistazo
     y a 390 estan bien en cualquier pantalla. Esta es para la que no se consulta
     sino que se usa: el mapa de la ubicacion, donde 390 dejaba una ventanita por
     la que buscar una casa a base de arrastrar de a poco.

     En movil no aparece: alli la hoja ya ocupa el ancho de la pantalla y el
     modificador no tendria contra que ensancharse. */
  @media (min-width: 768px) {
    .sheet--wide {
      max-width: 640px;
    }
  }
  /* Element: cabecera — titulo a la izquierda, cierre a la derecha */
  .sheet__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  /* Element: titulo — Inter 600 16/24, el mismo de la barra superior */
  .sheet__title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    color: var(--sf-ink);
  }

  /* Element: cierre. Misma caja que el boton de copiar —32, radius 8— para que los
     botones de icono del proyecto se parezcan entre si. Gris en reposo: es una
     salida, no la accion de la hoja. */
  .sheet__close {
    display: inline-flex;
    flex: 0 0 32px;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: var(--sf-muted);
    transition: background-color 160ms ease, color 160ms ease;
  }
  .sheet__close:hover {
    background-color: var(--sf-body-bg);
    color: var(--sf-ink);
  }

  .sheet__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Element: parrafo explicativo dentro de una hoja. Misma tipografia que las notas
     del resto del sistema (Inter 400 14/20 gris): acompana a los controles de la
     hoja, no compite con su titulo. */
  .sheet__text {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: var(--sf-muted);
  }
</style>
