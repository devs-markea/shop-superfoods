---
import { freeShippingLabel } from '../lib/shipping.ts';

interface Props {
  remaining: number;
  progress: number;
}

const { remaining, progress } = Astro.props;

// Con el pedido vacio esta barra no se monta: lo decide la pantalla, que es quien
// sabe si hay lineas. Ver /mamayaya/carrito.
//
// Al alcanzar el umbral cambia el texto, no el color: el dorado de este label
// esta especificado en la spec y no depende del estado. La copia vive en
// src/lib/shipping.ts, porque el script la reescribe con cada cambio de cantidad
// y no puede decir otra cosa que esta.
const label = freeShippingLabel(remaining);
---

<section class="shipping-progress" aria-label="Progreso hacia el envio gratis">
  <p class="shipping-progress__label" data-shipping-label>{label}</p>

  <!--
    .progress es la pista y .progress-bar el relleno: Bootstrap ya trae el alto
    de 6, el radius de 3 y los dos colores desde .progress.
  -->
  <div
    class="progress"
    role="progressbar"
    aria-label="Avance del pedido hacia el envio gratis"
    aria-valuenow={progress}
    aria-valuemin="0"
    aria-valuemax="100"
    data-shipping-progress
  >
    <div class="progress-bar" style={`width: ${progress}%`}></div>
  </div>
</section>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: shipping-progress  (barra sobre .progress de Bootstrap)
     ---------------------------------------------------------------------------
     Aviso de cuanto falta para el envio gratis.
     Spec: height 70 - gap 12 - padding 16 - radius 16
     background #D5AA531A (el dorado al 10%, = --sf-gold-tint)
     16 + 20 (label) + 12 (gap) + 6 (barra) + 16 = 70

     La pista y el relleno los aportan .progress y .progress-bar.
     --------------------------------------------------------------------------- */
  .shipping-progress {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 70px;
    padding: 16px;
    border-radius: 16px;
    background-color: var(--sf-gold-tint);
  }

  /* Element: aviso — Inter 600 14/20, #D5AA53
     Este label es dorado siempre, tambien cuando ya se alcanzo el envio gratis:
     solo cambia el texto. El color esta especificado por label, no por estado. */
  .shipping-progress__label {
    /* Sin esto el Reboot de Bootstrap le pone margin-bottom: 1rem a los <p>, que
       se suma al gap de 12 del contenedor y lo estira de 70 a 86. */
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    color: var(--sf-gold);
  }
</style>
