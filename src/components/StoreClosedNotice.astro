---
import Icon from './Icon.astro';
import { nextOpeningDay, type StoreSchedule } from '../lib/schedule.ts';

interface Props {
  schedule: StoreSchedule;
}

const { schedule } = Astro.props;

// Aviso de tienda cerrada: la tarjeta que explica por que no se puede pedir.
//
// Lo pinta la pantalla que lo necesita —la portada y el pedido—, nunca el layout:
// del pedido en adelante el flujo ya no se puede continuar, asi que repetir el
// aviso alli seria decir dos veces lo mismo en pantallas donde ya no hay nada que
// decidir. Quien lo pinte comprueba `isClosed(schedule)` antes.
//
// Flota sobre el contenido y no ocupa hueco en el flujo: aparecer no recoloca la
// pantalla que hay debajo. La posicion la resuelve el bloque, en
// los estilos de este archivo.
//
// Tres frases y una salida, en este orden:
//
//   1. cuando se vuelve            (negro, es el dato que se busca)
//   2. que se puede hacer mientras (gris, es la consecuencia)
//   3. que dia abre                (negro, desambigua el "a las 09:00" de arriba)
//   4. el horario completo         (boton, abre la hoja del reloj)
//
// El boton abre la MISMA hoja que el reloj de la cabecera (`sheet-schedule`), asi
// que el horario completo se lee en un solo sitio. Quien monte esta tarjeta se
// asegura de que esa hoja este en la pagina: en la portada la pone la cabecera, y
// en el pedido, que no la tiene, la monta la propia pantalla.
const openingTime = schedule.opensAt?.time ?? null;
const openingDay = nextOpeningDay(schedule);

// Sin proxima apertura —cerrada sin ningun turno por delante— no se promete una
// hora que no existe: queda el que y el mientras tanto, sin el cuando.
const title = openingTime ? `Regresamos a las ${openingTime}` : 'Estamos cerrados';
const opening = openingTime && openingDay ? `Abrimos ${openingDay} a las ${openingTime}` : null;

// Sin dias que ensenar, la hoja del horario abriria en blanco: mejor sin boton.
const hasSchedule = schedule.days.length > 0;
---

<aside class="store-closed" aria-label="Tienda cerrada">
  <div class="store-closed__card" role="status">
    <p class="store-closed__title">
      <Icon name="clock" size="sm" />
      <span>{title}</span>
    </p>

    <p class="store-closed__text">
      Los pedidos estan deshabilitados. Solo podras ver el menu.
    </p>

    {opening && <p class="store-closed__opening">{opening}</p>}

    {
      hasSchedule && (
        <button
          class="store-closed__action btn-plain"
          type="button"
          aria-haspopup="dialog"
          data-sheet="sheet-schedule"
        >
          Ver horarios
        </button>
      )
    }
  </div>
</aside>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: store-closed
     ---------------------------------------------------------------------------
     Tarjeta flotante de tienda cerrada. La montan la portada y el pedido; el resto
     de pantallas no la ven porque desde ahi el flujo ya no continua.

     Flota, no empuja: `position: fixed` lo saca del flujo, de modo que aparecer y
     desaparecer no recoloca nada de lo que hay debajo.

     Va anclada abajo y no arriba porque las cabeceras cambian de alto en cada
     pantalla —navbar de 48, topbar de 48, 64 o 124— y solo la del listado es
     sticky: cualquier posicion fija arriba taparia el titulo de alguna.

     Superficie blanca y texto negro/gris, no el dorado de .info-note: aquello es un
     apunte al margen y esto es el estado de la tienda, con su propia salida hacia el
     horario. Se lee como una hoja pequena —radius 20, sombra— porque eso es: una
     pieza que se sobrepone al contenido.
     --------------------------------------------------------------------------- */
  .store-closed {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 1030;
    padding: 0 20px calc(16px + env(safe-area-inset-bottom, 0px));
    /* El envoltorio no intercepta el toque —debajo hay catalogo—; la tarjeta si, que
       lleva boton. */
    pointer-events: none;
  }

  /* La sangria lateral es la de la pagina, que de md en adelante pasa de 20 a 32.
     Solo el eje horizontal: el de abajo lo siguen decidiendo las reglas de mas
     abajo, segun si la pantalla tiene barra de accion. */
  @media (min-width: 768px) {
    .store-closed {
      padding-inline: 32px;
    }
  }

  /* Pantallas con barra de accion: la tarjeta se apoya encima en lugar de taparla.
     La barra es la accion principal de la pantalla y ocupa el borde inferior; el
     safe-area se suma porque la barra lo lleva en su propio padding y crece con el. */
  .page:has(.action-bar) .store-closed {
    bottom: calc(84px + env(safe-area-inset-bottom, 0px));
    padding-bottom: 16px;
  }

  /* Barra de accion con aviso bajo el boton: crece lo que mide esa nota —12 de
     separacion mas una linea de 16— y la tarjeta sube lo mismo. La cuenta asume la
     nota en una linea, que es como esta escrita la copia. */
  .page:has(.action-bar__note) .store-closed {
    bottom: calc(84px + 12px + 16px + env(safe-area-inset-bottom, 0px));
  }

  /* Element: la tarjeta. En movil ocupa el ancho util entre gutters; el tope de 480
     es para que en pantallas grandes no se quede en una pastilla suelta en medio del
     catalogo. Es tambien el ancho al que la frase de en medio cabe en una linea. */
  .store-closed__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    max-width: 480px;
    margin-inline: auto;
    padding: 20px;
    border-radius: 20px;
    background-color: var(--sf-white);
    box-shadow: 0 4px 12px 0 rgb(0 0 0 / 8%);
    pointer-events: auto;
  }

  /* Element: titulo — Inter 600 16/24 sobre negro. El reloj es el mismo icono que
     abre el horario en la cabecera: quien quiera el detalle sabe donde mirar. */
  .store-closed__title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    color: var(--sf-ink);
  }

  /* Element: consecuencia — Inter 400 14/20 en gris. Es la letra de servicio: dice
     que se puede hacer mientras, y no compite con el dato de arriba. */
  .store-closed__text {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--sf-muted);
  }

  /* Element: dia de apertura — Inter 600 14/20 sobre negro. Vuelve al negro porque
     es dato, no explicacion: es lo que desambigua el "a las 09:00" del titulo. */
  .store-closed__opening {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    color: var(--sf-ink);
  }

  /* Element: salida hacia el horario completo. Alto y radius del boton del sistema,
     pero contorneado y en negro: con la tienda cerrada es la unica accion que queda,
     y pintarla dorada la haria pasar por la accion de comprar que justo se apago. */
  .store-closed__action {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    margin-top: 8px;
    border: 1px solid var(--sf-border);
    border-radius: 12px;
    background-color: var(--sf-white);
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    color: var(--sf-ink);
    transition: background-color 160ms ease;
  }
  .store-closed__action:hover {
    background-color: var(--sf-body-bg);
  }
  .store-closed__action:active {
    background-color: var(--sf-border);
  }
</style>
