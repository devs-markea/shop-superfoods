---
import SectionLabel from './SectionLabel.astro';
import { isCustomTip, TIP_MAX_DIGITS } from '../lib/tips.ts';

interface Props {
  /** Importe preseleccionado, en MXN. */
  selected?: number;
  /**
   * Importes que se ofrecen, ya normalizados por src/lib/tips.ts: enteros,
   * ordenados, sin repetidos y **con el 0 delante**. Sin ninguno no hay selector:
   * quien decide si se pide propina es el panel, no esta pantalla.
   */
  amounts: number[];
}

const { selected = 0, amounts } = Astro.props;

// La spec los rotula sin decimales ("$0", no "$0.00"), a diferencia del resto
// de importes del proyecto: son botones estrechos y son cantidades redondas.
const amountLabel = (amount: number) => `$${amount}`;

// Si el importe que traemos no es ninguno de los botones, se escribio en "Otro":
// entonces esa opcion nace marcada y su campo, abierto y con el valor dentro. El
// panel se despliega sin JavaScript y sin parpadeo, porque el radio ya llega
// marcado del servidor y el CSS lee ese estado con :has().
const custom = isCustomTip(selected, amounts);
const customValue = custom ? String(selected) : '';

// Como el switch y los chips, son radios: la seleccion unica la garantiza el
// name compartido, sin JavaScript.
---

<div class="tip">
  <SectionLabel variant="strong" id="tip-label">Propina</SectionLabel>

  <div class="tip__options" role="group" aria-labelledby="tip-label">
    {
      amounts.map((amount) => (
        <>
          {/* El aria-label del 0: "$0" se lee bien con los ojos, entre otros
              importes y bajo el rotulo "Propina", pero suelto en un lector de
              pantalla no dice nada. Y es justo la opcion que hay que poder
              encontrar. */}
          <input
            class="btn-check"
            type="radio"
            name="tip"
            id={`tip-${amount}`}
            value={amount}
            checked={amount === selected}
            autocomplete="off"
            aria-label={amount === 0 ? 'Sin propina' : undefined}
            data-tip
          />
          <label class="tip__option" for={`tip-${amount}`}>
            {amountLabel(amount)}
          </label>
        </>
      ))
    }

    {/*
      "Otro" ya no es un boton que suma 0: su `value` ES el importe libre, y lo
      mantiene al dia el script conforme se teclea. Asi el resto del flujo no se
      entera de que existe un campo —el total, el borrador y el checkout siguen
      leyendo el radio marcado, como con cualquier otro importe—.

      Nace vacio, que para parseTipAmount() es "todavia no hay importe" y se
      resuelve como 0: elegir "Otro" y no escribir nada no cobra nada.
    */}
    <input
      class="btn-check"
      type="radio"
      name="tip"
      id="tip-custom"
      value={customValue}
      checked={custom}
      autocomplete="off"
      data-tip
      data-tip-custom
    />
    <label class="tip__option" for="tip-custom" data-tip-custom-label>Otro</label>
  </div>

  {/*
    El campo del importe libre. Vive fuera de .tip__options —que es la fila de
    botones— y se abre y se cierra con la opcion "Otro". Ver los estilos de este archivo:
    la animacion es de CSS y la dispara el propio radio, no una clase.
  */}
  <div class="tip__custom">
    <div class="tip__custom-clip">
      <div class="tip__custom-body">
        {/* Como en /datos: la etiqueta se oculta en movil —donde rotula el
            placeholder— y se pinta de md hacia arriba, pero existe siempre para
            que el campo llegue nombrado al lector de pantalla. */}
        <label class="field-label" for="tip-amount">Otra cantidad</label>

        <div class="tip__amount">
          <span class="tip__amount-currency" aria-hidden="true">$</span>

          {/*
            `text` con teclado numerico, y no `type="number"`: el numerico trae
            la rueda del raton, las flechitas y acepta "e", "+" y comas segun el
            navegador, y cuando lo escrito no le cuadra devuelve `value` vacio —o
            sea, la propina desaparece mientras se corrige—. Aqui solo hacen
            falta digitos, y de esos se encarga el script.
          */}
          <input
            class="tip__amount-input"
            type="text"
            id="tip-amount"
            inputmode="numeric"
            pattern="[0-9]*"
            maxlength={TIP_MAX_DIGITS}
            placeholder="Otra cantidad"
            autocomplete="off"
            value={customValue}
            data-tip-amount
          />
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: tip  (opciones sobre .btn-check de Bootstrap)
     ---------------------------------------------------------------------------
     Propina: etiqueta + importes excluyentes + el campo del importe libre.
     Como el switch y los chips, son radios: la seleccion unica la garantiza el
     name compartido, sin JavaScript.

     Spec: componente 350 - gap 12 (etiqueta / fila)
     boton 81.5x40 - padding vertical 10 - radius 12
     inactivo: bg #FFFFFF - borde 1px #EAECF0 - label #6C757D
     activo:   bg dorado  - label #FFFFFF

     El gap de la fila no viene en la spec, pero se deduce: 350 - 4x81.5 = 24,
     repartido en 3 huecos = 8. Los botones usan flex en lugar de un ancho fijo,
     asi reparten el ancho disponible y a 350 miden exactamente 81.5.
     --------------------------------------------------------------------------- */
  .tip {
    /* Un solo movimiento para el panel del importe libre: la misma curva y la
       misma duracion para plegar, desplazar y desvanecer, y en los dos sentidos.
       Ver .tip__custom, mas abajo. */
    --tip-reveal-duration: 260ms;
    /* Arranca decidida y frena largo: es la que hace que el panel parezca que se
       desliza en lugar de estirarse. */
    --tip-reveal-ease: cubic-bezier(0.32, 0.72, 0, 1);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Cuantos botones hay lo decide el negocio: la spec dibuja cuatro, pero con el 0
     delante y "Otro" detras la lista de la API se queda hoy en cinco y podria ser
     alguno mas. Se reparten SIEMPRE el ancho de la fila —`flex: 1 1 0` sobre una
     base de cero, abajo—, que es lo que mantiene la fila cuadrada sea cual sea el
     numero: a cuatro botones cada uno mide los 81.5 de la spec, a cinco 63.6, y
     ninguno se queda del tamano de su texto con el hueco al lado. */
  .tip__options {
    display: flex;
    gap: 8px;
  }

  .tip__option {
    display: inline-flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    height: 40px;
    min-width: 0;
    padding-block: 10px;
    padding-inline: 4px;
    border: 1px solid var(--sf-border);
    border-radius: 12px;
    background-color: var(--sf-white);
    color: var(--sf-muted);
    white-space: nowrap;
    user-select: none;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }
  .tip__option:hover {
    border-color: var(--sf-gold);
    color: var(--sf-ink);
  }

  /* Estado: importe elegido */
  .btn-check:checked + .tip__option, .btn-check:checked + .tip__option:hover {
    border-color: var(--sf-gold);
    background-color: var(--sf-gold);
    color: var(--sf-white);
  }

  .btn-check:focus-visible + .tip__option {
    outline: 2px solid var(--sf-gold);
    outline-offset: 2px;
  }

  /* ---------------------------------------------------------------------------
     Element: tip__custom  (el campo del importe libre)
     ---------------------------------------------------------------------------
     Se abre al elegir "Otro" y se cierra al elegir cualquier otro importe. Lo
     dispara el propio radio, leido con :has(), como el relevo de la barra de
     pedido en components/OrderMeta.astro: el estado sigue en el DOM, no en una clase, asi
     que el panel ya esta abierto —o cerrado— en el primer pintado, antes de que
     cargue ningun script, y al volver de la pantalla de transferencia no hay
     parpadeo.

     La altura se anima con la rejilla de 0fr a 1fr y no con `max-height`: no hay
     numero magico que mantener, el recorrido es exactamente el alto del contenido
     y no hay el tramo muerto del final que deja un max-height generoso.

     El margen negativo cancela el gap de .tip mientras esta cerrado. Sin el, un
     panel de alto 0 seguiria separando 12 de la fila de botones, y quedaria un
     hueco permanente debajo de un componente que no muestra nada.

     `visibility` saca el campo del recorrido del tabulador y del arbol de
     accesibilidad cuando esta cerrado —un campo invisible pero enfocable es una
     trampa—, y su transicion de 0s retrasada al final deja que la salida se vea
     entera antes de desaparecer.

     TRES CAPAS, Y CADA UNA HACE UNA COSA. Sale mas marcado del que parece pedir un
     campo, pero las tres son necesarias y no se pueden juntar:

     tip__custom       pliega (la rejilla de 0fr a 1fr)
     tip__custom-clip  recorta, para que lo que todavia no cabe no se salga
     tip__custom-body  desliza y desvanece

     El deslizamiento no puede ir en la capa que recorta, porque moverla mueve
     tambien su recorte y el contenido asomaria por fuera del pliegue. Separadas,
     el cuerpo entra desde debajo del borde y el recorte lo va destapando.

     LO QUE ARRASTRA AL RESTO DE LA PANTALLA. El bloque de "Metodo de pago" es
     hermano de .tip en la columna de .screen-body, asi que baja y sube empujado
     por este pliegue: su recorrido ES esta transicion, con su misma curva y su
     misma duracion, sin transicion propia que declarar. Por eso lo que se sentia
     duro no era que le faltara animacion, sino que aqui habia DOS: el contenido se
     desvanecia en 140ms mientras el hueco tardaba 220ms en cerrarse, y al salir
     quedaban 80ms de vacio plegandose sobre nada. Ahora las tres capas comparten
     duracion y curva en los dos sentidos, que es lo que hace que el bloque de
     abajo acompane en lugar de dar el tiron del final.
     --------------------------------------------------------------------------- */
  .tip__custom {
    display: grid;
    grid-template-rows: 0fr;
    margin-block-start: calc(12px * -1);
    visibility: hidden;
    transition: grid-template-rows var(--tip-reveal-duration) var(--tip-reveal-ease), margin-block-start var(--tip-reveal-duration) var(--tip-reveal-ease), visibility 0s linear var(--tip-reveal-duration);
  }

  .tip:has(#tip-custom:checked) .tip__custom {
    grid-template-rows: 1fr;
    margin-block-start: 0;
    visibility: visible;
    transition: grid-template-rows var(--tip-reveal-duration) var(--tip-reveal-ease), margin-block-start var(--tip-reveal-duration) var(--tip-reveal-ease), visibility 0s;
  }

  /* El recorte que hace posible el 0fr: sin el, el contenido se sale por debajo
     en lugar de plegarse. Va en su propia capa para que el campo pueda tener
     dentro su indicador de foco sin que se lo coman (ver .tip__amount). */
  .tip__custom-clip {
    min-height: 0;
    overflow: hidden;
  }

  /* El cuerpo: entra deslizandose desde debajo del borde de arriba, que es de
     donde se esta abriendo el hueco, y sale por el mismo sitio. Los 8 son un
     apunte, no un viaje: el recorrido de verdad lo hace el pliegue, y este solo
     evita que el contenido aparezca ya colocado dentro de una caja que crece. */
  .tip__custom-body {
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity var(--tip-reveal-duration) var(--tip-reveal-ease), transform var(--tip-reveal-duration) var(--tip-reveal-ease);
    /* De md hacia arriba la etiqueta vuelve a la pagina (ver .field-label en
       mas abajo en este archivo) y hay que separarla del campo, con el mismo 8 que usan los
       grupos de /datos. En movil no hace falta: alli la etiqueta esta recortada
       fuera de flujo y el unico hijo con altura es el campo. */
  }
  @media (min-width: 768px) {
    .tip__custom-body {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
  }

  .tip:has(#tip-custom:checked) .tip__custom-body {
    opacity: 1;
    transform: none;
  }

  /* ---------------------------------------------------------------------------
     Element: tip__amount  (el "$" y el campo, como un solo control)
     ---------------------------------------------------------------------------
     El borde lo lleva el envoltorio y no el input, que es lo que hace que el "$"
     se vea dentro del campo y no al lado. Las medidas son las de .field —44 de
     alto, borde de 2, radius 12, padding 16—, porque es el mismo campo de una
     linea del resto del checkout, solo que con adorno.
     --------------------------------------------------------------------------- */
  .tip__amount {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 44px;
    padding-inline: 16px;
    border: 2px solid var(--sf-border);
    border-radius: 12px;
    background-color: var(--sf-white);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  /* El foco se pinta DENTRO. El anillo de la tienda —outline de 2 con offset de
     2— sobresale 4 del borde, y aqui arriba hay un `overflow: hidden` que se lo
     comeria: quien escribe con teclado se quedaria sin saber donde esta. Con el
     borde y una sombra interior el indicador ocupa el mismo sitio, se ve igual de
     claro y no depende de que nadie recorte nada. */
  .tip__amount:focus-within {
    border-color: var(--sf-gold);
    box-shadow: inset 0 0 0 1px var(--sf-gold);
  }

  .tip__amount-currency {
    font-weight: 600;
    color: var(--sf-ink-soft);
  }

  /* Sin .form-control detras, asi que la tipografia se declara: los campos no
     heredan la de la pagina, y sin esto el importe saldria con la fuente del
     sistema al lado de un "$" que si es Inter. */
  .tip__amount-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    background-color: transparent;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--sf-ink);
    /* Lo pinta el envoltorio, arriba. */
  }
  .tip__amount-input:focus, .tip__amount-input:focus-visible {
    outline: none;
    box-shadow: none;
  }
  .tip__amount-input::placeholder {
    font-weight: 600;
    color: var(--sf-ink-soft);
  }

  /* ---------------------------------------------------------------------------
     Block: field-label  (copia)
     ---------------------------------------------------------------------------
     La etiqueta de "Otra cantidad" es la misma pieza que rotula los campos de
     /datos, pero esta pantalla no monta ningun <TextField>, que es donde vive la
     familia .field-*. Asi que se copia aqui lo justo que usa este componente.

     Son las dos unicas reglas del bloque: en movil la etiqueta existe pero no se
     pinta —la rotula el placeholder— y de md hacia arriba vuelve a la pagina.
     No se apoya en .visually-hidden de Bootstrap porque esa clase lo declara todo
     con !important y no habria forma de deshacerla en un breakpoint.

     Si algun dia esta pantalla monta un <TextField>, esta copia sobra.
     --------------------------------------------------------------------------- */
  .field-label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .field-label {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip-path: none;
      white-space: normal;
      font-size: 14px;
      font-weight: 600;
      line-height: 1;
      color: var(--sf-ink);
    }
  }
</style>
