---
import { Font } from 'astro:assets';

// El orden es obligatorio: no reordenar.
//
// 1. Bootstrap ya compilado. Antes se importaba por partes desde su Sass, para
//    no enviar los componentes sin usar; sin Sass eso ya no se puede hacer y se
//    carga entero.
// 2. Los colores de la tienda, que usan tanto los overrides como los bloques.
// 3. Los overrides, que ajustan Bootstrap a la spec de la tienda.
// 4. La base propia, que necesita ir despues de las utilidades de Bootstrap.
// 5. El armazon de las pantallas del pedido: los dos unicos bloques que no
//    tienen un componente donde vivir.
//
// El resto de bloques —la gran mayoria— vive en el <style> de su componente.
//
// La unica capa de variables es la de color. Lo demas —radios, huecos, tamanos,
// sombras— va escrito en cada bloque, para que corregir un componente sea abrir
// su archivo y cambiar el numero.
import 'bootstrap/dist/css/bootstrap.min.css';
import '../styles/colors.css';
import '../styles/bootstrap-overrides.css';
import '../styles/base.css';
import '../styles/screens.css';

interface Props {
  title: string;
  description?: string;
  /**
   * Fuera de los buscadores.
   *
   * Lo piden las siete pantallas del pedido —el carrito, los datos de entrega,
   * las tres del pago y los dos acuses—, que no son contenido de la tienda sino
   * la sesion de una persona: su carrito, su direccion, su pedido. No hay
   * ninguna version de ellas que le sirva a quien llegue desde una busqueda, y
   * lo que un rastreador puede sacar es un carrito vacio o una redireccion al
   * menu.
   */
  noindex?: boolean;
}

const {
  title,
  description = 'Shop Superfoods — pedido a domicilio o para recoger.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: la action-bar usa env(safe-area-inset-bottom) -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {
      /*
        Las dos caras de la misma decision, y por eso van juntas.

        Indexable: el canonical dice cual es la URL buena de esta pagina y las
        etiquetas Open Graph, como se ve cuando alguien la comparte.

        Fuera del indice: nada de eso, porque las tres existen para que las
        consuma un tercero. Lo que se emite es `noindex`, que saca la pagina de
        los resultados, y `nofollow`, porque de una pantalla de pedido no sale
        ningun enlace que un buscador tenga que seguir —los del menu y el pie
        llegan por su cuenta desde la portada—.

        Se emite la etiqueta y NO se bloquea en robots.txt: son cosas distintas
        y solo esta saca del indice. Ver public/robots.txt, donde esta escrito
        por que.
      */
    }
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <Fragment>
          <link rel="canonical" href={canonical} />

          <meta property="og:type" content="website" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
        </Fragment>
      )
    }

    <Font cssVariable="--sf-font-inter" preload />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="page">
    <slot />
  </body>
</html>
