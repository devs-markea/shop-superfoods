---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import NavbarDesktop from '../components/NavbarDesktop.astro';
import ShippingProgress from '../components/ShippingProgress.astro';
import OrderComments from '../components/OrderComments.astro';
import CartSummary from '../components/CartSummary.astro';
import ActionBar from '../components/ActionBar.astro';
import ScheduleSheet from '../components/ScheduleSheet.astro';
import LocationSheet from '../components/LocationSheet.astro';
import StoreClosedNotice from '../components/StoreClosedNotice.astro';
import Footer from '../components/Footer.astro';
import {
  getCart,
  remainingForFreeShipping,
  shippingProgress,
  type Cart,
} from '../lib/cart.ts';
import { imageResolver, renderLines } from '../lib/cart-view.ts';
import { assetBase } from '../lib/api.ts';
import { resolveCartToken } from '../lib/cart-session.ts';
import { quoteForDraft } from '../lib/shipping-quote.ts';
import { DRAFT_COOKIE, parseDraft } from '../lib/checkout-draft.ts';
import { getStoreConfig, getStoreSchedule } from '../lib/store-config.ts';
import { ALL_CATEGORIES, getCategories, getProducts } from '../lib/catalog.ts';
import { resolveShipping } from '../lib/shipping.ts';
import { isClosed } from '../lib/schedule.ts';
import { formatPrice } from '../lib/price.ts';

// DOS PANTALLAS, UN MARCADO
//
// En movil el pedido es el de siempre: la barra de 48 con el total, la columna
// con las lineas y los comentarios, y "Continuar" en la barra fija del fondo.
//
// En desktop crece por arriba y por abajo —la misma barra de tienda y el mismo
// pie que la portada y la ficha— y por dentro se parte en dos columnas: el pedido
// a la izquierda y la tarjeta de resumen a la derecha, que es la que cierra la
// cuenta y continua el flujo. Alli la barra del fondo no se pinta. Nada de eso
// duplica marcado —son los mismos elementos recolocados por CSS, ver
// styles/screens.css— salvo la tarjeta, que es una pieza nueva y de
// desktop entera.

// El carrito es de esta sesion: no hay nada que prerenderizar.
export const prerender = false;

let cart: Cart | null = null;
let unreachable = false;

// El catalogo, solo para los tres rotulos de categoria del pie. Se pide a la vez
// que el carrito y si falla el pie se queda con "Menu completo": son tres rotulos
// de un pie, no el contenido de la pantalla.
const categoriesPending = getProducts()
  .then((items) => getCategories(items).filter((category) => category !== ALL_CATEGORIES))
  .catch((error) => {
    console.error('[pedido] fallo el catalogo del pie', error);
    return [] as string[];
  });

try {
  // resolveCartToken emite la cookie si es la primera visita, asi que llegar
  // aqui directo (sin pasar por una ficha) tambien deja sesion abierta.
  cart = await getCart(resolveCartToken(Astro.cookies));
} catch (error) {
  console.error('[pedido] fallo GET /api/cart', error);
  unreachable = true;
}

const total = cart?.total ?? 0;
const discountTotal = cart?.discountTotal ?? 0;
const subtotal = cart?.subtotal ?? 0;

// Se pinta `lines`, no `items`: un grupo de "compra y lleva" toma unidades de
// varias filas, asi que la fila deja de ser la unidad de presentacion. El
// mismo renderizador lo reutiliza src/scripts/order-summary.ts en cada
// respuesta de la API, para que servidor y navegador no puedan divergir.
const lines = cart?.lines ?? [];
const base = assetBase();
const linesHtml = cart ? renderLines(cart, imageResolver(base)) : '';

// El borrador del pedido: lo que se ha ido reuniendo hasta aqui.
//
// Los comentarios ya escritos, para que volver desde el pago no los pierda; y el
// modo de entrega y la cotizacion del envio, que son lo que la tarjeta de resumen
// necesita para cerrar la cuenta. Nada de esto se reenvia a /datos: la cookie la
// lee el servidor en cada peticion, asi que la siguiente pantalla la recibe entera
// sin que el carrito tenga que pasarle nada. Un dato copiado aqui solo podria
// contradecir al original.
const draft = parseDraft(Astro.cookies.get(DRAFT_COOKIE)?.value);
const pickup = draft.deliveryType === 'pickup';

// El envio de este borrador: el del borrador, o el que la API guarde para esta
// sesion si la cookie lo perdio —dura dos horas, y el navegador la vacia de mas
// maneras de las que parece—. Sin ubicacion compartida no hay ninguno, que aqui es
// el caso normal: la ubicacion se comparte en /datos. Ver
// src/lib/shipping-quote.ts.
const quotePending = quoteForDraft(draft, resolveCartToken(Astro.cookies));

// El envio gratis lo decide el negocio, y son tres respuestas distintas:
//
//   threshold  hay meta que alcanzar -> se pinta la barra
//   always     ya es gratis           -> no hay nada que avanzar
//   none       no hay envio gratis    -> no se promete lo que no existe
//
// El umbral viaja en data-threshold para que el script recalcule el avance con el
// total que devuelve cada operacion de carrito, y el modo en data-free-shipping,
// que es lo que le falta para volver a resolver el envio de la tarjeta: cruzar el
// umbral con un "+" cambia el importe a "Gratis" sin recargar.
const [store, schedule, categories, quote] = await Promise.all([
  getStoreConfig(),
  getStoreSchedule(),
  categoriesPending,
  quotePending,
]);

const { freeShipping } = store.delivery ?? {};
const threshold = freeShipping?.mode === 'threshold' ? (freeShipping.threshold ?? 0) : 0;

// Dos condiciones, y la segunda es del pedido, no del negocio: con el carrito
// vacio no hay avance que ensenar. El envio gratis se gana llegando a un importe,
// asi que una barra en cero delante de un pedido sin nada solo puede decir dos
// cosas, y las dos son falsas: que ya se esta avanzando, o que basta agregar algo
// para conseguirlo. Se pinta cuando hay pedido que medir.
const showProgress = threshold > 0 && lines.length > 0;

// El envio de la tarjeta. Aqui todavia suele estar "Por cotizar" —la ubicacion se
// comparte en /datos, que es donde se mide la distancia—, pero las otras tres
// respuestas tambien se dan: al recoger no hay envio, el negocio puede regalarlo,
// y volver atras desde el pago trae la distancia ya medida en el borrador.
const shipping = resolveShipping({
  pickup,
  quote,
  products: total,
  freeShipping,
});

// Las dos condiciones se calculan aqui, en el mismo sitio que monta las hojas: si
// las dedujera la barra de desktop por su cuenta, podria ofrecer un boton para una
// hoja que esta pantalla no monto. Es lo mismo que hacen <Navbar> en la portada y
// la ficha en la suya.
const address = store.location?.address;
const mapsUrl = store.location?.mapsUrl;
const hasLocation = Boolean(address || mapsUrl);
const hasSchedule = Boolean(schedule && schedule.days.length > 0);

// Ultima pantalla donde el aviso sirve de algo: aqui todavia hay una decision que
// tomar —seguir o no—, y de aqui en adelante ya no. El pedido no se pierde: sigue
// en la sesion, y continuar vuelve a estar disponible cuando la tienda abra.
const closed = isClosed(schedule);
---

<Layout title="Mi pedido — Shop Superfoods" description="Revisa tu pedido antes de pagar." noindex>
  {/* Una cabecera por pantalla: la barra de 48 con el total en movil, y de md
      hacia arriba la barra de la tienda, la misma de la portada y de la ficha. */}
  <TopBar title="Mi pedido" total={total} mobileOnly />

  <NavbarDesktop
    shortAddress={store.location?.shortAddress}
    estimate={store.delivery?.estimate}
    hasLocation={hasLocation}
    hasSchedule={hasSchedule}
    cartTotal={total}
    cartCount={cart?.itemsCount ?? 0}
  />

  <!-- La cadena flex (page > main > form) deja la barra de accion al fondo de
       la pantalla aunque el pedido tenga pocas lineas. -->
  <main class="checkout-page d-flex flex-column flex-grow-1">
    {/* La pila y la rejilla solo existen en desktop —en movil son `display:
        contents`, ver styles/screens.css—, asi que envolver no cambia
        nada de lo que ya habia. */}
    <div class="checkout-page__stack">
      <h1 class="checkout-page__title">Mi pedido</h1>

      <!-- El formulario envuelve tambien la barra de accion: "Continuar" envia
           el pedido junto con los comentarios. Y en desktop es ademas la rejilla
           de dos columnas, para que la tarjeta caiga dentro de [data-order-summary]
           y el script pueda repintarla con cada respuesta de la API. -->
      <form
        class="checkout-page__grid"
        action="#"
        method="post"
        data-order-summary
        data-threshold={threshold}
        data-free-shipping={freeShipping?.mode ?? 'none'}
        data-asset-base={base}
      >
        {/* Contenedor 1: el pedido. */}
        <div class="screen-body">
          {
            showProgress && (
              <ShippingProgress
                remaining={remainingForFreeShipping(total, threshold)}
                progress={shippingProgress(total, threshold)}
              />
            )
          }

          <!-- set:html y no un componente por linea: ver la cabecera de
               src/lib/cart-view.ts. Los grupos se rehacen enteros en cada cambio,
               asi que la lista se sustituye completa con el mismo marcado. -->
          <ul
            class:list={['order-list', 'list-unstyled', lines.length === 0 && 'd-none']}
            data-order-list
            set:html={linesHtml}
          />

          <p class:list={['text-secondary', 'text-center', 'm-0', lines.length > 0 && 'd-none']} data-empty>
            {unreachable ? 'No pudimos cargar tu pedido. Intentalo de nuevo.' : 'Tu carrito esta vacio.'}
          </p>

          <!-- Lo rellena el script cuando la API rechaza un cambio. -->
          <p class="order-list__error" role="alert" hidden data-cart-error></p>

          <!-- Solo con descuento: sin el, el subtotal seria el total repetido.
               Es lo que cierra la cuenta de una promocion —cuanto costaba, cuanto
               se descuenta— porque el total vive arriba, en la barra.

               Solo en movil: en desktop no hay barra que complete, y la cuenta
               entera —con el envio y el total— la lleva la tarjeta de resumen. -->
          <dl
            class:list={['order-totals', 'd-md-none', discountTotal <= 0 && 'd-none']}
            data-order-totals
          >
            <div class="order-totals__row">
              <dt class="order-totals__term">Subtotal</dt>
              <dd class="order-totals__value" data-order-subtotal>{formatPrice(subtotal)}</dd>
            </div>
            <div class="order-totals__row order-totals__row--discount">
              <dt class="order-totals__term">Descuentos</dt>
              <dd class="order-totals__value" data-order-discount>
                {`− ${formatPrice(discountTotal)}`}
              </dd>
            </div>
          </dl>

          {/* La divisoria y los comentarios son una sola pieza: la raya esta ahi
              para separarlos del pedido, asi que si ellos no se pintan, ella
              tampoco tiene nada que separar.

              En desktop se retiran con el pedido vacio —una nota para el
              repartidor sobre un pedido que no existe no se puede escribir—, y en
              movil se quedan como estaban: el envoltorio no pinta nada alli. */}
          <div
            class:list={['checkout-page__notes', lines.length === 0 && 'checkout-page__notes--empty']}
          >
            <hr class="screen-body__divider" />

            <OrderComments value={draft.comments} />
          </div>
        </div>

        <!-- Tres casos, y el ultimo es el que no pinta barra:
             · con lineas          -> Continuar, apagado en gris si la tienda cerro
             · sin lineas, abierta -> Ver el menu, que es lo unico que queda por hacer
             · sin lineas, cerrada -> nada. Un pedido vacio con la tienda cerrada no
               tiene ninguna accion que ofrecer, y la tarjeta flotante ya dice por que
               y lleva al horario: una barra debajo solo competiria con ella.

             Los tres son de movil: en desktop la barra no se pinta nunca, porque la
             accion es el boton de la tarjeta —y con el pedido vacio ese boton esta
             apagado, que es lo que hay que decir: no hay pedido con el que seguir. -->
        {
          lines.length > 0 ? (
            <div class="checkout-page__action">
              <ActionBar label="Continuar" href="/datos" disabled={closed} />
            </div>
          ) : closed ? null : (
            <div class="checkout-page__action">
              <ActionBar label="Ver el menu" href="/" />
            </div>
          )
        }

        {/* Contenedor 2, solo desktop. Se pinta siempre —tambien con el pedido
            vacio, donde la cuenta es de ceros— porque es la columna de la derecha:
            aparecer y desaparecer con la primera linea agregada movería la pantalla
            entera. Lo que si cambia es su boton, que sin pedido no puede continuar
            con nada. */}
        <CartSummary
          subtotal={subtotal}
          discount={discountTotal}
          products={total}
          shipping={shipping}
          label="Continuar con la entrega"
          href="/datos"
          disabled={closed || lines.length === 0}
        />
      </form>
    </div>
  </main>

  {closed && schedule && <StoreClosedNotice schedule={schedule} />}

  {/* Las dos hojas que abren el pin y el reloj de la barra de desktop. La del
      horario la abre ademas el boton de la tarjeta de tienda cerrada, que es
      quien la pedia antes de que esta pantalla tuviera barra. */}
  {hasSchedule && schedule && <ScheduleSheet schedule={schedule} />}
  {hasLocation && <LocationSheet address={address} mapsUrl={mapsUrl} />}

  <Footer store={store} categories={categories} />
</Layout>

<script>
  import '../scripts/order-summary';
  import '../scripts/auto-grow';
  // Abre las hojas del horario y la ubicacion desde la barra de desktop y desde
  // la tarjeta de tienda cerrada.
  import '../scripts/sheet';
  // Los rotulos de "Descubre" del pie llevan a la portada con su categoria ya
  // filtrada, y el pase lo deja este script: la pantalla que monte el pie tiene
  // que importarlo. Ver src/lib/discover.ts.
  import '../scripts/footer-discover';
</script>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: order-list
     ---------------------------------------------------------------------------
     Lista de lineas del pedido. Spec: gap 20.
     --------------------------------------------------------------------------- */
  .order-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    transition: opacity 160ms ease;
  }

  /* La lista espera respuesta de la API. Se bloquea ENTERA y no solo la linea
     pulsada: en un "compra y lleva" un cambio de cantidad rehace los grupos, asi
     que la respuesta puede reordenar y renumerar cualquier otra linea. */
  .order-list[data-busy] {
    opacity: 0.5;
    pointer-events: none;
  }

  /* ---------------------------------------------------------------------------
     Block: order-totals — subtotal y descuentos. Solo con promociones aplicadas:
     el total vive en la barra superior, y sin descuento el subtotal seria ese
     mismo importe repetido.
     --------------------------------------------------------------------------- */
  .order-totals {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
  }

  .order-totals__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .order-totals__term {
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    color: var(--sf-muted);
  }

  .order-totals__value {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--sf-ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .order-totals__row--discount .order-totals__value {
    color: var(--sf-success);
  }

  /* Element: error — la API rechazo un cambio de cantidad o un borrado.
     Oculto por defecto con el atributo hidden. */
  .order-list__error {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--sf-indigo);
    text-align: center;
  }

  /* ---------------------------------------------------------------------------
     Block: order-item
     ---------------------------------------------------------------------------
     Linea del pedido: imagen 70x70 a la izquierda, cuerpo a la derecha.
     El cuerpo reparte en dos filas con space-between, asi que la fila de acciones
     queda alineada al pie de la imagen sin alturas fijas.

     Spec: imagen 70x70 radius 12 - cuerpo space-between - info gap 2
     El gap entre imagen y cuerpo no viene en la spec: se usa 12, el mismo que
     .product-card, que es la otra pareja imagen + texto del sistema.
     --------------------------------------------------------------------------- */
  .order-item {
    display: flex;
    gap: 12px;
  }

  /* Element: media — 70x70 anclada arriba */
  .order-item__media {
    flex: 0 0 70px;
    width: 70px;
    height: 70px;
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--sf-border);
  }

  .order-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Element: body — ocupa el resto y separa las dos filas */
  .order-item__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
    min-height: 70px;
  }

  /* Element: fila superior — info a la izquierda, precio a la derecha */
  .order-item__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .order-item__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  /* Element: title — nombre y, a su lado, la insignia de la promocion. El enlace
     se recorta antes de empujarla: la fila comparte ancho con el importe de la
     derecha, y en un movil no caben un nombre largo y una etiqueta. */
  .order-item__title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    min-width: 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    color: var(--sf-ink);
  }
  .order-item__title > a {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .order-item__badge {
    flex: 0 0 auto;
  }

  /* La personalizacion no trae spec tipografica: se usa el patron de texto
     secundario del sistema (12/16 #6C757D), igual que .option-group__label. */
  .order-item__custom {
    margin: 0;
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    color: var(--sf-muted);
  }

  /* Element: aviso de la linea. El de un "compra y lleva" incompleto va en dorado
     —es una oportunidad, no un dato—; el que explica que el resto de la fila ya
     esta en la promocion, en gris. */
  .order-item__hint {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    color: var(--sf-gold);
  }

  .order-item__hint--muted {
    color: var(--sf-muted);
  }

  /* Element: price — lo que se paga por la linea. Es el unico importe de la
     esquina: el precio de lista se compara abajo, junto a la papelera, donde hay
     sitio de sobra para los dos.

     Spec: #141821. A diferencia de .product-card__price (dorado), aqui el precio
     va en tinta: el dorado queda para el total del pedido y el aviso de envio. */
  .order-item__price {
    flex: 0 0 auto;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    color: var(--sf-ink);
    white-space: nowrap;
  }

  /* Element: pricing — el par de lista y final, solo cuando hay descuento. Ocupa
     el hueco que quedaba entre la papelera y el contador. */
  .order-item__pricing {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }

  .order-item__pricing-final {
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    color: var(--sf-gold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Element: fila inferior — papelera, el par de precios y, al fondo, la cantidad.
     El contador se empuja con margen automatico en lugar de con space-between: asi
     queda a la derecha lleve la fila dos elementos o tres. */
  .order-item__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .order-item__actions .stepper {
    margin-inline-start: auto;
  }

  .order-item__remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--sf-muted);
    border-radius: 8px;
    transition: color 160ms ease;
  }
  .order-item__remove:hover {
    color: var(--sf-ink);
  }

  /* Se repite en /carrito porque alli las unidades las pinta el JS
     (src/lib/cart-view.ts) y este componente no llega a montarse. Las dos
     pantallas nunca coinciden, asi que cada una carga una sola copia. */

  /* ---------------------------------------------------------------------------
     Block: stepper
     ---------------------------------------------------------------------------
     Control de cantidad: restar - cantidad - sumar.
     Spec: 87x28 - gap 12
     28 + 12 + ~7 (un digito) + 12 + 28 = 87. El ancho no se fija: con dos digitos
     el bloque crece en lugar de recortar el numero.

     Restar: 28x28, borde 1.5 dorado, fondo transparente, rectangulo 10x1.5.
     Sumar:  28x28, fondo dorado, "+" blanco.
     --------------------------------------------------------------------------- */
  .stepper {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 28px;
  }

  .stepper__button {
    display: inline-flex;
    flex: 0 0 28px;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    transition: background-color 160ms ease, opacity 160ms ease, transform 160ms ease;
  }
  .stepper__button:active {
    transform: scale(0.92);
  }
  /* El tope de unidades por opcion se ve: atenuado y sin respuesta al hover.
     Es la diferencia deliberada con el checkbox, que al llegar a su maximo de
     opciones ignora el clic sin ninguna senal. */
  .stepper__button:disabled {
    opacity: 0.4;
    transform: none;
    cursor: not-allowed;
  }

  /* Modifier: restar */
  .stepper__button--minus {
    border: 1.5px solid var(--sf-gold);
    background-color: transparent;
  }
  .stepper__button--minus:hover:not(:disabled) {
    background-color: var(--sf-gold-tint);
  }

  /* El menos es un rectangulo de 10x1.5, no un icono de trazo: a ese grosor el
     sistema de 20x20 con stroke 2 no da la medida de la spec. */
  .stepper__minus {
    display: block;
    width: 10px;
    height: 1.5px;
    background-color: var(--sf-gold);
  }

  /* Modifier: sumar */
  .stepper__button--plus {
    border: 0;
    background-color: var(--sf-gold);
    color: var(--sf-white);
  }
  .stepper__button--plus:hover:not(:disabled) {
    background-color: var(--sf-gold-hover);
  }

  /* Element: cantidad — Inter 600 14/20 */
  .stepper__value {
    min-width: 7px;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    color: var(--sf-ink);
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* Viene de la familia de promociones, que comparten la portada, la ficha, el
       pedido y el cierre. Cada consumidor lleva solo las piezas que pinta: en
       ninguna pantalla coinciden dos, asi que nadie carga la misma regla dos
       veces. Si se toca una, mirar quien mas la tiene.

       Van juntas aqui porque en el pedido las lineas las pinta el JS
       (src/lib/cart-view.ts) y ningun componente .astro llega a montarse. */

  /* Block: promo-badge — "15%", "$50", "2x1". La etiqueta la compone el backend. */
  .promo-badge {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border-radius: 100px;
    background-color: var(--sf-gold);
    color: var(--sf-white);
    font-size: 12px;
    font-weight: 700;
    line-height: 16px;
    white-space: nowrap;
  }

  .promo-badge__label {
    /* El numero es lo que se lee de lejos: el icono solo lo acompaña. */
    letter-spacing: 0.01em;
  }

  /* Modifier: sin icono y mas apretada, para las listas de texto del cierre. */
  .promo-badge--sm {
    padding: 0 8px;
  }

  /* Block: price-was — el precio de lista. Tachado, nunca subrayado: es la
     convencion universal y es lo que implementa la referencia del panel. */
  .price-was {
    color: var(--sf-muted);
    font-size: 12px;
    font-weight: 400;
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    white-space: nowrap;
  }

  /* ---------------------------------------------------------------------------
     Block: promo-group — el acordeon de un "compra y lleva" en el pedido.

     Un grupo NO es una linea del carrito: toma unidades de varias filas, y una
     misma fila puede aportar unidades al grupo y dejar otras fuera. Por eso el
     desglose se pinta por unidad: es lo unico que explica que hay dentro y cual
     sale gratis. Contar, en cambio, se cuenta una sola vez —ver el pie.
     --------------------------------------------------------------------------- */
  .promo-group {
    margin-top: 4px;
  }

  .promo-group__summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    color: var(--sf-gold);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    list-style: none; /* el triangulo del navegador no sigue el sistema */
  }
  .promo-group__summary::-webkit-details-marker {
    display: none;
  }
  /* Chevron propio, del mismo trazo que el resto de iconos. */
  .promo-group__summary::before {
    content: "";
    width: 6px;
    height: 6px;
    border: solid currentcolor;
    border-width: 0 1.5px 1.5px 0;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 160ms ease;
  }

  .promo-group[open] .promo-group__summary::before {
    transform: translateY(1px) rotate(-135deg);
  }

  .promo-group__units {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 8px 0 0;
  }

  .promo-unit {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    line-height: 16px;
  }

  /* Element: info — el platillo y, debajo, sus personalizaciones. Dos lineas
     porque son dos cosas distintas: que te llevas y como lo pediste. */
  .promo-unit__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  /* "Hamburguesa - Doble": el nombre con su variante al lado. En tinta, porque
     es lo que se lleva; las personalizaciones quedan en gris debajo. */
  .promo-unit__label {
    color: var(--sf-ink);
    font-weight: 500;
  }

  .promo-unit__options {
    color: var(--sf-muted);
    font-weight: 400;
  }

  .promo-unit__price {
    flex: 0 0 auto;
    color: var(--sf-ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* La unidad regalada lo es ENTERA —variante y personalizaciones—, asi que se
     rotula "GRATIS" a secas: no hay ningun resto que cobrar debajo. */
  .promo-unit__free {
    flex: 0 0 auto;
    padding: 0 8px;
    border-radius: 100px;
    background-color: var(--sf-success-tint);
    color: var(--sf-success);
    font-weight: 700;
    white-space: nowrap;
  }

  /* Los controles NO viven aqui dentro: debajo del acordeon va un unico
     .order-item__actions —papelera, par de precios y contador— igual que en una
     linea con descuento. Uno solo, aunque el grupo junte varias configuraciones:
     las tres tarjetas del pedido se cuentan igual, y el acordeon queda como lo
     que es, informativo, plegable sin llevarse por delante como cambiar el pedido. */
</style>
