---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import OrderBar from '../components/OrderBar.astro';
import ProductCard from '../components/ProductCard.astro';
import { categories, products } from '../data/products.ts';
---

<Layout title="Shop Superfoods">
  <Navbar />

  <main>
    <OrderBar categories={categories} />

    <section class="product-list" aria-label="Productos">
      <div class="product-list__items">
        <!-- m-0: .row solo resetea los margenes laterales y el superior, asi
             que el margin-bottom que el Reboot pone a <ul> sobreviviria. -->
        <ul class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-6 list-unstyled m-0">
          {
            products.map((product, index) => (
              <li class="col">
                <ProductCard product={product} eager={index === 0} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</Layout>

<script>
  import '../scripts/bootstrap';
  import '../scripts/category-nav';
  import '../scripts/add-button';
</script>
