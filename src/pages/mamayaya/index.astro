---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import OrderBar from '../../components/OrderBar.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import MenuSheet from '../../components/MenuSheet.astro';
import Hero from '../../components/Hero.astro';
import MenuSection from '../../components/MenuSection.astro';
import MenuSidebar from '../../components/MenuSidebar.astro';
import StoreClosedNotice from '../../components/StoreClosedNotice.astro';
import RetryNotice from '../../components/RetryNotice.astro';
import CartFab from '../../components/CartFab.astro';
import Footer from '../../components/Footer.astro';
import {
  getCategories,
  getMenuSections,
  getProducts,
  type ProductListItem,
} from '../../lib/catalog.ts';
import { ApiError } from '../../lib/api.ts';
import { ERROR_AREAS, errorCode } from '../../lib/error-codes.ts';
import { busyMessage } from '../../lib/throttle.ts';
import { getStoreConfig, getStoreSchedule } from '../../lib/store-config.ts';
import { getCart } from '../../lib/cart.ts';
import { peekCartToken } from '../../lib/cart-session.ts';
import { isClosed, shiftLabel } from '../../lib/schedule.ts';
import { formatPrice } from '../../lib/price.ts';
import { DRAFT_COOKIE, parseDraft } from '../../lib/checkout-draft.ts';

// On-demand, no prerenderizado: `available` depende del horario de la
// categoria resuelto en America/Cancun, asi que una pagina generada en el
// build serviria la disponibilidad congelada del momento del deploy y
// mostraria como comprable un platillo que ya cerro. Ademas la barra de pedido
// lee el modo de entrega de la sesion, que una pagina del build no tiene.
export const prerender = false;

let products: ProductListItem[] = [];

// El aviso que sustituye a la rejilla, ya redactado, o null si el catalogo cargo.
//
// ES UN TEXTO Y NO UN BOOLEANO A PROPOSITO. Antes cualquier fallo pintaba el mismo
// "no pudimos cargar el menu", y bajo ese texto caben tres cosas que no se parecen
// en nada: la API caida, la API que no contesta (red, DNS, timeout) y un 429 —que
// no es una averia, sino un techo por minuto que se libera solo—. Con un unico
// mensaje, un limite temporal y una caida de verdad se veian igual, y ni el
// comprador sabia si esperar ni nosotros que estaba pasando.
let catalogNotice: string | null = null;

// El codigo del fallo, que se pinta bajo el aviso y se escribe en el log con el mismo
// nombre: el comprador manda una captura con "SF-M502" y eso se busca literal en Vercel.
// Ver src/lib/error-codes.ts.
let catalogCode: string | null = null;

// Que se le ofrece al comprador para volver a intentarlo (ver <RetryNotice>).
//
// Es el mismo reparto que hace el texto de arriba, con una raya distinta: alli se separa
// el 429 para DECIR otra cosa, y aqui para no recargar SOLA. Recargar contra un techo por
// minuto gasta otra ficha del mismo cubo y aleja el momento en que se libera; contra una
// averia transitoria —que es lo que resulto ser— la recarga es justo lo que la arregla. Al
// 429 le queda el enlace manual, para cuando el comprador haya esperado.
let catalogRetry: 'auto' | 'manual' = 'auto';

// Configuracion, horario y carrito ARRANCAN aqui, antes de esperar al catalogo, y se
// recogen mas abajo. Las cuatro llamadas salen a la vez, igual que en la ficha.
//
// Antes el catalogo se esperaba primero y los otros tres arrancaban cuando el ya habia
// terminado. Con un backend que responde deprisa no se notaba, pero con uno que acepta la
// conexion y se calla —justo el caso para el que `apiFetch` tiene plazo— la portada sumaba
// dos presupuestos seguidos: los 8 s del catalogo y DESPUES los 8 s de los otros tres. Unos
// 16 s con la pestana en blanco, que pueden rebasar la vida de la funcion en Vercel y
// acabar en su pagina de error en lugar de en el aviso. Lanzadas a la vez, el peor caso es
// el de la llamada mas lenta: unos 8 s.
//
// Pueden quedar sin esperar mientras corre el `try` del catalogo porque ninguna lanza: las
// dos de la tienda devuelven respaldo o null, y la del carrito trae su propio catch. Sin
// ellas la cabecera se queda sin sus iconos o sin su importe, pero el catalogo se sirve
// igual.
//
// El carrito lo pide la barra de desktop, que ensena importe y unidades. Solo se pide si la
// sesion ya tiene token: ver peekCartToken en src/lib/cart-session.ts.
const cartToken = peekCartToken(Astro.cookies);

const storePending = getStoreConfig();
// "Ninguna lanza" es cierto HOY, no una garantia: getStoreConfig llama a `.trim()` fuera de
// su try, y si la API devolviera un numero donde espera texto, lanzaria. Lanzada antes de
// tiempo, esa promesa se rechazaria mientras se espera al catalogo SIN NADIE ATENDIENDOLA, y
// Node trata un rechazo sin atender como un error que puede tumbar la funcion entera —con
// las demas visitas que estuviera sirviendo—. Este catch solo la marca como atendida: el
// Promise.all de abajo la sigue recibiendo, y la pagina falla con un 500 como antes, pero
// solo esta visita.
storePending.catch(() => {});
const schedulePending = getStoreSchedule();
const cartPending = cartToken
  ? getCart(cartToken).catch((error) => {
      console.error('[portada] fallo GET /api/cart', error);
      return null;
    })
  : null;

try {
  products = await getProducts();
} catch (error) {
  // Sin catalogo la pagina sigue en pie —cabecera y barra de pedido— con un
  // aviso en lugar de la rejilla. Una portada en blanco es peor que una
  // portada que explica que paso.
  //
  // El log conserva el error entero: `ApiError` lleva el `status` dentro del
  // mensaje, asi que en las funciones de Vercel se distingue un 429 de un 500 sin
  // tener que reproducirlo. Desde que `apiFetch` reintenta, un error que llega hasta
  // aqui es uno que YA fallo hasta tres veces: en el log es una averia, no un tropiezo.
  catalogCode = errorCode(ERROR_AREAS.menu, error);

  console.error(`[catalogo] ${catalogCode} fallo GET /api/products`, error);

  const throttled = error instanceof ApiError && error.status === 429;

  catalogRetry = throttled ? 'manual' : 'auto';

  // Sin "vuelve a intentarlo en unos minutos": debajo, la cuenta atras dice que se
  // reintenta en segundos, y las dos frases juntas se contradecian en pantalla. El texto
  // dice que paso; lo que va a pasar lo dicen la cuenta atras y el enlace.
  catalogNotice = throttled
    ? busyMessage(error instanceof ApiError ? error.retryAfter : null)
    : 'No pudimos cargar el menu en este momento.';
}

// Las tres que arrancaron antes del catalogo. Ya estan en curso —o terminadas—, asi que
// esperarlas aqui no suma tiempo al del catalogo: solo lo que les falte.
const [store, schedule, cart] = await Promise.all([storePending, schedulePending, cartPending]);

// LAS CATEGORIAS VAN POR ID. La lista y su orden son los del panel —`categories` de
// GET /api/store— y los platillos se les cuelgan por `category.id`. Chips, columna
// lateral, secciones y pie salen de la misma lista, asi que cada chip tiene su seccion y
// cada entrada de la columna su destino. Ver getCategories en src/lib/catalog.ts.
const categories = getCategories(products, store.categories);

// La portada pinta el catalogo por secciones —destacados y una por categoria— y las
// recorre con su indice: la columna lateral en desktop y las tabs en movil. Ver
// components/MenuSection.astro.
//
// El titular y la bajada de los destacados los escribe el panel (`home.featured`); sin
// ellos, la seccion se rotula con los de la tienda.
const sections = getMenuSections(products, store.categories, store.home?.featured);

// El rotulo de envio lo compone la tienda a partir del modo, porque es un rotulo y
// los rotulos son suyos. Con `none` no se pinta: prometer un envio gratis que el
// negocio apago es peor que no decir nada.
const freeShipping = store.delivery?.freeShipping;

const shippingLabel =
  freeShipping?.mode === 'always'
    ? 'Envio gratis'
    : freeShipping?.mode === 'threshold' && freeShipping.threshold
      ? `Envio gratis desde ${formatPrice(freeShipping.threshold)}`
      : undefined;

// El banner lo escribe el panel, no la portada: es una campana, y cambiar la
// frase de temporada o la foto no puede exigir un despliegue. Si no hay nada
// configurado el componente no pinta nada y la tienda abre en el catalogo.
const banner = store.home?.banner;

// "Ver mapa" abre la hoja de ubicacion que monta la cabecera. Se ofrece con la
// misma condicion con la que ella la monta —basta uno de los dos datos—, porque
// sin ninguno la hoja no existe y el boton abriria la nada.
const hasLocation = Boolean(store.location?.address || store.location?.mapsUrl);

// Con la tienda cerrada la portada se queda en menu: se puede mirar todo, pero no
// se agrega nada. Lo dice la tarjeta flotante una vez, y las tarjetas de platillo
// se callan —sin boton y sin etiqueta— en lugar de repetir "Fuera de horario"
// tantas veces como platillos haya.
const closed = isClosed(schedule);

// El encabezado de la columna lateral: la presentacion que el negocio escribio para
// ella o, sin presentacion, el nombre de la tienda. Ver `home.panel` en
// src/lib/store-config.ts.
const sidebarHeading = store.home?.panel?.presentation || store.name;

// El turno en curso, bajo el encabezado de la columna lateral. Sin horario no se
// afirma nada y la linea no se pinta.
const shift = schedule ? shiftLabel(schedule) : null;

// El switch de la barra llega con lo ultimo elegido, aqui o en /mamayaya/datos: es la
// misma eleccion, guardada en el borrador. Se pinta en el servidor para que las
// metas correctas —plazo y envio, o recoleccion y mapa— esten ya en su sitio
// antes de que arranque el JavaScript.
const { deliveryType } = parseDraft(Astro.cookies.get(DRAFT_COOKIE)?.value);
---

<Layout store={store}>
  <Navbar
    store={store}
    schedule={schedule}
    cartTotal={cart?.total ?? 0}
    cartCount={cart?.itemsCount ?? 0}
  />

  <!-- flex-grow-1: con el pie debajo, una tienda de dos platillos dejaria la
       franja blanca del pie flotando y el fondo gris asomando bajo ella. Crece el
       contenido, no el pie. -->
  <main class="storefront flex-grow-1">
    {/* El subcontenedor: un .container-fluid de Bootstrap, las 12 columnas a ancho
        completo. En desktop lleva dos columnas: el indice del menu a la izquierda y,
        a la derecha, el banner, la barra y el catalogo. <main> es el contenedor de
        fuera y solo pone el aire de arriba y abajo.

        La pila y su columna solo existen en desktop —en movil son `display:
        contents`, ver los estilos de este archivo, y el indice no se pinta—, asi que
        envolver no cambia nada de lo que ya habia: el aviso de tienda cerrada se
        queda fuera porque flota. */}
    <div class="storefront__stack container-fluid">
      <MenuSidebar heading={sidebarHeading} shift={shift} sections={sections} />

      <div class="storefront__content">
        <Hero
          title={banner?.title}
          description={banner?.description}
          image={banner?.image}
        />

        <OrderBar
          estimate={store.delivery?.estimate}
          shipping={shippingLabel}
          pickup={store.pickup?.estimate}
          hasLocation={hasLocation}
          selected={deliveryType}
          search={sections.length > 0}
          shortAddress={store.location?.shortAddress}
        >
          {/* El indice de movil: cuelga de la barra de pedido, que va anclada arriba,
              y sale de debajo de ella al entrar en una categoria. En desktop no se
              pinta. */}
          <CategoryNav sections={sections} sheet="sheet-menu" />
        </OrderBar>

        {/* La hoja que abre el boton de las tabs: el indice entero, con la tienda y
            su turno. Es un <dialog>, asi que donde vaya en el marcado da igual: se
            abre en la capa superior. */}
        {sections.length > 0 && (
          <MenuSheet id="sheet-menu" heading={sidebarHeading} shift={shift} sections={sections} />
        )}

        <section class="product-list" aria-label="Productos">
          {
            sections.length > 0 ? (
              <>
                {/* La cabecera de los resultados del buscador de desktop, que ocupan
                    el sitio de las secciones mientras hay texto. La enciende y la
                    rellena src/scripts/menu-search.ts. Usa los rotulos de la cabecera
                    de una seccion. */}
                <header class="menu-results" hidden data-search-results>
                  <h2 class="menu-section__title">Resultados</h2>
                  <p class="menu-section__description" data-search-summary></p>
                </header>

                {/* Lo mismo, para quien no ve la pantalla. Fuera de la cabecera y
                    siempre presente: una region viva que aparece a la vez que su
                    texto no se anuncia. */}
                <p class="visually-hidden" aria-live="polite" data-search-status></p>

                {/* data-product-list: lo que el buscador de desktop convierte en una
                    sola lista. */}
                <div class="product-list__sections" data-product-list>
                  {sections.map((section, index) => (
                    // La primera tarjeta de la primera seccion se carga sin diferir:
                    // es la que entra en la primera pantalla, en las dos.
                    <MenuSection section={section} eager={index === 0} storeClosed={closed} />
                  ))}
                </div>
              </>
            ) : (
              // Dos avisos distintos en el mismo sitio: el catalogo vacio es un 200 con
              // la lista vacia —no hay nada que reintentar, la tienda contesto— y el
              // fallo si lleva su reintento.
              catalogNotice ? (
                <div class="product-list__notice">
                  <RetryNotice body={catalogNotice} code={catalogCode ?? undefined} retry={catalogRetry} />
                </div>
              ) : (
                <p class="product-list__notice">Todavia no hay platillos publicados.</p>
              )
            )
          }
        </section>

      </div>
    </div>

    {/* La hoja del horario que abre su boton la monta la cabecera, que ya la
        necesita para el reloj. */}
    {closed && schedule && <StoreClosedNotice schedule={schedule} />}

    {/* La via al pedido en movil: el mismo carrito de la barra de desktop, que
        aqui no se pinta. Las unidades son las que ya se pidieron para esa barra,
        asi que no cuesta una llamada mas. En que pantallas se ve —y que pasa con
        la tienda cerrada, que ocupa este mismo borde— lo decide el bloque. */}
    <CartFab count={cart?.itemsCount ?? 0} />
  </main>

  <Footer store={store} categories={categories} />
</Layout>

<script>
  // Los dos indices —columna lateral y tabs—, que tambien cumplen el pase de
  // "Descubre", y la lista horizontal de destacados.
  import '../../scripts/menu-nav';
  import '../../scripts/featured-carousel';
  // El buscador de desktop: filtra los platillos de la pagina.
  import '../../scripts/menu-search';
  // Retira el esqueleto de cada foto cuando llega. Solo esta pantalla lo necesita:
  // es la unica que pinta tarjetas de platillo.
  import '../../scripts/image-skeleton';
  import '../../scripts/delivery-mode';
  import '../../scripts/add-button';
  import '../../scripts/sheet';
  // El tirador de la hoja de categorias: se cierra arrastrandola hacia abajo.
  import '../../scripts/sheet-drag';
  import '../../scripts/footer-discover';
</script>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: storefront
     ---------------------------------------------------------------------------
     El armazon de la portada, y solo de la portada. Tres piezas encajadas:

     .storefront          <main>, el contenedor de fuera: 48 arriba y 48 abajo.
     .storefront__stack   el subcontenedor, un .container-fluid de Bootstrap: 32
                          de sangria, tope en 1140 de contenido y, dentro, dos
                          columnas separadas 32.
     .storefront__content la de la derecha: el banner, la barra y las secciones,
                          separados 32. La de la izquierda es el indice del menu
                          (components/MenuSidebar.astro).

     El de fuera solo pone el aire vertical; el de dentro, el ancho y el lateral.
     Repartido asi, mover la portada arriba o abajo no toca los margenes, y
     cambiar de ancho no toca el aire.

     En movil ni la pila ni su columna existen: las piezas —barra de pedido y
     lista— se apilan solas y cada una trae su propio gutter y su propio aire, como
     hasta ahora. En desktop la pila es EL contenedor, asi que el unico margen
     lateral de la portada es el suyo: el indice arranca en la misma linea que el
     logo de la cabecera, y la ultima tarjeta acaba en la misma que el carrito.

     Por eso el aire —vertical y lateral— se les quita ahi a los bloques (ver
     components/Hero.astro, components/OrderBar.astro y los estilos de este
     archivo): en desktop lo pone la pila, en un solo sitio, y no la suma de los
     margenes de cada bloque.
     --------------------------------------------------------------------------- */
  /* Movil: el hueco del boton flotante del pedido. Flota sobre el catalogo (ver
     components/CartFab.astro), asi que al final de la lista se quedaria encima de
     la ultima tarjeta y justo sobre su "+", que es lo que se viene a pulsar. Lo
     reserva <main>, que es lo que scrollea: el circulo esta fuera del flujo y no
     puede reservarselo el.

     Se reserva el diametro mas la separacion del borde; el aire entre la ultima
     tarjeta y el circulo lo pone el padding que la lista ya trae. En desktop no
     hace falta —ahi no hay boton— y lo sustituye el `padding-block` de mas abajo. */
  .storefront {
    padding-bottom: calc(70px + 20px + env(safe-area-inset-bottom, 0px));
  }

  /* display: contents: en movil los envoltorios no pintan ni ocupan nada —ni el
     ancho ni el relleno del .container-fluid llegan a aplicarse—, asi que sus hijos
     siguen siendo hijos de <main> a efectos de layout y la pantalla se ve
     exactamente igual que si no estuvieran. */
  .storefront__stack,
  .storefront__content {
    display: contents;
  }

  /* --- Desktop ------------------------------------------------------------- */
  @media (min-width: 768px) {
    /* El contenedor de fuera: solo el aire de arriba y abajo. El lateral no puede
       ir aqui porque el aviso de tienda cerrada tambien cuelga de <main>, flota y
       trae su propia sangria: se la duplicaria. */
    .storefront {
      padding-block: 48px;
    }
    .storefront__stack {
      /* El ancho, el centrado y la sangria son los del .container-fluid; lo unico
         que se le cambia es la medida del gutter, que en la portada es el de la
         tienda (32) y no el de la rejilla (24). Se pide en --bs-gutter-x, que es
         la variable por la que el contenedor pregunta, y se dobla porque el
         reparte la mitad a cada lado. */
      --bs-gutter-x: calc(32px * 2);
      /* Y el tope, que es lo unico que .container-fluid no trae: fluido hasta
         aqui, y de aqui en adelante centrado, dejando el resto de la pantalla a
         los lados. Sin el, la portada seguiria creciendo mientras la cabecera y el
         pie paran en 1140, y los tres dejarian de coincidir en el primer monitor
         ancho.

         Se suma el gutter porque el tope del diseno es el del CONTENIDO y la caja
         mide con border-box: 1140 + 32 + 32 deja dentro los 1140 de la spec, los
         mismos que paran la cabecera y el pie dentro de su propia sangria. */
      max-width: calc(1140px + var(--bs-gutter-x));
      display: flex;
      gap: 32px;
    }
    .storefront__content {
      /* Las secciones preguntan por el ancho de esta columna para repartir sus
         tarjetas (ver components/MenuSection.astro): con el indice al lado, el
         viewport ya no dice cuanto sitio queda. */
      container: menu / inline-size;
      display: flex;
      flex: 1 1 0;
      flex-direction: column;
      gap: 32px;
      min-width: 0;
    }
  }
  /* ---------------------------------------------------------------------------
     Block: product-list
     ---------------------------------------------------------------------------
     Spec: gap 24 - padding 20
     El reparto de las tarjetas es de cada seccion (components/MenuSection.astro):
     aqui queda el padding de la lista y el hueco entre secciones.
     --------------------------------------------------------------------------- */
  .product-list {
    padding: 20px 20px;
  }

  /* Element: sections — en movil, 32 entre secciones: mas que los 24 entre
     tarjetas, para que se lea donde acaba cada grupo. */
  .product-list__sections {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Element: notice — ocupa el sitio de la lista cuando no hay nada que pintar:
     catalogo vacio (200 con lista vacia) o API inalcanzable. */
  .product-list__notice {
    margin: 0;
    padding-block: 32px;
    font-size: 14px;
    line-height: 20px;
    color: var(--sf-muted);
    text-align: center;
  }

  /* --- Desktop ------------------------------------------------------------- */
  @media (min-width: 768px) {
    /* Sin aire propio de ninguna clase: el que la separa de la barra lo pone su
       columna (ver los estilos de este archivo), el de abajo el padding de <main>,
       y el de los lados la pila. */
    .product-list {
      display: flex;
      flex-direction: column;
      gap: 24px;
      padding: 0;
    }
    /* Cada seccion trae su cabecera: entre una y otra, el doble del hueco que hay
       entre la cabecera y sus tarjetas, para que se lea donde acaba cada grupo. */
    .product-list__sections {
      gap: 48px;
    }
  }

  /* ---------------------------------------------------------------------------
     Block: menu-results
     ---------------------------------------------------------------------------
     La cabecera de los resultados del buscador: "Resultados" y, debajo, cuantos y
     de que. Los rotulos son los de la cabecera de una seccion
     (components/MenuSection.astro), y a 24 de la lista, como alli. Solo desktop:
     el buscador no existe en movil.
     --------------------------------------------------------------------------- */
  @media (min-width: 768px) {
    .menu-results {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
