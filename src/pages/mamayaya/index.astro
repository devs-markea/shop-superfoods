---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import OrderBar from '../../components/OrderBar.astro';
import Hero from '../../components/Hero.astro';
import ProductCard from '../../components/ProductCard.astro';
import StoreClosedNotice from '../../components/StoreClosedNotice.astro';
import CartFab from '../../components/CartFab.astro';
import Footer from '../../components/Footer.astro';
import {
  ALL_CATEGORIES,
  getCategories,
  getProducts,
  type ProductListItem,
} from '../../lib/catalog.ts';
import { ApiError } from '../../lib/api.ts';
import { busyMessage } from '../../lib/throttle.ts';
import { getStoreConfig, getStoreSchedule } from '../../lib/store-config.ts';
import { getCart } from '../../lib/cart.ts';
import { peekCartToken } from '../../lib/cart-session.ts';
import { DISCOVER_KEY } from '../../lib/discover.ts';
import { isClosed } from '../../lib/schedule.ts';
import { formatPrice } from '../../lib/price.ts';
import { DRAFT_COOKIE, parseDraft } from '../../lib/checkout-draft.ts';

// On-demand, no prerenderizado: `available` depende del horario de la
// categoria resuelto en America/Cancun, asi que una pagina generada en el
// build serviria la disponibilidad congelada del momento del deploy y
// mostraria como comprable un platillo que ya cerro. Ademas la barra de pedido
// lee el modo de entrega de la sesion, que una pagina del build no tiene.
export const prerender = false;

let products: ProductListItem[] = [];

// El aviso que sustituye a la rejilla, ya redactado, o null si el catalogo cargo.
//
// ES UN TEXTO Y NO UN BOOLEANO A PROPOSITO. Antes cualquier fallo pintaba el mismo
// "no pudimos cargar el menu", y bajo ese texto caben tres cosas que no se parecen
// en nada: la API caida, la API que no contesta (red, DNS, timeout) y un 429 —que
// no es una averia, sino un techo por minuto que se libera solo—. Con un unico
// mensaje, un limite temporal y una caida de verdad se veian igual, y ni el
// comprador sabia si esperar ni nosotros que estaba pasando.
let catalogNotice: string | null = null;

try {
  products = await getProducts();
} catch (error) {
  // Sin catalogo la pagina sigue en pie —cabecera y barra de pedido— con un
  // aviso en lugar de la rejilla. Una portada en blanco es peor que una
  // portada que explica que paso.
  //
  // El log conserva el error entero: `ApiError` lleva el `status` dentro del
  // mensaje, asi que en las funciones de Vercel se distingue un 429 de un 500 sin
  // tener que reproducirlo.
  console.error('[catalogo] fallo GET /api/products', error);

  catalogNotice =
    error instanceof ApiError && error.status === 429
      ? busyMessage(error.retryAfter)
      : 'No pudimos cargar el menu en este momento. Vuelve a intentarlo en unos minutos.';
}

const categories = getCategories(products);

// El pie rotula lo que hay de verdad en el catalogo, asi que recibe las
// categorias sin el chip que no filtra nada: "Todos" es de la barra, no del menu.
const published = categories.filter((category) => category !== ALL_CATEGORIES);

// Configuracion, horario y carrito van en paralelo con lo que ya se pidio, y
// encadenarlos retrasaria la portada por nada. Ninguno lanza: sin ellos la
// cabecera se queda sin sus iconos o sin su importe, pero el catalogo se sirve
// igual.
//
// El carrito lo pide la barra de desktop, que ensena importe y unidades. Solo se
// pide si la sesion ya tiene token: ver peekCartToken en src/lib/cart-session.ts.
const cartToken = peekCartToken(Astro.cookies);

const [store, schedule, cart] = await Promise.all([
  getStoreConfig(),
  getStoreSchedule(),
  cartToken
    ? getCart(cartToken).catch((error) => {
        console.error('[portada] fallo GET /api/cart', error);
        return null;
      })
    : null,
]);

// El rotulo de envio lo compone la tienda a partir del modo, porque es un rotulo y
// los rotulos son suyos. Con `none` no se pinta: prometer un envio gratis que el
// negocio apago es peor que no decir nada.
const freeShipping = store.delivery?.freeShipping;

const shippingLabel =
  freeShipping?.mode === 'always'
    ? 'Envio gratis'
    : freeShipping?.mode === 'threshold' && freeShipping.threshold
      ? `Envio gratis desde ${formatPrice(freeShipping.threshold)}`
      : undefined;

// El banner lo escribe el panel, no la portada: es una campana, y cambiar la
// frase de temporada o la foto no puede exigir un despliegue. Si no hay nada
// configurado el componente no pinta nada y la tienda abre en el catalogo.
const banner = store.home?.banner;

// "Ver mapa" abre la hoja de ubicacion que monta la cabecera. Se ofrece con la
// misma condicion con la que ella la monta —basta uno de los dos datos—, porque
// sin ninguno la hoja no existe y el boton abriria la nada.
const hasLocation = Boolean(store.location?.address || store.location?.mapsUrl);

// Con la tienda cerrada la portada se queda en menu: se puede mirar todo, pero no
// se agrega nada. Lo dice la tarjeta flotante una vez, y las tarjetas de platillo
// se callan —sin boton y sin etiqueta— en lugar de repetir "Fuera de horario"
// tantas veces como platillos haya.
const closed = isClosed(schedule);

// El switch de la barra llega con lo ultimo elegido, aqui o en /mamayaya/datos: es la
// misma eleccion, guardada en el borrador. Se pinta en el servidor para que las
// metas correctas —plazo y envio, o recoleccion y mapa— esten ya en su sitio
// antes de que arranque el JavaScript.
const { deliveryType } = parseDraft(Astro.cookies.get(DRAFT_COOKIE)?.value);
---

<Layout title="Shop Superfoods">
  <Navbar
    store={store}
    schedule={schedule}
    cartTotal={cart?.total ?? 0}
    cartCount={cart?.itemsCount ?? 0}
  />

  <!-- flex-grow-1: con el pie debajo, una tienda de dos platillos dejaria la
       franja blanca del pie flotando y el fondo gris asomando bajo ella. Crece el
       contenido, no el pie. -->
  <main class="storefront flex-grow-1">
    {/* El subcontenedor: un .container-fluid de Bootstrap, las 12 columnas a
        ancho completo, con el banner, la barra y la lista dentro. <main> es el
        contenedor de fuera y solo pone el aire de arriba y abajo.

        La pila solo existe en desktop —en movil es `display: contents`, ver
        los estilos de este archivo—, asi que envolver no cambia nada de lo que
        ya habia: el aviso de tienda cerrada se queda fuera porque flota. */}
    <div class="storefront__stack container-fluid">
      <Hero
        title={banner?.title}
        description={banner?.description}
        image={banner?.image}
      />

      <OrderBar
        categories={categories}
        estimate={store.delivery?.estimate}
        shipping={shippingLabel}
        pickup={store.pickup?.estimate}
        hasLocation={hasLocation}
        selected={deliveryType}
      />

      <section class="product-list" aria-label="Productos">
        <div class="product-list__items">
          <h2 class="product-list__title">Nuestros Platillos</h2>

          {
            products.length > 0 ? (
              // mb-0 y no m-0: .row ya resetea el margen superior y pone los
              // laterales en NEGATIVO —es asi como compensa el padding de 12
              // de cada columna, para que la primera arranque en el borde del
              // contenedor y la ultima acabe en el otro—. Un m-0 se los lleva
              // por delante y mete la rejilla 12 por cada lado. Lo unico que
              // hay que quitar es el margin-bottom que el Reboot pone a <ul>,
              // que ese si sobrevive.
              <ul
                class="product-list__grid row row-cols-1 row-cols-md-2 row-cols-xl-3 list-unstyled mb-0"
                data-product-list
              >
                {products.map((product, index) => (
                  // data-category en la celda, no en la tarjeta: es la celda lo
                  // que oculta el filtro.
                  <li class="col" data-category={product.category}>
                    <ProductCard product={product} eager={index === 0} storeClosed={closed} />
                  </li>
                ))}
              </ul>
            ) : (
              <p class="product-list__notice">
                {catalogNotice ?? 'Todavia no hay platillos publicados.'}
              </p>
            )
          }
        </div>
      </section>

      {/*
        El pase de "Descubre": la categoria que dejo escrita el pie de otra
        pantalla (ver src/lib/discover.ts).

        INLINE Y BLOQUEANTE, y aqui abajo, no arriba. Es la unica forma de que el
        filtro llegue antes del primer pintado: los <script> de mas abajo los
        empaqueta Astro como modulos, que son diferidos y corren cuando el HTML ya
        esta parseado entero —para entonces la rejilla completa puede estar en
        pantalla y filtrarla se veria como un salto—. Detras del </ul> porque las
        celdas y los chips tienen que estar ya parseados para poder tocarlos.

        `define:vars` es lo que hace que la clave llegue de su modulo en lugar de
        repetirla escrita a mano aqui. Ya implica `is:inline`, que se escribe
        igualmente para que se lea que este bloque no se procesa: nada de
        TypeScript ni de imports dentro, es JavaScript tal cual sale al navegador.
      */}
      <script is:inline define:vars={{ discoverKey: DISCOVER_KEY }}>
        (() => {
          let pending = null;

          // Puede lanzar —modo privado, almacenamiento bloqueado—. Y se retira al
          // leerlo, sirva o no: el pase es la continuacion de un click, no una
          // preferencia. Si sobreviviera, la portada abriria filtrada manana.
          try {
            pending = window.sessionStorage.getItem(discoverKey);
            if (pending) window.sessionStorage.removeItem(discoverKey);
          } catch {
            pending = null;
          }

          if (!pending) return;

          // Se valida contra los chips de ESTA pagina, no contra el nombre que
          // viajo: entre que se pinto aquel pie y el click, el panel pudo
          // renombrar la categoria o despublicarla. Sin la comprobacion se
          // ocultarian todas las celdas y la portada saldria vacia sin nada que lo
          // explicara —el filtro no tiene estado "sin resultados" precisamente
          // porque hasta ahora los chips solo podian venir del mismo catalogo que
          // las tarjetas—.
          let chip = null;

          for (const radio of document.querySelectorAll('input[name="category"]')) {
            if (radio.value === pending) {
              chip = radio;
              break;
            }
          }

          if (!chip) return;

          chip.checked = true;

          // Ocultar aqui y no dejarselo a category-filter.ts: ese es un modulo y
          // llega tarde. Hace exactamente esto mismo, asi que cuando arranque
          // encontrara su trabajo hecho y no cambiara nada —lee el chip marcado y
          // vuelve a aplicar lo aplicado—.
          const list = document.querySelector('[data-product-list]');
          if (!list) return;

          for (const cell of list.querySelectorAll('[data-category]')) {
            cell.hidden = cell.dataset.category !== pending;
          }
        })();
      </script>
    </div>

    {/* La hoja del horario que abre su boton la monta la cabecera, que ya la
        necesita para el reloj. */}
    {closed && schedule && <StoreClosedNotice schedule={schedule} />}

    {/* La via al pedido en movil: el mismo carrito de la barra de desktop, que
        aqui no se pinta. Las unidades son las que ya se pidieron para esa barra,
        asi que no cuesta una llamada mas. En que pantallas se ve —y que pasa con
        la tienda cerrada, que ocupa este mismo borde— lo decide el bloque. */}
    <CartFab count={cart?.itemsCount ?? 0} />
  </main>

  <Footer store={store} categories={published} />
</Layout>

<script>
  import '../../scripts/category-nav';
  import '../../scripts/category-filter';
  // Retira el esqueleto de cada foto cuando llega. Solo esta pantalla lo necesita:
  // es la unica que pinta tarjetas de platillo.
  import '../../scripts/image-skeleton';
  import '../../scripts/delivery-mode';
  import '../../scripts/add-button';
  import '../../scripts/sheet';
  import '../../scripts/footer-discover';
</script>

<style is:global>
  /* ---------------------------------------------------------------------------
     Block: storefront
     ---------------------------------------------------------------------------
     El armazon de la portada, y solo de la portada. Son dos piezas encajadas:

     .storefront        <main>, el contenedor de fuera: 48 arriba y 48 abajo.
     .storefront__stack el subcontenedor, un .container-fluid de Bootstrap: las
     12 columnas, 32 de sangria y tope en --sf-container-max,
     y dentro el banner, la barra y la rejilla separados 32.

     El de fuera solo pone el aire vertical; el de dentro, el ancho y el lateral.
     Repartido asi, mover la portada arriba o abajo no toca los margenes, y
     cambiar de ancho no toca el aire.

     En movil el subcontenedor no existe: las piezas —barra de pedido y rejilla—
     se apilan solas y cada una trae su propio gutter y su propio aire, como hasta
     ahora. En desktop aparece y manda tambien de lado a lado: es EL contenedor de
     los tres, asi que el unico margen lateral de la portada es el suyo. Antes cada
     bloque ponia el suyo y paraba en su propio ancho, y bastaba que uno cambiara
     para que los bordes dejaran de coincidir; ahora los tres arrancan y acaban en
     la misma linea porque solo hay una que decide donde esta.

     Por eso el aire —vertical y lateral— se les quita ahi a los tres (ver
     components/Hero.astro, components/OrderBar.astro y los estilos de este archivo): en desktop lo
     pone la pila, en un solo sitio, y no la suma de los margenes de cada bloque.
     --------------------------------------------------------------------------- */
  /* Movil: el hueco del boton flotante del pedido. Flota sobre el catalogo (ver
     components/CartFab.astro), asi que al final de la lista se quedaria encima de
     la ultima tarjeta y justo sobre su "+", que es lo que se viene a pulsar. Lo
     reserva <main>, que es lo que scrollea: el circulo esta fuera del flujo y no
     puede reservarselo el.

     Se reserva el diametro mas la separacion del borde; el aire entre la ultima
     tarjeta y el circulo lo pone el padding que la lista ya trae. En desktop no
     hace falta —ahi no hay boton— y lo sustituye el `padding-block` de mas abajo. */
  .storefront {
    padding-bottom: calc(70px + 20px + env(safe-area-inset-bottom, 0px));
  }

  /* display: contents: en movil el envoltorio no pinta ni ocupa nada —ni el ancho
     ni el relleno del .container-fluid llegan a aplicarse—, asi que sus hijos
     siguen siendo hijos de <main> a efectos de layout y la pantalla se ve
     exactamente igual que si no estuviera. */
  .storefront__stack {
    display: contents;
  }

  /* --- Desktop ------------------------------------------------------------- */
  @media (min-width: 768px) {
    /* El contenedor de fuera: solo el aire de arriba y abajo. El lateral no puede
       ir aqui porque el aviso de tienda cerrada tambien cuelga de <main>, flota y
       trae su propia sangria: se la duplicaria. */
    .storefront {
      padding-block: 48px;
    }
    .storefront__stack {
      /* El ancho, el centrado y la sangria son los del .container-fluid; lo unico
         que se le cambia es la medida del gutter, que en la portada es el de la
         tienda (32) y no el de la rejilla (24). Se pide en --bs-gutter-x, que es
         la variable por la que el contenedor pregunta, y se dobla porque el
         reparte la mitad a cada lado.

         No se filtra a las tarjetas: el .row de la lista es .product-list__grid,
         que redeclara --bs-gutter-x en el propio .row. */
      --bs-gutter-x: calc(32px * 2);
      /* Y el tope, que es lo unico que .container-fluid no trae: fluido hasta
         aqui, y de aqui en adelante centrado, dejando el resto de la pantalla a
         los lados. Sin el, la portada seguiria creciendo mientras la cabecera y el
         pie paran en --sf-container-max, y los tres dejarian de coincidir en el
         primer monitor ancho.

         Se suma el gutter porque el tope del diseno es el del CONTENIDO y la caja
         mide con border-box: 1140 + 32 + 32 deja dentro los 1140 de la spec, los
         mismos que paran la cabecera y el pie dentro de su propia sangria. */
      max-width: calc(1140px + var(--bs-gutter-x));
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
  }
  /* ---------------------------------------------------------------------------
     Block: product-list
     ---------------------------------------------------------------------------
     Spec: gap 24 - padding 20
     La rejilla la resuelve Bootstrap en el marcado (.row .row-cols-*), asi que
     del bloque original solo queda el padding de la seccion y la medida del
     hueco, que la pone .product-list__grid.
     --------------------------------------------------------------------------- */
  .product-list {
    padding: 20px 20px;
  }

  /* Element: grid — el .row de las tarjetas.
     Los 24 del diseno. Antes los ponia la utilidad `g-6`, que salia de la escala
     de espaciado propia que se le daba a Bootstrap desde Sass; sin esa escala,
     Bootstrap no tiene ningun `g-6` que dar y la medida se pide aqui, que es
     donde se puede leer de que token sale. */
  .product-list__grid {
    --bs-gutter-x: 24px;
    --bs-gutter-y: 24px;
  }

  /* Ya no limita el ancho: en desktop lo hace el subcontenedor de la portada, que
     para en --sf-container-max igual que la cabecera y el pie (ver
     los estilos de este archivo). Ponerlo aqui tambien no cambiaria nada y seria
     un segundo sitio donde tocar el dia que el tope se mueva.

     El envoltorio sigue existiendo aunque ya no limite: envuelve al .row porque
     .row usa margenes negativos para sus gutters, y en desktop es el que reparte
     los 24 entre el titulo y la rejilla. */
  .product-list__items {
    width: 100%;
  }

  /* Element: title — "Nuestros Platillos", encima de la rejilla. Solo desktop: en
     movil la barra de categorias, que va justo encima, ya dice que se esta
     mirando, y el titulo se comeria la unica pantalla que tiene el catalogo. */
  .product-list__title {
    display: none;
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    /* 100% del tamano: es un titulo de una linea y el interlineado de la escala
       (32 sobre 24) le sobra por arriba y por abajo. */
    line-height: 1;
    color: var(--sf-ink);
  }

  /* Element: notice — ocupa el sitio de la rejilla cuando no hay nada que
     pintar: catalogo vacio (200 con lista vacia) o API inalcanzable. */
  .product-list__notice {
    margin: 0;
    padding-block: 32px;
    font-size: 14px;
    line-height: 20px;
    color: var(--sf-muted);
    text-align: center;
  }

  /* --- Desktop ------------------------------------------------------------- */
  @media (min-width: 768px) {
    /* Sin aire propio de ninguna clase: el que la separa de la barra lo pone la
       pila de la portada (ver los estilos de este archivo), el de abajo el padding
       de <main>, y el de los lados el gutter de la propia pila. */
    .product-list {
      padding: 0;
    }
    /* La lista pasa a ser dos piezas con 24 entre ellas: el titulo y la rejilla. */
    .product-list__items {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .product-list__title {
      display: block;
    }
  }
</style>
