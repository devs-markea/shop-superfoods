---
import Layout from '../../../layouts/Layout.astro';
import ScreenHeader from '../../../components/ScreenHeader.astro';
import NavbarDesktop from '../../../components/NavbarDesktop.astro';
import TipSelector from '../../../components/TipSelector.astro';
import PaymentMethods from '../../../components/PaymentMethods.astro';
import PaymentSummary from '../../../components/PaymentSummary.astro';
import CartSummary from '../../../components/CartSummary.astro';
import LegalNote from '../../../components/LegalNote.astro';
import ActionBar from '../../../components/ActionBar.astro';
import DeviceFingerprint from '../../../components/DeviceFingerprint.astro';
import ScheduleSheet from '../../../components/ScheduleSheet.astro';
import LocationSheet from '../../../components/LocationSheet.astro';
import Footer from '../../../components/Footer.astro';
import FormError from '../../../components/FormError.astro';
import { getCart, isEmptyCart, type Cart } from '../../../lib/cart.ts';
import { resolveCartToken } from '../../../lib/cart-session.ts';
import { quoteForDraft } from '../../../lib/shipping-quote.ts';
import {
  DRAFT_COOKIE,
  ORDER_COOKIE,
  parseDraft,
  parseOrderPointer,
} from '../../../lib/checkout-draft.ts';
import { resolveShipping } from '../../../lib/shipping.ts';
import { getStoreConfig, getStoreSchedule } from '../../../lib/store-config.ts';
import { normalizeTipAmounts } from '../../../lib/tips.ts';
import { ALL_CATEGORIES, getCategories, getProducts } from '../../../lib/catalog.ts';

// DOS PANTALLAS, UN MARCADO
//
// En movil es la de siempre: la cabecera de 124, la propina, los metodos, el
// desglose y "Continuar" en la barra fija del fondo.
//
// En desktop se monta como /mamayaya/carrito y /mamayaya/datos —la misma barra de tienda, el mismo
// armazon de 48 y el mismo pie— y se parte en dos columnas: lo que hay que elegir
// a la izquierda y la tarjeta de resumen a la derecha, que es donde se continua.
// Ver styles/screens.css.
//
// Con la tarjeta, el desglose del cuerpo (<PaymentSummary>) se queda en movil: son
// la misma cuenta contada dos veces, y a la tarjeta le toca porque ademas lleva el
// boton. Sigue pintandose para movil, donde la tarjeta no existe.
//
// Por lo mismo se muda el aviso legal: lo que se acepta al continuar se lee junto
// al control con el que se continua, y en desktop ese control esta en la tarjeta.
// Los dos van en el marcado y cada ancho ensena el suyo.

// El carrito de la sesion manda sobre cualquier valor de ejemplo.
export const prerender = false;

// Mercado Pago devuelve aqui al comprador cuando el cobro se rechaza o se cancela,
// con `?order={id}&pago=rechazado`. Pero esta pantalla ya no puede ayudarle: el
// pedido EXISTE —se creo antes de ir a la pasarela— y con el cierre el carrito
// quedo vacio, asi que lo que se pintaria es un resumen de $0 cuyo "Continuar"
// intentaria crear un pedido nuevo contra un carrito vacio.
//
// Lo que hay que hacer es cobrar otra vez SOBRE ESE pedido, y eso vive en el acuse:
// alli se relee el estado, se muestra el motivo del rechazo ya traducido y se
// reintenta con POST /api/orders/{id}/payment.
//
// El parametro no se cree —los de la vuelta los pone el cliente—: solo se usa como
// pista para llevar al comprador donde se lee la verdad.
const rejectedOrder = Astro.url.searchParams.get('order');

if (Astro.url.searchParams.get('pago') === 'rechazado' && rejectedOrder) {
  return Astro.redirect(`/mamayaya/confirmado?order=${encodeURIComponent(rejectedOrder)}`);
}

const token = resolveCartToken(Astro.cookies);

// El carrito entero, no solo su total: la tarjeta de resumen desglosa el subtotal
// y los descuentos, que es la parte de la cuenta que esta pantalla no rehace.
let cart: Cart | null = null;

try {
  cart = await getCart(token);
} catch (error) {
  console.error('[resumen] fallo GET /api/cart', error);
}

// VOLVER AQUI DESPUES DE HABER PAGADO
//
// El carrito vacio significa dos cosas distintas, y lo que las separa es el
// puntero del pedido: con el, aqui se cerro una compra y el carrito esta vacio
// porque el checkout lo vacio; sin el, simplemente no hay nada que comprar.
//
// El caso con puntero es mas comun de lo que parece. La pasarela puede devolver al
// comprador a OTRO navegador —en movil lo decide el sistema cuando la app de
// Mercado Pago entrega el control—, y entonces la pestana donde se pidio se queda
// aqui: en un resumen de pago de un pedido que ya existe. Tambien pasa al pulsar
// atras desde el acuse.
//
// Adonde se le manda depende de si ya vio su acuse:
//
//   sin ver   al acuse. Es donde estan el folio y el WhatsApp con los que puede
//             avisar a la tienda, y quien no llego a verlos no tiene otra via.
//   ya visto  al menu. Repetirle "Pedido confirmado" en cada atras se lee como
//             que pago dos veces, y ademas dejaria el boton atras en bucle:
//             /mamayaya/confirmado -> /mamayaya/pago -> /mamayaya/confirmado.
//
// El carrito vacio es condicion, no adorno: la cookie del pedido dura un dia, asi
// que quien pidio ayer y hoy vuelve a llenar el carrito tiene que poder pagarlo.
// Con lineas dentro, esta guarda no se aplica y el flujo sigue como siempre.
//
// Va DESPUES de la vuelta de Mercado Pago de arriba, y ese orden importa: un cobro
// rechazado tiene que salir hacia el acuse —que es donde se recobra— antes de que
// nadie lo mande a ningun otro sitio.
const pointer = parseOrderPointer(Astro.cookies.get(ORDER_COOKIE)?.value);

// Cada metodo tiene su acuse —la misma reparticion que hace /mamayaya/recibido al reves—,
// y el menu es el destino comun en cuanto ese acuse ya se leyo.
if (pointer && isEmptyCart(cart)) {
  return Astro.redirect(
    pointer.seen ? '/mamayaya' : pointer.method === 'mercado_pago' ? '/mamayaya/confirmado' : '/mamayaya/recibido',
  );
}

// Y sin puntero, el carrito vacio es lo que parece: no hay pedido que resumir ni
// pago que elegir, solo una propina sobre $0 y un "Confirmar el pago" que devolveria
// "Tu carrito esta vacio.". Se vuelve al pedido, que es quien lo explica.
if (isEmptyCart(cart)) return Astro.redirect('/mamayaya/carrito');

const products = cart?.total ?? 0;

// El catalogo, solo para los tres rotulos de categoria del pie: si falla, el pie
// se queda con "Menu completo" y la pantalla sigue en pie.
const categoriesPending = getProducts()
  .then((items) => getCategories(items).filter((category) => category !== ALL_CATEGORIES))
  .catch((error) => {
    console.error('[resumen] fallo el catalogo del pie', error);
    return [] as string[];
  });

// Propina y metodo elegidos antes, si se vuelve atras desde el pago. La primera
// vez no hay borrador y manda el primer importe configurado: distinguir "sin
// borrador" de "eligio $0" es lo que evita reponer un valor encima de una decision.
const raw = Astro.cookies.get(DRAFT_COOKIE)?.value;
const draft = parseDraft(raw);

// El modo de entrega, que se eligio en la pantalla anterior, decide los metodos:
// al recoger solo hay efectivo, asi que la eleccion anterior no se repone —podria
// ser una transferencia de un intento a domicilio— y tampoco hay envio que cotizar.
const pickup = draft.deliveryType === 'pickup';

// El envio de este borrador: el del borrador, o el que la API guarde para esta
// sesion si la cookie lo perdio —dura dos horas, y el navegador la vacia de mas
// maneras de las que parece—. Asi el importe llega en el primer render y el total
// no baja porque el navegador se limpiara solo. Sin ubicacion compartida no hay
// ninguno: ver src/lib/shipping-quote.ts.
const quotePending = quoteForDraft(draft, token);

const [store, schedule, categories, quote] = await Promise.all([
  getStoreConfig(),
  getStoreSchedule(),
  categoriesPending,
  quotePending,
]);

// La propina la decide el negocio: con el interruptor apagado no se pide, y sin
// importes no hay selector que pintar.
//
// Los importes se normalizan antes de pintarse —enteros, ordenados, sin
// repetidos y con el 0 al frente—: ver src/lib/tips.ts, donde tambien esta el
// motivo de que el 0 no dependa de que el negocio se acuerde de configurarlo.
const tipAmounts = normalizeTipAmounts(store.tips?.enabled ? store.tips.amounts : []);
const showTips = tipAmounts.length > 0;

// Sin propina configurada, no hay propina que sumar. Con ella y sin borrador
// manda el primer importe, que tras normalizar es el 0: la propina se ofrece,
// no se aplica sola. Preseleccionar el segundo importe —lo que se hacia— cobraba
// unos pesos que nadie llego a elegir a quien no tocara el selector, y ademas
// dependia de como viniera ordenada la lista.
const tip = showTips ? (raw ? draft.tip : tipAmounts[0]) : 0;

const method = pickup ? 'efectivo' : draft.paymentMethod;

// La transferencia solo se ofrece si el negocio publico su cuenta —los tres
// datos, ver lib/store-config.ts—. Sin ella el metodo llevaria a
// /mamayaya/pago/transferencia a leer una cuenta que no existe, y de ahi a cerrar un
// pedido que el comprador no tendria como pagar: se corta aqui, antes de
// ofrecerlo, en lugar de dejarle descubrirlo en la pantalla siguiente.
//
// Quien eligio transferencia en un intento anterior tampoco la recupera del
// borrador: el componente reparte la marca entre los metodos que quedan.
const hasBankTransfer = Boolean(store.bankTransfer);

// El envio, por fin con precio. Lo cotizo el backend en /mamayaya/datos al compartir la
// ubicacion y viaja en el borrador; aqui se resuelve contra las dos reglas que
// mandan sobre el: al recoger no hay envio, y el envio gratis del negocio manda
// sobre cualquier importe.
//
// Se resuelve en el servidor, no en el navegador: el importe tiene que estar en
// el primer pintado, junto al de los productos, y no aparecer despues.
const shipping = resolveShipping({
  pickup,
  quote,
  products,
  freeShipping: store.delivery?.freeShipping,
});

// Las dos condiciones se calculan aqui, en el mismo sitio que monta las hojas: si
// las dedujera la barra de desktop por su cuenta, podria ofrecer un boton para una
// hoja que esta pantalla no monto.
const address = store.location?.address;
const mapsUrl = store.location?.mapsUrl;
const hasLocation = Boolean(address || mapsUrl);
const hasSchedule = Boolean(schedule && schedule.days.length > 0);
---

<Layout
  title="Resumen de pago — Shop Superfoods"
  description="Revisa el importe y elige como pagar."
  noindex
>
  {/* Una cabecera por pantalla: la de 124 con el control de vuelta en movil, y de
      md hacia arriba la barra de la tienda. */}
  <ScreenHeader title="Resumen de pago" backHref="/mamayaya/datos" mobileOnly />

  <NavbarDesktop
    shortAddress={store.location?.shortAddress}
    estimate={store.delivery?.estimate}
    hasLocation={hasLocation}
    hasSchedule={hasSchedule}
    cartTotal={products}
    cartCount={cart?.itemsCount ?? 0}
  />

  <main class="checkout-page d-flex flex-column flex-grow-1">
    {/* La pila y la rejilla solo existen en desktop —en movil son `display:
        contents`, ver styles/screens.css—, asi que envolver no cambia
        nada de lo que ya habia. */}
    <div class="checkout-page__stack">
      <h1 class="checkout-page__title">Resumen de pago</h1>

      <form
        class="checkout-page__grid"
        action="#"
        method="post"
        data-payment-form
        data-products={products}
        data-shipping={shipping.cost}
        data-shipping-state={shipping.state}
        data-subtotal={cart?.subtotal ?? 0}
        data-discount={cart?.discountTotal ?? 0}
      >
        <!-- Contenedor 1: lo que hay que elegir. -->
        <div class="screen-body">
          {showTips && <TipSelector selected={tip} amounts={tipAmounts} />}

          <PaymentMethods
            selected={method}
            deliveryType={draft.deliveryType}
            hasBankTransfer={hasBankTransfer}
          />

          {/* Solo en movil: en desktop esta misma cuenta la cierra la tarjeta de
              la derecha, con el boton dentro. Dos desgloses en una pantalla son
              dos sitios donde leer el mismo total. */}
          <div class="d-md-none">
            <PaymentSummary products={products} tip={tip} shipping={shipping} />
          </div>

          {/* Lo rellena el script si el checkout rechaza el pedido. */}
          <FormError mark="data-checkout-error" />

          {/* Tambien solo en movil: en desktop el aviso va dentro de la tarjeta,
              pegado al boton que lo dispara. Aqui abajo se quedaria lejos de el,
              y ademas repetido. */}
          <div class="d-md-none">
            <LegalNote termsUrl={store.legal?.termsUrl} />
          </div>
        </div>

        {/*
          Boton comun, no de WhatsApp: lo que hace es continuar el flujo —con
          transferencia lleva a la cuenta, con efectivo a donde recoger, y con Mercado
          Pago cierra el pedido—, y por aqui no se manda nada por WhatsApp. Ese canal
          aparece en las dos pantallas finales, que es donde tiene sentido.

          En desktop no se pinta: continuar es el boton de la tarjeta. Los dos son
          submits del mismo formulario, asi que el script decide igual desde
          cualquiera de ellos.
        */}
        <div class="checkout-page__action">
          <ActionBar label="Continuar" />
        </div>

        {/* Contenedor 2, solo desktop: la misma tarjeta de /mamayaya/carrito y /mamayaya/datos, aqui
            ya con la propina. Sin `href`, su boton es un submit —igual que la
            barra— porque a donde se va depende del metodo que se acabe de elegir.

            El rotulo del boton no es el de la barra de movil: esta es la ultima
            pantalla en la que se elige algo, y de aqui se sale a pagar. La barra
            sigue diciendo "Continuar" porque en movil el aviso legal y el boton
            estan donde siempre. */}
        <CartSummary
          subtotal={cart?.subtotal ?? 0}
          discount={cart?.discountTotal ?? 0}
          products={products}
          shipping={shipping}
          tip={tip}
          label="Confirmar el pago"
        >
          {/* El aviso legal, en desktop, entre el total y el boton: es el boton
              que lo acepta. La tarjeta es de las tres pantallas del checkout,
              pero el hueco solo lo llena esta. */}
          <LegalNote slot="note" termsUrl={store.legal?.termsUrl} />
        </CartSummary>
      </form>
    </div>
  </main>

  {/* Las dos hojas que abren el pin y el reloj de la barra de desktop. */}
  {hasSchedule && schedule && <ScheduleSheet schedule={schedule} />}
  {hasLocation && <LocationSheet address={address} mapsUrl={mapsUrl} />}

  <Footer store={store} categories={categories} />
</Layout>

<script>
  import '../../../scripts/payment-summary';
  // Abre las hojas del horario y la ubicacion desde la barra de desktop.
  import '../../../scripts/sheet';
  // Los rotulos de "Descubre" del pie llevan a la portada con su categoria ya
  // filtrada, y el pase lo deja este script: la pantalla que monte el pie tiene
  // que importarlo. Ver src/lib/discover.ts.
  import '../../../scripts/footer-discover';
</script>

{/*
  La huella de dispositivo de Mercado Pago. Esta es una de las dos pantallas que
  la montan: aqui nace el cobro del checkout. Ver el componente, que explica que
  es, que no es —no es el SDK y no lleva clave— y hasta donde viaja el valor.
*/}
<DeviceFingerprint />
