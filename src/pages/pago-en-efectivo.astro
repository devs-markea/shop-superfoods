---
import Layout from '../layouts/Layout.astro';
import ScreenHeader from '../components/ScreenHeader.astro';
import Icon from '../components/Icon.astro';
import PickupLocation from '../components/PickupLocation.astro';
import OrderDetail from '../components/OrderDetail.astro';
import ActionBar from '../components/ActionBar.astro';
import { getCart } from '../lib/cart.ts';
import { resolveCartToken } from '../lib/cart-session.ts';
import { DRAFT_COOKIE, parseDraft } from '../lib/checkout-draft.ts';
import { getStoreConfig } from '../lib/store-config.ts';
import type { OrderLine } from '../lib/checkout.ts';

// El carrito de la sesion manda sobre cualquier valor de ejemplo.
export const prerender = false;

const draft = parseDraft(Astro.cookies.get(DRAFT_COOKIE)?.value);

// Esta pantalla es la del pedido para recoger, y solo tiene sentido con ese modo:
// confirmar aqui un pedido a domicilio lo cerraria con un cobro en un local al que
// nadie va a ir. Sin borrador —caduca a las dos horas— tambien se vuelve, porque
// entonces no hay pedido que confirmar.
if (draft.deliveryType !== 'pickup') {
  return Astro.redirect('/datos-de-entrega');
}

// El pedido todavia no existe: se crea al confirmar. Asi que lo que se lista es
// el carrito, que sigue en pie.
let items: OrderLine[] = [];
let products = 0;

try {
  const cart = await getCart(resolveCartToken(Astro.cookies));
  items = cart.items;
  products = cart.total;
} catch (error) {
  console.error('[efectivo] fallo GET /api/cart', error);
}

// La propina viene del borrador, no de la URL: la cookie la lee tambien el
// servidor, asi que el total se pinta ya completo y no baila al arrancar el JS.
//
// Y aqui es el total definitivo, no un minimo: al recoger no hay envio que cotizar
// despues, que es lo que en la transferencia obliga a advertir que el importe puede
// subir. Es lo que se va a pagar en el local.
const total = products + draft.tip;

const { location } = await getStoreConfig();
---

<Layout
  title="Pago en efectivo — Shop Superfoods"
  description="Confirma tu pedido para recogerlo y pagarlo en el local."
>
  <ScreenHeader title="Pago en efectivo" backHref="/resumen-de-pago" />

  <!-- La cadena flex (page > main > form) deja la barra de accion al fondo de
       la pantalla aunque el contenido no llegue a llenarla. -->
  <main class="d-flex flex-column flex-grow-1">
    {/*
      Mismo cierre que la transferencia y por eso el mismo script: lo que cambia es
      lo que hay que leer antes de confirmar —donde recoger en lugar de a que cuenta
      pagar—, no lo que se manda.
    */}
    <form
      class="d-flex flex-column flex-grow-1"
      action="#"
      method="post"
      data-confirm-form
      data-method="efectivo"
      data-next="/pedido-recibido"
    >
      <div class="screen-body">
        <PickupLocation address={location?.address} mapsUrl={location?.mapsUrl} />

        <div class="info-note">
          <Icon name="info" size="sm" />
          <p class="info-note__text">
            Pagas en efectivo al recoger tu pedido. Te avisaremos por WhatsApp cuando
            este listo.
          </p>
        </div>

        <OrderDetail items={items} total={total} />

        {/* Lo rellena el script si el checkout rechaza el pedido. */}
        <p class="form-error" role="alert" hidden data-checkout-error></p>
      </div>

      <ActionBar label="Confirmar pedido" />
    </form>
  </main>
</Layout>

<script>
  import '../scripts/confirm-order';
</script>
