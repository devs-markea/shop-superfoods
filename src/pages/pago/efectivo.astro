---
import Layout from '../../layouts/Layout.astro';
import ScreenHeader from '../../components/ScreenHeader.astro';
import NavbarDesktop from '../../components/NavbarDesktop.astro';
import Icon from '../../components/Icon.astro';
import PaymentMethodCard from '../../components/PaymentMethodCard.astro';
import OrderDetail from '../../components/OrderDetail.astro';
import CartSummary from '../../components/CartSummary.astro';
import ActionBar from '../../components/ActionBar.astro';
import ScheduleSheet from '../../components/ScheduleSheet.astro';
import LocationSheet from '../../components/LocationSheet.astro';
import Footer from '../../components/Footer.astro';
import { getCart, type Cart } from '../../lib/cart.ts';
import { resolveCartToken } from '../../lib/cart-session.ts';
import { getShippingQuote } from '../../lib/shipping-quote.ts';
import { DRAFT_COOKIE, draftGaps, parseDraft } from '../../lib/checkout-draft.ts';
import { resolveShipping } from '../../lib/shipping.ts';
import { getStoreConfig, getStoreSchedule } from '../../lib/store-config.ts';
import { ALL_CATEGORIES, getCategories, getProducts } from '../../lib/catalog.ts';

// DOS PANTALLAS, UN MARCADO
//
// Lo mismo que en la transferencia, y por la misma razon: en movil la cabecera de
// 124, como se paga, el aviso, el detalle del pedido y "Confirmar pedido" en la
// barra fija del fondo; en desktop la barra de tienda, el armazon de 48, el pie y
// dos columnas —lo que hay que leer a la izquierda y la tarjeta de resumen a la
// derecha, que es donde se confirma—.
//
// La tarjeta releva a la barra de accion: los dos son submits del mismo
// formulario, asi que scripts/confirm-order.ts cierra el pedido igual desde
// cualquiera de ellos. Ver components/_checkout-page.scss.

// El carrito de la sesion manda sobre cualquier valor de ejemplo.
export const prerender = false;

const draft = parseDraft(Astro.cookies.get(DRAFT_COOKIE)?.value);

// El efectivo ya no es solo del pedido para recoger: a domicilio se le paga al
// repartidor. Asi que lo que hay que comprobar no es el modo de entrega, sino que
// siga habiendo con que cerrar el pedido —el borrador caduca a las dos horas—:
// sin nombre, telefono o direccion, "Confirmar pedido" solo podria fallar. Se
// vuelve a los datos de entrega, que es donde se rellenan.
if (draftGaps(draft).length > 0) {
  return Astro.redirect('/datos');
}

// El modo de entrega ya no decide si esta pantalla existe, pero si lo que promete:
// al recoger no hay reparto que cotizar.
const pickup = draft.deliveryType === 'pickup';

const token = resolveCartToken(Astro.cookies);

// El pedido todavia no existe: se crea al confirmar. Asi que lo que se lista es
// el carrito, que sigue en pie. Si no responde, la pantalla se sirve igual: como
// se paga es lo que se viene a leer aqui.
const cartPending = getCart(token).catch((error) => {
  console.error('[efectivo] fallo GET /api/cart', error);
  return null as Cart | null;
});

// El catalogo, solo para los tres rotulos de categoria del pie: si falla, el pie
// se queda con "Menu completo" y la pantalla sigue en pie.
const categoriesPending = getProducts()
  .then((items) => getCategories(items).filter((category) => category !== ALL_CATEGORIES))
  .catch((error) => {
    console.error('[efectivo] fallo el catalogo del pie', error);
    return [] as string[];
  });

// La cotizacion del envio vive en el borrador, pero esa cookie dura dos horas y el
// navegador la vacia de mas maneras de las que parece. Cuando falta y hay una
// ubicacion que la justifica, se recupera de la API, que la guarda mientras dure la
// sesion del carrito. Asi el importe llega en el primer render, y el total que se
// ensena aqui no baja porque el navegador se limpiara solo.
//
// Solo se pregunta cuando puede haber algo que recuperar: en el camino normal, con
// la cotizacion ya en el borrador, no se llama.
const quotePending =
  !pickup && draft.customer.locationUrl && !draft.shipping
    ? getShippingQuote(token)
    : Promise.resolve(null);

const [store, schedule, cart, categories, recovered] = await Promise.all([
  getStoreConfig(),
  getStoreSchedule(),
  cartPending,
  categoriesPending,
  quotePending,
]);

const quote = draft.shipping ?? recovered;

const items = cart?.items ?? [];
const products = cart?.total ?? 0;
// Antes de descontar, y lo que descuentan las promociones. Con ellos el
// comprador puede cuadrar la resta en lugar de fiarse del importe final.
const subtotal = cart?.subtotal ?? 0;
const discount = cart?.discountTotal ?? 0;

// El envio, con la misma cuenta que /pago: la distancia medida en /datos con la
// tarifa, y por encima de ella las dos reglas que mandan —al recoger no hay
// envio, y el envio gratis del negocio manda sobre cualquier distancia—.
const shipping = resolveShipping({
  pickup,
  quote,
  products,
  freeShipping: store.delivery?.freeShipping,
});

// La propina viene del borrador, no de la URL: la cookie la lee tambien el
// servidor, asi que el total se pinta ya completo y no baila al arrancar el JS.
//
// Al recoger este es el total definitivo: es lo que se va a pagar en el local. A
// domicilio lo es tambien en cuanto hay envio medido —que es lo que se le entrega
// al repartidor—, y sigue siendo un minimo cuando no se pudo medir.
const total = products + draft.tip + shipping.cost;

// Y por eso el aviso solo habla del envio cuando queda algo por decir de el: en
// un pedido que se recoge no hay ninguno, y con el ya cotizado el importe de
// arriba es el que hay que preparar. Anunciar un costo por confirmar en
// cualquiera de los dos casos prometeria un cobro que no va a llegar.
const infoNote =
  shipping.state === 'pending'
    ? 'Se recomienda preparar el monto exacto para facilitar la entrega. El costo de envio exacto se confirmara al finalizar tu pedido.'
    : 'Se recomienda preparar el monto exacto para facilitar la entrega.';

// Las dos condiciones se calculan aqui, en el mismo sitio que monta las hojas: si
// las dedujera la barra de desktop por su cuenta, podria ofrecer un boton para una
// hoja que esta pantalla no monto.
const address = store.location?.address;
const mapsUrl = store.location?.mapsUrl;
const hasLocation = Boolean(address || mapsUrl);
const hasSchedule = Boolean(schedule && schedule.days.length > 0);
---

<Layout
  title="Pago en efectivo — Shop Superfoods"
  description="Confirma tu pedido y pagalo en efectivo al recibirlo."
  noindex
>
  {/* Una cabecera por pantalla: la de 124 con el control de vuelta en movil, y de
      md hacia arriba la barra de la tienda. */}
  <ScreenHeader title="Pago en efectivo" backHref="/pago" mobileOnly />

  <NavbarDesktop
    shortAddress={store.location?.shortAddress}
    estimate={store.delivery?.estimate}
    hasLocation={hasLocation}
    hasSchedule={hasSchedule}
    cartTotal={products}
    cartCount={cart?.itemsCount ?? 0}
  />

  <!-- La cadena flex (page > main > form) deja la barra de accion al fondo de
       la pantalla aunque el contenido no llegue a llenarla. -->
  <main class="checkout-page checkout-page--confirm d-flex flex-column flex-grow-1">
    {/* La pila y la rejilla solo existen en desktop —en movil son `display:
        contents`, ver components/_checkout-page.scss—, asi que envolver no cambia
        nada de lo que ya habia. */}
    <div class="checkout-page__stack">
      <h1 class="checkout-page__title">Pago en efectivo</h1>

      {/*
        Mismo cierre que la transferencia y por eso el mismo script: lo que cambia es
        lo que hay que leer antes de confirmar —como se paga en lugar de a que cuenta
        pagar—, no lo que se manda.
      */}
      <form
        class="checkout-page__grid"
        action="#"
        method="post"
        data-confirm-form
        data-method="efectivo"
        data-next="/recibido"
        data-shipping={shipping.cost}
      >
        <!-- Contenedor 1: lo que hay que leer antes de pagar. -->
        <div class="screen-body">
          {/* La frase de desktop dice lo mismo que la de movil, entera y en una
              sola linea: alli la tarjeta se queda en dos renglones —titulo y
              explicacion— y la frase de abajo se retira. */}
          <PaymentMethodCard
            icon="cash"
            title="Pago contra entrega"
            note="Efectivo en mano"
            wideNote="El pago se realizara en efectivo directamente al repartidor al momento de la entrega o en mostrador si es para recoger."
            description="Realiza tu pago directamente al repartidor al recibir tu pedido en tu domicilio, o en caja al recoger en sucursal."
          />

          <div class="info-note">
            <Icon name="info" size="sm" />
            <p class="info-note__text">{infoNote}</p>
          </div>

          <OrderDetail
            items={items}
            total={total}
            subtotal={subtotal}
            discount={discount}
            tip={draft.tip}
            shipping={shipping}
          />

          {/* Lo rellena el script si el checkout rechaza el pedido. */}
          <p class="form-error" role="alert" hidden data-checkout-error></p>
        </div>

        <!-- En desktop esta barra no se pinta: confirmar es el boton de la
             tarjeta. Los dos son submits del mismo formulario, asi que el script
             cierra el pedido igual desde cualquiera de ellos. -->
        <div class="checkout-page__action">
          <ActionBar label="Confirmar pedido" />
        </div>

        {/* Contenedor 2, solo desktop: la misma tarjeta de las tres pantallas
            anteriores, aqui ya con todo cerrado —descuentos, envio y propina—.
            Sin `href`, su boton es un submit: lo que hace es crear el pedido, no
            navegar, y a donde se va despues lo decide el script. */}
        <CartSummary
          subtotal={subtotal}
          discount={discount}
          products={products}
          shipping={shipping}
          tip={draft.tip}
          label="Confirmar pedido"
        />
      </form>
    </div>
  </main>

  {/* Las dos hojas que abren el pin y el reloj de la barra de desktop. */}
  {hasSchedule && schedule && <ScheduleSheet schedule={schedule} />}
  {hasLocation && <LocationSheet address={address} mapsUrl={mapsUrl} />}

  <Footer store={store} categories={categories} />
</Layout>

<script>
  import '../../scripts/confirm-order';
  // Abre las hojas del horario y la ubicacion desde la barra de desktop.
  import '../../scripts/sheet';
</script>
