---
import Layout from '../../layouts/Layout.astro';
import ProductHero from '../../components/ProductHero.astro';
import OptionGroup from '../../components/OptionGroup.astro';
import ActionBar from '../../components/ActionBar.astro';
import { products, type Product } from '../../data/products.ts';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

// Total inicial: la primera opcion de cada grupo obligatorio viene marcada.
const initialTotal = product.optionGroups
  .filter((group) => group.type === 'radio')
  .reduce((sum, group) => sum + (group.choices[0]?.price ?? 0), 0);
---

<Layout title={`${product.name} — Shop Superfoods`} description={product.description}>
  <main class="d-flex flex-column flex-grow-1">
    <ProductHero product={product} />

    <form class="d-flex flex-column flex-grow-1" action="#" method="post" data-order-form>
      <div class="product-detail">
        <div class="product-detail__intro">
          <h1 class="product-detail__title">{product.name}</h1>
          <p class="product-detail__description">{product.description}</p>
        </div>

        {
          product.optionGroups.map((group) => (
            <>
              <hr class="product-detail__divider" />
              <OptionGroup group={group} />
            </>
          ))
        }
      </div>

      <ActionBar label="Agregar — {total}" total={initialTotal} />
    </form>
  </main>
</Layout>

<script>
  import '../../scripts/order-form';
</script>
