---
import Layout from '../layouts/Layout.astro';
import BackHeader from '../components/BackHeader.astro';
import NavbarDesktop from '../components/NavbarDesktop.astro';
import OrderStatus from '../components/OrderStatus.astro';
import Steps from '../components/Steps.astro';
import ClabeCard from '../components/ClabeCard.astro';
import ActionBar from '../components/ActionBar.astro';
import ScheduleSheet from '../components/ScheduleSheet.astro';
import LocationSheet from '../components/LocationSheet.astro';
import Footer from '../components/Footer.astro';
import { getCart, type Cart } from '../lib/cart.ts';
import { getOrder } from '../lib/orders.ts';
import { resolveCartToken } from '../lib/cart-session.ts';
import { ORDER_COOKIE, parseOrderPointer } from '../lib/checkout-draft.ts';
import { PAYMENT_LABEL } from '../lib/checkout.ts';
import { fillMessage, whatsAppUrl } from '../lib/whatsapp.ts';
import { formatPrice } from '../lib/price.ts';
import { getStoreConfig, getStoreSchedule } from '../lib/store-config.ts';
import { ALL_CATEGORIES, getCategories, getProducts } from '../lib/catalog.ts';

// UNA PANTALLA, DOS FORMAS
//
// En movil es la de siempre: la cabecera de 64, el sello, los pasos, la cuenta a
// la que transferir y "Abrir WhatsApp" en la barra fija del fondo.
//
// En desktop se monta como el resto de la tienda —la misma barra de tienda
// arriba, el mismo pie abajo— y el contenido pasa a una columna centrada con 40
// entre sus piezas, rematada por el enlace al estado del pedido. Ver
// components/_confirmation-page.scss.

// Depende de la sesion: el mensaje de WhatsApp lleva el folio del pedido, y quien
// reciba la captura tiene que saber a que pedido corresponde.
export const prerender = false;

const token = resolveCartToken(Astro.cookies);

// El carrito, solo para el chip de la barra de desktop. Aqui el pedido ya esta
// hecho —el cierre lo vacio—, asi que lo normal es que llegue en cero; se lee de
// todas formas porque se puede volver a esta pantalla con la tienda ya visitada
// otra vez, y un chip que afirma un importe viejo es peor que no tenerlo.
const cartPending = getCart(token).catch((error) => {
  console.error('[recibido] fallo GET /api/cart', error);
  return null as Cart | null;
});

// El catalogo, solo para los tres rotulos de categoria del pie: si falla, el pie
// se queda con "Menu completo" y la pantalla sigue en pie.
const categoriesPending = getProducts()
  .then((items) => getCategories(items).filter((category) => category !== ALL_CATEGORIES))
  .catch((error) => {
    console.error('[recibido] fallo el catalogo del pie', error);
    return [] as string[];
  });

const [store, schedule, cart, categories] = await Promise.all([
  getStoreConfig(),
  getStoreSchedule(),
  cartPending,
  categoriesPending,
]);

const phone = store.whatsapp?.phone ?? '';

// El pedido esta hecho y esperando el cobro, pero el cobro no se parece:
//
//   transferencia  el dinero ya salio y hay que mandar el comprobante
//   efectivo       el dinero se entrega en mano: al repartidor o en el local
//
// Asi que el metodo decide la pantalla entera —pasos, tarjeta y aviso—, y sale del
// puntero, que es lo unico que queda del cierre. Sin puntero se rotula el flujo de
// transferencia, que es el que trae aqui a quien vuelve por el historial.
const pointer = parseOrderPointer(Astro.cookies.get(ORDER_COOKIE)?.value);
const cash = pointer?.method === 'efectivo';

// En efectivo, el modo de entrega parte otra vez la copia: al recoger hay que ir al
// local, a domicilio solo hay que esperar con el dinero preparado. Sin el dato manda
// recoger: es de un puntero anterior a que el efectivo saliera a domicilio, cuando
// era lo unico que habia.
const cashPickup = cash && pointer?.deliveryType !== 'delivery';

// El pedido solo se lee si hay a quien escribir: sin telefono configurado el boton
// no navega, y entonces no hay nada que rellenar.
let whatsapp: string | null = null;

if (phone && pointer) {
  try {
    const order = await getOrder(pointer.id, token);

    if (order) {
      // Con efectivo no hay comprobante que mandar: el mensaje es el del pedido
      // recien hecho, la misma plantilla que usa el cierre de Mercado Pago.
      const template = cash
        ? store.whatsapp?.templates?.orderPlaced
        : store.whatsapp?.templates?.paymentProof;

      whatsapp = whatsAppUrl(
        phone,
        fillMessage(template ?? '', {
          folio: order.id,
          // El total del pedido, con su envio ya incluido: es el importe que
          // hay que transferir, y el comprobante que se manda por aqui tiene que
          // cuadrar con el.
          total: formatPrice(order.total),
          nombre: order.customer?.name,
          estado: order.statusLabel,
          metodo: PAYMENT_LABEL[pointer.method],
        }),
      );
    }
  } catch (error) {
    // Sin mensaje se sigue mostrando la pantalla: lo importante es el dato del pago
    // —la CLABE o el local—, y el chat se puede abrir a mano.
    console.error('[recibido] fallo GET /api/orders', error);
  }
}

// La copia de los tres cierres, junta: se lee de un tiron en que se diferencian.
//
// En efectivo no hay pasos que dar, ni al recoger ni a domicilio: el pedido ya esta
// hecho y lo que queda —esperar el aviso y pagar al recibirlo— cabe en el aviso del
// sello y en el de la barra. Una tarjeta numerada para eso convertiria en tramite lo
// que no lo es. La transferencia si los lleva, porque ahi el comprador tiene trabajo
// pendiente: pagar y mandar el comprobante, en ese orden.
const copy: {
  description: string;
  note: string;
  steps: string[] | null;
  barNote: string;
} = cash
  ? cashPickup
    ? {
        description: 'Recoge tu pedido en el local y pagalo en efectivo.',
        note: 'Te avisaremos por WhatsApp cuando tu pedido este listo para recoger.',
        steps: null,
        barNote: 'Pagaras en efectivo al recoger tu pedido',
      }
    : {
        description: 'Paga en efectivo al recibir tu pedido.',
        note: 'Te avisaremos por WhatsApp cuando tu pedido vaya en camino.',
        steps: null,
        barNote: 'Pagaras en efectivo al recibir tu pedido',
      }
  : {
      description: 'Envia tu comprobante de transferencia para confirmar el pedido.',
      note: 'Envia tu comprobante por WhatsApp para que podamos confirmar tu pedido.',
      steps: [
        'Realiza tu transferencia bancaria',
        'Envia el comprobante por WhatsApp',
        'Recibe confirmacion de tu pedido',
      ],
      barNote: 'Tu pedido quedara pendiente hasta confirmar el pago',
    };

// Las dos condiciones se calculan aqui, en el mismo sitio que monta las hojas: si
// las dedujera la barra de desktop por su cuenta, podria ofrecer un boton para una
// hoja que esta pantalla no monto.
const address = store.location?.address;
const mapsUrl = store.location?.mapsUrl;
const hasLocation = Boolean(address || mapsUrl);
const hasSchedule = Boolean(schedule && schedule.days.length > 0);
---

<Layout title="Pedido recibido — Shop Superfoods" description={copy.description}>
  {/*
    Vuelve al menu y no a la pantalla de pago: el pedido ya esta hecho, y volver
    atras invitaria a confirmarlo otra vez.

    Una cabecera por pantalla: la de 64 con el control de vuelta en movil, y de md
    hacia arriba la barra de la tienda, donde el que vuelve al menu es el logo.
  */}
  <BackHeader backHref="/" mobileOnly />

  <NavbarDesktop
    shortAddress={store.location?.shortAddress}
    estimate={store.delivery?.estimate}
    hasLocation={hasLocation}
    hasSchedule={hasSchedule}
    cartTotal={cart?.total ?? 0}
    cartCount={cart?.itemsCount ?? 0}
  />

  <!-- La cadena flex (page > main) deja la barra de accion al fondo de la
       pantalla aunque el contenido no llegue a llenarla. -->
  <main class="confirmation-page d-flex flex-column flex-grow-1">
    <div class="screen-body screen-body--confirmation">
      {/*
        El sello es el mismo en los tres: el pedido esta recibido, no cobrado. Con
        transferencia falta el comprobante y con efectivo falta entregar el dinero.
      */}
      <OrderStatus state="pending" title="Pedido recibido" note={copy.note} />

      {copy.steps && <Steps steps={copy.steps} />}

      {/*
        El dato que hace falta para completar el pago, sin volver atras: la cuenta
        de destino de la transferencia. Sin CLABE configurada no hay nada que copiar
        y la tarjeta no se pinta.

        En efectivo no se pinta ninguna tarjeta, tampoco al recoger: el dinero se
        entrega en mano y no queda ningun dato que consultar aqui.
      */}
      {
        !cash && store.bankTransfer?.clabe && (
          <ClabeCard bank={store.bankTransfer.bank} clabe={store.bankTransfer.clabe} />
        )
      }

      {/*
        Ultimo subcontenedor, SOLO desktop: ahi es donde releva a la barra de
        accion del fondo, que no se pinta. Lleva a /confirmado, que es la pantalla
        que relee el pedido en cada visita y dice como esta —el puntero del cierre
        sigue en la cookie, asi que no hace falta pasarle nada por la URL—.

        El aviso es el mismo que la barra pone bajo su boton en movil: el pedido
        queda pendiente hasta que el pago se confirme, y eso no cambia con el
        ancho de la pantalla.
      */}
      <div class="confirmation-page__cta">
        <a class="confirmation-page__cta-button btn btn-primary" href="/confirmado">
          Ver estado del pedido
        </a>

        <p class="confirmation-page__cta-note">{copy.barNote}</p>
      </div>
    </div>

    {/*
      Sin telefono de la tienda configurado el control queda inerte —un submit
      fuera de un formulario no navega ni recarga— en lugar de abrir un chat vacio.
      Con telefono, abre WhatsApp con el mensaje ya escrito.

      En desktop esta barra no se pinta: el envoltorio la retira de md hacia
      arriba, donde la accion es el enlace de arriba.
    */}
    <div class="confirmation-page__action">
      <ActionBar
        label="Abrir WhatsApp"
        icon="whatsapp"
        variant="whatsapp"
        href={whatsapp ?? undefined}
        note={copy.barNote}
      />
    </div>
  </main>

  {/* Las dos hojas que abren el pin y el reloj de la barra de desktop. */}
  {hasSchedule && schedule && <ScheduleSheet schedule={schedule} />}
  {hasLocation && <LocationSheet address={address} mapsUrl={mapsUrl} />}

  <Footer store={store} categories={categories} />
</Layout>

<script>
  // El boton de copiar de la tarjeta de la CLABE: el comportamiento lo pone el
  // script, que delega en document, y la pantalla que use el componente tiene que
  // importarlo.
  import '../scripts/copy-button';
  // Abre las hojas del horario y la ubicacion desde la barra de desktop.
  import '../scripts/sheet';
</script>
