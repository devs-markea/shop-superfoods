---
import Layout from '../layouts/Layout.astro';
import ScreenHeader from '../components/ScreenHeader.astro';
import TipSelector from '../components/TipSelector.astro';
import PaymentMethods from '../components/PaymentMethods.astro';
import PaymentSummary from '../components/PaymentSummary.astro';
import ActionBar from '../components/ActionBar.astro';
import { getCart } from '../lib/cart.ts';
import { resolveCartToken } from '../lib/cart-session.ts';
import { DRAFT_COOKIE, parseDraft } from '../lib/checkout-draft.ts';

// El carrito de la sesion manda sobre cualquier valor de ejemplo.
export const prerender = false;

// Esta pantalla solo lee el importe de los productos. La propina y el metodo se
// guardan en el borrador, y con Mercado Pago el pedido se cierra aqui mismo.
let products = 0;

try {
  products = (await getCart(resolveCartToken(Astro.cookies))).total;
} catch (error) {
  console.error('[resumen] fallo GET /api/cart', error);
}

// Propina y metodo elegidos antes, si se vuelve atras desde el pago. La primera
// vez no hay borrador y manda el valor del diseno: distinguir "sin borrador" de
// "eligio $0" es justo lo que evita reponer los 15 encima de una decision.
const raw = Astro.cookies.get(DRAFT_COOKIE)?.value;
const draft = parseDraft(raw);

const DEFAULT_TIP = 15;
const tip = raw ? draft.tip : DEFAULT_TIP;
---

<Layout
  title="Resumen de pago — Shop Superfoods"
  description="Revisa el importe y elige como pagar."
>
  <ScreenHeader title="Resumen de pago" backHref="/datos-de-entrega" />

  <main class="d-flex flex-column flex-grow-1">
    <form
      class="d-flex flex-column flex-grow-1"
      action="#"
      method="post"
      data-payment-form
      data-products={products}
    >
      <div class="screen-body">
        <TipSelector selected={tip} />

        <PaymentMethods selected={draft.paymentMethod} />

        <PaymentSummary products={products} tip={tip} />

        {/* Lo rellena el script si el checkout rechaza el pedido. */}
        <p class="form-error" role="alert" hidden data-checkout-error></p>

        <p class="legal-note">
          Al continuar aceptas nuestros terminos y condiciones de servicio.
        </p>
      </div>

      <ActionBar
        label="Enviar pedido por WhatsApp"
        icon="whatsapp"
        variant="whatsapp"
      />
    </form>
  </main>
</Layout>

<script>
  import '../scripts/payment-summary';
</script>
